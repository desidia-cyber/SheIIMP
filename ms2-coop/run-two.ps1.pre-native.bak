# Run a two-client co-op test on one PC, fully in the background.
#   .\run-two.ps1 -GameA "E:\Games\_MS2-coop-test" -GameB "E:\Games\_MS2-coop-b"
#
# Each client gets its own LOCALAPPDATA (seeded with a copy of the owner's saves),
# so two instances never fight over one save file and the owner's saves are never
# touched at all. Clients enter their own save, summon a puppet, publish their
# transform and drive the peer's puppet; relays carry the bytes over localhost UDP.
# Prints "RESULT: PASS" or "RESULT: FAIL".

param(
    [Parameter(Mandatory = $true)][string]$GameA,
    [Parameter(Mandatory = $true)][string]$GameB,
    [int]$BootWait = 75,
    [int]$TimeoutSeconds = 300,
    [int]$Port = 47010,
    [string]$TeleportB = "",
    [string]$MoveNpc = "",
    [switch]$FreshLocal,
    [switch]$StreamOnly,
    [string]$FarPoint = "42382 -42703 -42382",
    [string]$SpawnPoint = "66992 -125076 -44454",
    [string]$ExtraArgs = "-windowed -ResX=1024 -ResY=576 -nosound -nosplash -nocrashreport"
)

$ErrorActionPreference = 'Stop'

function Start-ReporterKiller {
    # Crash dialogs must never reach the owner's screen. Kill them on sight.
    $script:killerFlag = Join-Path $env:TEMP ("ms2killer_" + (Get-Date -Format 'HHmmss') + ".flag")
    New-Item -ItemType File -Force -Path $script:killerFlag | Out-Null
    $script:killerJob = Start-Job -ArgumentList $script:killerFlag -ScriptBlock {
        param($flag)
        while (Test-Path $flag) {
            Get-Process CrashReportClient -ErrorAction SilentlyContinue | ForEach-Object {
                try { Stop-Process -Id $_.Id -Force } catch {}
            }
            Start-Sleep -Milliseconds 150
        }
    }
}

function Stop-ReporterKiller {
    try { Remove-Item $script:killerFlag -Force -ErrorAction SilentlyContinue } catch {}
    try { Stop-Job $script:killerJob -ErrorAction SilentlyContinue; Remove-Job $script:killerJob -Force -ErrorAction SilentlyContinue } catch {}
}
$root = $PSScriptRoot
$realLocal = $env:LOCALAPPDATA

Add-Type -Namespace Win32 -Name W -MemberDefinition @'
[System.Runtime.InteropServices.DllImport("user32.dll")]
public static extern bool SetWindowPos(System.IntPtr hWnd, System.IntPtr after, int x, int y, int cx, int cy, uint flags);
'@

function Hide-GameWindow {
    Get-Process | Where-Object ProcessName -match 'MortalShell2-Win64' | ForEach-Object {
        if ($_.MainWindowHandle -ne 0) {
            [Win32.W]::SetWindowPos($_.MainWindowHandle, [IntPtr]::Zero, -30000, -30000, 0, 0, 0x0001 -bor 0x0010 -bor 0x0004) | Out-Null
        }
    }
}

function Stop-All {
    Get-Process | Where-Object ProcessName -match 'MortalShell2' | ForEach-Object { try { Stop-Process -Id $_.Id -Force } catch {} }
    Get-Process | Where-Object ProcessName -match 'CrashReportClient' | ForEach-Object { try { Stop-Process -Id $_.Id -Force } catch {} }
    Get-CimInstance Win32_Process -Filter "Name like 'python%'" | Where-Object { $_.CommandLine -match 'cooprelay' } | ForEach-Object { try { Stop-Process -Id $_.ProcessId -Force } catch {} }
}

function Seed-LocalAppData([string]$target) {
    $mine = Join-Path $target 'MortalShell2\Saved'
    if ($FreshLocal -and (Test-Path (Join-Path $target 'MortalShell2'))) {
        Remove-Item (Join-Path $target 'MortalShell2') -Recurse -Force -ErrorAction SilentlyContinue
    }
    if (-not (Test-Path $mine)) {
        New-Item -ItemType Directory -Force -Path (Join-Path $mine 'SaveGames') | Out-Null
        $srcSaves = Join-Path $realLocal 'MortalShell2\Saved\SaveGames'
        if (Test-Path $srcSaves) { Copy-Item "$srcSaves\*.sav" (Join-Path $mine 'SaveGames') -Force }
        $srcCfg = Join-Path $realLocal 'MortalShell2\Saved\Config'
        if (Test-Path $srcCfg) { Copy-Item $srcCfg (Join-Path $mine 'Config') -Recurse -Force }
        Write-Host "seeded $target"
    }
}

function Start-Client([string]$gameDir, [string]$localAppData) {
    $exe = Join-Path $gameDir 'MortalShell2\Binaries\Win64\MortalShell2-Win64-Shipping.exe'
    $argList = @('MortalShell2') + ($ExtraArgs -split '\s+' | Where-Object { $_ })
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $exe
    $psi.Arguments = ($argList | ForEach-Object { if ($_ -match '\s') { '"' + $_ + '"' } else { $_ } }) -join ' '
    $psi.WorkingDirectory = $gameDir
    $psi.UseShellExecute = $true
    $psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Normal
    $env:LOCALAPPDATA = $localAppData
    $p = [System.Diagnostics.Process]::Start($psi)
    $env:LOCALAPPDATA = $realLocal
    Write-Host "started $gameDir (pid $($p.Id)) local=$localAppData"
}

Start-ReporterKiller
Stop-All
Start-Sleep -Seconds 3

# This game resolves its save folder through the Windows shell API, so an overridden
# LOCALAPPDATA is NOT enough. Snapshot the real save dir and restore it afterwards,
# deleting any save files the run created (the game writes WorldState_Backup_0_*.sav).
$realSaveDir = Join-Path $env:LOCALAPPDATA "MortalShell2\Saved\SaveGames"
$saveSnap = Join-Path $env:TEMP ("ms2saves_" + (Get-Date -Format "HHmmss"))
$saveNamesBefore = @()
if (Test-Path $realSaveDir) {
    New-Item -ItemType Directory -Force -Path $saveSnap | Out-Null
    Copy-Item (Join-Path $realSaveDir "*.sav") $saveSnap -Force
    $saveNamesBefore = @(Get-ChildItem $realSaveDir -Filter *.sav | Select-Object -ExpandProperty Name)
    Write-Host "saves snapshotted: $($saveNamesBefore -join ", ")"
}


$localA = Join-Path $root 'local-appdata\A'
$localB = Join-Path $root 'local-appdata\B'
Seed-LocalAppData $localA
Seed-LocalAppData $localB

$coopA = Join-Path $GameA 'MortalShell2\Binaries\Win64\coop'
$coopB = Join-Path $GameB 'MortalShell2\Binaries\Win64\coop'
foreach ($d in @($coopA, $coopB)) {
    New-Item -ItemType Directory -Force -Path $d | Out-Null
    Remove-Item (Join-Path $d 'result.txt'), (Join-Path $d 'probe.log'), (Join-Path $d 'cmd.txt'), (Join-Path $d 'peer_*.txt'), (Join-Path $d 'out_*.txt'), (Join-Path $d 'relay_*.log') -Force -ErrorAction SilentlyContinue
}
Set-Content -Path (Join-Path $coopA 'playerid.txt') -Value 'A' -Encoding ASCII -NoNewline
Set-Content -Path (Join-Path $coopA 'role.txt') -Value 'host' -Encoding ASCII -NoNewline
Set-Content -Path (Join-Path $coopB 'role.txt') -Value 'guest' -Encoding ASCII -NoNewline
Remove-Item (Join-Path $coopB 'result_npc.txt'), (Join-Path $coopA 'result_stream.txt'), (Join-Path $coopB 'result_stream.txt'), (Join-Path $coopA 'result_spawn.txt'), (Join-Path $coopB 'result_pd.txt'), (Join-Path $coopA 'result_ai.txt') -Force -ErrorAction SilentlyContinue
Remove-Item (Join-Path $coopA 'result_ws.txt'), (Join-Path $coopB 'result_ws.txt'), (Join-Path $coopB 'result_wp.txt'), (Join-Path $coopB 'result_qs.txt'), (Join-Path $coopB 'result_qs2.txt'), (Join-Path $coopB 'result_lift.txt'), (Join-Path $coopB 'result_chest.txt'), (Join-Path $coopA 'result_ledger.txt'), (Join-Path $coopB 'result_ledger.txt') -Force -ErrorAction SilentlyContinue
Set-Content -Path (Join-Path $coopB 'playerid.txt') -Value 'B' -Encoding ASCII -NoNewline

Start-Client $GameA $localA
Start-Sleep -Seconds 8
Start-Client $GameB $localB

$relay = Join-Path $root 'relay\cooprelay.py'
Start-Process -FilePath 'python' -ArgumentList @($relay, '--transport', 'udp', '--role', 'host', '--port', "$Port", '--player', 'A', '--dir', $coopA) -WindowStyle Hidden
Start-Sleep -Seconds 2
Start-Process -FilePath 'python' -ArgumentList @($relay, '--transport', 'udp', '--role', 'client', '--host', '127.0.0.1', '--port', "$Port", '--player', 'B', '--dir', $coopB) -WindowStyle Hidden

$until = (Get-Date).AddSeconds($BootWait)
while ((Get-Date) -lt $until) { Hide-GameWindow; Start-Sleep -Milliseconds 700 }

if ($MoveNpc) {
    [System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "npctp $MoveNpc`n")
    Write-Host "host moving nearest NPC to $MoveNpc"
    Start-Sleep -Seconds 6
}

if ($TeleportB) {
    [System.IO.File]::WriteAllText((Join-Path $coopB 'cmd.txt'), "tp $TeleportB`n")
    Write-Host "teleported B to $TeleportB"
}

# a client that disappears is the most valuable signal there is - report it loudly
function Test-ClientsAlive {
    return @(Get-Process | Where-Object ProcessName -match 'MortalShell2-Win64').Count
}

$deadline = (Get-Date).AddSeconds($TimeoutSeconds)
$aliveWarned = $false
$resA = $null; $resB = $null
while ((Get-Date) -lt $deadline) {
    Hide-GameWindow
    $pa = Join-Path $coopA 'result.txt'; $pb = Join-Path $coopB 'result.txt'
    if (Test-Path $pa) { $t = (Get-Content $pa -Raw); if ($t -match '^(PASS|FAIL)') { $resA = $t.Trim() } }
    if (Test-Path $pb) { $t = (Get-Content $pb -Raw); if ($t -match '^(PASS|FAIL)') { $resB = $t.Trim() } }
    if ($resA -and $resB) { break }
    if (-not $aliveWarned) {
        $n = Test-ClientsAlive
        if ($n -lt 2) { Write-Host "=== WARNING: only $n game client(s) alive"; $aliveWarned = $true }
    }
    Start-Sleep -Milliseconds 700
}

# --- co-op feature checks -----------------------------------------------------
function Get-SyncValue([string]$coopDir, [string]$key) {
    $f = Join-Path $coopDir 'sync.txt'
    if (-not (Test-Path $f)) { return $null }
    foreach ($line in Get-Content $f) { if ($line -match "^$key=(.*)$") { return $matches[1] } }
    return $null
}

$bodyA = Get-SyncValue $coopA 'body'
$bodyB = Get-SyncValue $coopB 'body'
$peerA = Get-SyncValue $coopA 'peerbody'
$peerB = Get-SyncValue $coopB 'peerbody'
$shellOk = ($bodyA) -and ($bodyB) -and ($peerA -eq $bodyB) -and ($peerB -eq $bodyA)
Write-Host "=== SHELL: A body=$bodyA ; B sees '$peerB' ; B body=$bodyB ; A sees '$peerA'"
Write-Host "=== SHELL: $(if ($shellOk) { 'PASS' } else { 'FAIL' })"

$wpnA = Get-SyncValue $coopA 'wpn'
$wpnB = Get-SyncValue $coopB 'wpn'
$peerWpnA = Get-SyncValue $coopA 'peerwpn'
$appliedA = Get-SyncValue $coopA 'wpnapplied'
$appliedB = Get-SyncValue $coopB 'wpnapplied'
$weaponOk = ($wpnA) -and ($peerWpnA -eq $wpnB) -and ($appliedA -and $appliedA.Contains($wpnB))
Write-Host "=== WEAPON: A wpn=$wpnA ; B wpn=$wpnB ; A sees peerwpn=$peerWpnA applied=$appliedA ; B applied=$appliedB"
Write-Host "=== WEAPON: $(if ($weaponOk) { 'PASS' } else { 'FAIL' })"

# look: B puts a mask on (the game's own BPC_AttachableItems:AddItem), A has to
# show it on B's body; then B takes it off and A has to follow
function Wait-Look([int]$secs, [scriptblock]$cond) {
    $end = (Get-Date).AddSeconds($secs)
    while ((Get-Date) -lt $end) { Hide-GameWindow; if (& $cond) { return $true }; Start-Sleep -Milliseconds 700 }
    return $false
}
$lookPartsB0 = [int](Get-SyncValue $coopB 'lookparts')
$lookB0 = Get-SyncValue $coopB 'look'
[System.IO.File]::WriteAllText((Join-Path $coopB 'cmd.txt'), "lookadd /Game/Sparta/Items/Pickups/BP_AIM_FlowerCrown.BP_AIM_FlowerCrown_C`n")
$lookOn = Wait-Look 40 {
    $lb = Get-SyncValue $coopB 'look'
    ([int](Get-SyncValue $coopB 'lookparts') -gt $lookPartsB0) -and $lb -and ($lb -ne $lookB0) -and ((Get-SyncValue $coopA 'lookapplied') -eq $lb) -and ([int](Get-SyncValue $coopA 'peerlookparts') -gt $lookPartsB0)
}
Write-Host "=== LOOK on: B look=$(Get-SyncValue $coopB 'look') parts=$(Get-SyncValue $coopB 'lookparts') (was $lookPartsB0) ; A peerlook=$(Get-SyncValue $coopA 'peerlook') applied=$(Get-SyncValue $coopA 'lookapplied') parts=$(Get-SyncValue $coopA 'peerlookparts') missing=$(Get-SyncValue $coopA 'lookmissing') loads=$(Get-SyncValue $coopA 'gameloads')"
[System.IO.File]::WriteAllText((Join-Path $coopB 'cmd.txt'), "lookdel`n")
$lookOff = Wait-Look 30 {
    $lb = Get-SyncValue $coopB 'look'
    ($lb -eq $lookB0) -and ((Get-SyncValue $coopA 'lookapplied') -eq $lb) -and ([int](Get-SyncValue $coopA 'peerlookparts') -eq $lookPartsB0)
}
Write-Host "=== LOOK off: B parts=$(Get-SyncValue $coopB 'lookparts') ; A applied=$(Get-SyncValue $coopA 'lookapplied') parts=$(Get-SyncValue $coopA 'peerlookparts')"
$lookOk = $lookOn -and $lookOff
Write-Host "=== LOOK: $(if ($lookOk) { 'PASS' } else { 'FAIL' }) (on=$lookOn off=$lookOff)"

if (-not $StreamOnly) {
# animation: make the host's player walk a small circle, so the guest's puppet
# really moves and the guest can measure idle vs moving pose amplitude
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "patrol 14`n")
$animFile = Join-Path $coopB 'result_anim.txt'
$animDeadline = (Get-Date).AddSeconds(45)
while (-not (Test-Path $animFile) -and (Get-Date) -lt $animDeadline) { Hide-GameWindow; Start-Sleep -Milliseconds 700 }
$resAnim = if (Test-Path $animFile) { (Get-Content $animFile -Raw).Trim() } else { $null }
Write-Host "=== ANIM: $resAnim"

# combat 1: the guest damages its copy, the host has to adopt that health
[System.IO.File]::WriteAllText((Join-Path $coopB 'cmd.txt'), "hurt 0.5`n")
$damageOk = $false
$damageDeadline = (Get-Date).AddSeconds(30)
while ((Get-Date) -lt $damageDeadline) {
    Hide-GameWindow
    $hpA = Get-SyncValue $coopA 'hp'
    if ($hpA -and $hpA -match '=0\.[0-6]\d{2}') { $damageOk = $true; Write-Host "host hp now: $hpA"; break }
    Start-Sleep -Milliseconds 600
}
Write-Host "=== DAMAGE: $(if ($damageOk) { 'PASS' } else { 'FAIL' })"

# combat 2: the host kills an enemy, the guest's copy has to die through
# SpartaHealthComponent:StartDeath (native death animation)
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "kill`n")
$deathOk = $false
$deathDeadline = (Get-Date).AddSeconds(30)
while ((Get-Date) -lt $deathDeadline) {
    Hide-GameWindow
    $deadB = Get-SyncValue $coopB 'dead'
    if ($deadB -and $deadB.Length -gt 4) { $deathOk = $true; Write-Host "guest dead list: $deadB"; break }
    Start-Sleep -Milliseconds 600
}
Write-Host "=== DEATH: $(if ($deathOk) { 'PASS' } else { 'FAIL' })"

# world state: the host opens the nearest closed door and picks up the nearest
# pickup through the game's own functions; the guest has to replay both
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "wstest`n")
$wsFile = Join-Path $coopB 'result_ws.txt'
$wsDeadline = (Get-Date).AddSeconds(45)
while (-not (Test-Path $wsFile) -and (Get-Date) -lt $wsDeadline) { Hide-GameWindow; Start-Sleep -Milliseconds 700 }
$resWs = if (Test-Path $wsFile) { (Get-Content $wsFile -Raw).Trim() } else { $null }
Write-Host "=== WORLD: A $(Get-SyncValue $coopA 'ws') ; B $(Get-SyncValue $coopB 'ws')"
Write-Host "=== WORLD: $resWs"

# world progression: the host marks the nearest chest opened in store B, drops a
# narrative tag and restores it 12 s later, and flips an audio data layer; the
# guest has to write the chest value, remove and re-add the tag (and follow the layer)
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "wptest`n")
$wpFile = Join-Path $coopB 'result_wp.txt'
$wpDeadline = (Get-Date).AddSeconds(60)
while (-not (Test-Path $wpFile) -and (Get-Date) -lt $wpDeadline) { Hide-GameWindow; Start-Sleep -Milliseconds 700 }
$resWp = if (Test-Path $wpFile) { (Get-Content $wpFile -Raw).Trim() } else { $null }
Write-Host "=== PROGRESS: A $(Get-SyncValue $coopA 'wp') ; B $(Get-SyncValue $coopB 'wp')"
Write-Host "=== PROGRESS: $resWp"

# quests: the host starts a quest from DT_QuestData1 and completes it 12 s later;
# the guest has to add it and then complete it in its own quest log
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "qstest`n")
$qsFile = Join-Path $coopB 'result_qs.txt'
$qsDeadline = (Get-Date).AddSeconds(45)
while (-not (Test-Path $qsFile) -and (Get-Date) -lt $qsDeadline) { Hide-GameWindow; Start-Sleep -Milliseconds 700 }
$resQs = if (Test-Path $qsFile) { (Get-Content $qsFile -Raw).Trim() } else { $null }
Write-Host "=== QUEST: $resQs"

# quest state: the host starts a hub NPC quest, tracks it, raises the NPC
# relationship, hears an objective, moves a stage on, then completes and turns it
# in; the guest has to mirror each step
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "qs2test`n")
$qs2File = Join-Path $coopB 'result_qs2.txt'
$qs2Deadline = (Get-Date).AddSeconds(60)
while (-not (Test-Path $qs2File) -and (Get-Date) -lt $qs2Deadline) { Hide-GameWindow; Start-Sleep -Milliseconds 700 }
$resQs2 = if (Test-Path $qs2File) { (Get-Content $qs2File -Raw).Trim() } else { $null }
Write-Host "=== QUEST2: $resQs2"

# lift: the host starts the hub lift the way its lever does; the guest has to
# replay it and see its own cabin travel to the same floor
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "lifttest`n")
$liftFile = Join-Path $coopB 'result_lift.txt'
$liftDeadline = (Get-Date).AddSeconds(40)
while (-not (Test-Path $liftFile) -and (Get-Date) -lt $liftDeadline) { Hide-GameWindow; Start-Sleep -Milliseconds 700 }
$resLift = if (Test-Path $liftFile) { (Get-Content $liftFile -Raw).Trim() } else { $null }
Write-Host "=== LIFT: A $(Get-SyncValue $coopA 'lift') ; B $(Get-SyncValue $coopB 'lift')"
Write-Host "=== LIFT: $resLift"

# chest: the host opens the nearest unopened chest (TimesUsed + store B), its lid
# plays and one item lands in its inventory as the stand-in reward; the guest has
# to play the lid and receive the same item
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "cstest`n")
$chestFile = Join-Path $coopB 'result_chest.txt'
$chestDeadline = (Get-Date).AddSeconds(40)
while (-not (Test-Path $chestFile) -and (Get-Date) -lt $chestDeadline) { Hide-GameWindow; Start-Sleep -Milliseconds 700 }
$resChest = if (Test-Path $chestFile) { (Get-Content $chestFile -Raw).Trim() } else { $null }
Write-Host "=== CHEST: A $(Get-SyncValue $coopA 'chest') ; B $(Get-SyncValue $coopB 'chest')"
Write-Host "=== CHEST: $resChest"

}

function Wait-File([string]$f, [int]$secs) {
    $dl = (Get-Date).AddSeconds($secs)
    while (-not (Test-Path $f) -and (Get-Date) -lt $dl) { Hide-GameWindow; Start-Sleep -Milliseconds 700 }
    if (Test-Path $f) { return (Get-Content $f -Raw).Trim() } else { return $null }
}
function Get-Taken([string]$coopDir) {
    $e = Get-SyncValue $coopDir 'enemy'
    if ($e -match 'taken:(\d+)') { return [int]$matches[1] } else { return 0 }
}
function Get-WS { $p = Get-Process | Where-Object ProcessName -match 'MortalShell2-Win64' | Sort-Object StartTime | Select-Object -First 1; if ($p) { [int]($p.WorkingSet64 / 1MB) } else { 0 } }

# spawn: the guest walks into a proximity spawner the host has not triggered;
# its enemy must appear on the host too and be driven by the guest
[System.IO.File]::WriteAllText((Join-Path $coopB 'cmd.txt'), "tp $SpawnPoint`n")
$resSpawn = Wait-File (Join-Path $coopA 'result_spawn.txt') 45
Write-Host "=== SPAWN: $resSpawn (A $(Get-SyncValue $coopA 'enemy'))"
$mirrorOk = $false
$mDeadline = (Get-Date).AddSeconds(20)
while ((Get-Date) -lt $mDeadline) {
    if ((Get-Taken $coopA) -gt 0) { $mirrorOk = $true; break }
    Hide-GameWindow; Start-Sleep -Milliseconds 700
}
Write-Host "=== MIRROR: $(if ($mirrorOk) { 'PASS host copy driven by the guest (AI paused, owner motion/facing/montage)' } else { 'FAIL' }) (A $(Get-SyncValue $coopA 'enemy') ; B $(Get-SyncValue $coopB 'enemy'))"

# a hit on the guest's body in the host world must land on the guest
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "pdtest`n")
$resPd = Wait-File (Join-Path $coopB 'result_pd.txt') 20
Write-Host "=== PEERHIT: $resPd"
[System.IO.File]::WriteAllText((Join-Path $coopA 'cmd.txt'), "aitest`n")
$resAi = Wait-File (Join-Path $coopA 'result_ai.txt') 15
Write-Host "=== AITARGET: $resAi"

# long travel: the guest crosses the map in a straight line (60 s) to a landing
# area ~90k away; the host must keep streaming around the moving body
$wsBefore = Get-WS
[System.IO.File]::WriteAllText((Join-Path $coopB 'cmd.txt'), "travel $FarPoint 60`n")
$resStream = Wait-File (Join-Path $coopA 'result_stream.txt') 130
$wsAfter = Get-WS
Write-Host "=== STREAM: A $(Get-SyncValue $coopA 'stream') ; B $(Get-SyncValue $coopB 'stream')"
Write-Host "=== STREAM: $resStream"

# pull one host-side enemy over to the far guest (on the guest only): the host
# must hand it over and move its own copy to the guest
$fp = @($FarPoint -split '\s+' | ForEach-Object { [double]$_ })
[System.IO.File]::WriteAllText((Join-Path $coopB 'cmd.txt'), "npctp $($fp[0] + 600) $($fp[1]) $($fp[2])`n")
$farOk = $false
$farTail = $null
$farDeadline = (Get-Date).AddSeconds(20)
while ((Get-Date) -lt $farDeadline) {
    $m = Select-String -Path (Join-Path $coopB 'probe.log') -Pattern 'npctp -> (\S+)' | Select-Object -Last 1
    if ($m) {
        $farTail = $m.Matches[0].Groups[1].Value
        if (Select-String -Path (Join-Path $coopA 'probe.log') -SimpleMatch "mirroring peer-owned enemy $farTail" -Quiet) { $farOk = $true; break }
    }
    Hide-GameWindow; Start-Sleep -Milliseconds 700
}
Write-Host "=== NPCFAR: $(if ($farOk) { "PASS host hands $farTail to the far guest and moves its copy there" } else { "FAIL ($farTail)" })"
Write-Host "=== PERF: host working set ${wsBefore} MB -> ${wsAfter} MB with the far area loaded; A $(Get-SyncValue $coopA 'perf') ; B $(Get-SyncValue $coopB 'perf')"

# ledger: keys known true from earlier sessions are re-applied when their actor
# loads (only reports when a ledger from an earlier run exists)
$ledA = Join-Path $coopA 'result_ledger.txt'; $ledB = Join-Path $coopB 'result_ledger.txt'
Write-Host "=== LEDGER: A $(Get-SyncValue $coopA 'ledger') ; B $(Get-SyncValue $coopB 'ledger')"
Write-Host "=== LEDGER: A $(if (Test-Path $ledA) { (Get-Content $ledA -Raw).Trim() } else { '-' }) ; B $(if (Test-Path $ledB) { (Get-Content $ledB -Raw).Trim() } else { '-' })"

$resNpc = $null
$npcFile = Join-Path $coopB 'result_npc.txt'
if (Test-Path $npcFile) { $resNpc = (Get-Content $npcFile -Raw).Trim() }
Write-Host "=== NPC: $resNpc"
Write-Host "=== A: $resA"
Write-Host "=== B: $resB"
foreach ($d in @($coopA, $coopB)) {
    Write-Host "--- $d ---"
    $lg = Join-Path $d 'probe.log'
    if (Test-Path $lg) { Get-Content $lg | Select-Object -Last 15 } else { Write-Host "(no log)" }
}

$pass = ($resA -match '^PASS') -and ($resB -match '^PASS') -and $shellOk -and $weaponOk -and $lookOk -and ($resStream -match '^PASS') -and $farOk -and ($resSpawn -match '^PASS') -and $mirrorOk -and ($resPd -match '^PASS')
if (-not $StreamOnly) { $pass = $pass -and $damageOk -and $deathOk -and ($resAnim -match '^PASS') -and ($resWs -match '^PASS') -and ($resWp -match '^PASS') }
Stop-ReporterKiller
Stop-All
# restore the owner's saves exactly: put the snapshot back, remove anything new
if (Test-Path $saveSnap) {
    Get-ChildItem $realSaveDir -Filter *.sav | Where-Object { $saveNamesBefore -notcontains $_.Name } | ForEach-Object {
        Remove-Item $_.FullName -Force -ErrorAction SilentlyContinue
    }
    Copy-Item (Join-Path $saveSnap "*.sav") $realSaveDir -Force
    Write-Host "saves restored from snapshot"
}

Write-Host "owner saves restored from snapshot (the game ignores overridden LOCALAPPDATA)"
if ($pass) { Write-Host "RESULT: PASS" } else { Write-Host "RESULT: FAIL" }