 int32 AlignUp(int32 v, int32 a) {
     if (a <= 1) return v;
     return ((v + a - 1) / a) * a;
 }
 
+// TPair<Key,Value> value offset with no FScriptMapLayout to read it from: the value
+// follows the key, aligned to its own natural alignment (8 for a struct, FString or
+// pointer; 4 for int32/float/FName; 1 for bool/byte).
+int32 DerivedValueOffset(int32 keySize, int32 valueSize) {
+    int32 align = 1;
+    if (valueSize >= 8) align = 8;
+    else if (valueSize >= 4) align = 4;
+    return AlignUp(keySize, align);
