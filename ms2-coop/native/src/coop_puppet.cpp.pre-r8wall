// ===========================================================================
// the module's own clock
//
// net::Now() is UGameplayStatics.GetRealTimeSeconds through ProcessEvent, and in
// this build its return is NOT a usable clock.  Measured in the 2026-10-25 run
// (probe.log, both clients): one second of wall time produced 0.0 -> -0.6 ->
// -160.0 (`spawnscan: clock rewound`, coop_combat's own guard firing), and the
// drive-hide diagnostic below printed now=3.7e35 / now=2.9e38.  Every timer this
// module owns aborted on its first tick because of it:
//
//   patrol   `patrol: done`          1 s after a 14 s circle   (t > dur on tick 2)
//   travel   `travel arrived at ...`  the same second as a 60 s trip
//   tp hold  `tp hold released`       1 s after a 6 s hold
//   stream   verdict written 1 s into the 25 s settle window (n0 -> n1 sequentially)
//
// The Lua used os.clock()/rt() -- real elapsed time -- so a steady clock is the
// faithful replacement, and unlike GetRealTimeSeconds it cannot rewind on a level
// load (docs/NATIVE-PORT.md 4.7 already says os.clock() must become real time).
// The two fields net::ApplyPeer stamps from net::Now() (PEER().at / PEER().wallAt)
// are read through PeerAge() below so a broken game clock cannot hide the body.
// ===========================================================================

double TickSeconds() {
    using namespace std::chrono;
    static const steady_clock::time_point t0 = steady_clock::now();
    return duration_cast<duration<double>>(steady_clock::now() - t0).count();
}

// ===========================================================================
// state accessors (the sub-structs are PUBLIC, but only this module writes
// PuppetState -- coop_state.h rule 1)
// ===========================================================================

inline PuppetState& P() { return coop::state().puppet; }
inline PeerState& PEER() { return coop::state().peer; }
inline LocalState& LOCAL() { return coop::state().local; }
inline const Toggles& TG() { return coop::state().toggles; }

// How old the peer's last packet is, in seconds, from a clock that cannot lie.
// PEER().at comes from net::Now(); when that reads garbage the difference is not
// a plausible age (negative or astronomically large) and the 1 s wall stamp
// net::ApplyPeer also writes (PEER().wallAt) is used instead.  DriveTick hides the
// body when this exceeds kPeerStale, so a garbage age made the body flicker
// hidden/visible ~3x/s for the whole run (`puppet hidden (peer not in session
// yet)` x1583 on A, x2448 on B).
double PeerAge(double tnow) {
    const double a = tnow - PEER().at;
    if (a >= -1.0 && a <= 120.0) return a;
    const double w = (double)(net::Wall() - PEER().wallAt);
    if (w >= 0.0 && w <= 120.0) return w;
    return 0.0;
}

// main.lua:586 -- the FindAllOf("BP_PlayerCharacter_C") name snapshot that tells
