inline WorldState& W() { return St().world; }
inline LedgerState& L() { return St().world.ledger; }
inline const Toggles& Tg() { return coop::toggles(); }
inline bool LedgerOn() { return Tg().wsLedgerOn; }

// ===========================================================================
