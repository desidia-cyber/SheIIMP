// ---------------------------------------------------------------------------
// PE header walk: where is .text?  (For the AOB scan only.)
// ---------------------------------------------------------------------------
bool FindTextRange(uint8_t* base, uint8_t** lo, uint8_t** hi) {
    __try {
        const uint8_t* dos = base;
        if (dos[0] != 'M' || dos[1] != 'Z') return false;
        const uint32_t e_lfanew = *reinterpret_cast<const uint32_t*>(dos + 0x3C);
        const uint8_t* nt = dos + e_lfanew;
        if (nt[0] != 'P' || nt[1] != 'E') return false;
        const uint16_t nsec = *reinterpret_cast<const uint16_t*>(nt + 6);
        const uint16_t optsize = *reinterpret_cast<const uint16_t*>(nt + 20);
        const uint8_t* sect = nt + 24 + optsize;
        for (uint16_t i = 0; i < nsec; ++i) {
            const uint8_t* s = sect + i * 40;
            const uint32_t vsize = *reinterpret_cast<const uint32_t*>(s + 8);
            const uint32_t vaddr = *reinterpret_cast<const uint32_t*>(s + 12);
            const uint32_t chars = *reinterpret_cast<const uint32_t*>(s + 36);
            if ((chars & 0x20000000) && s[0] == '.' && s[1] == 't' && s[2] == 'e') {
                *lo = base + vaddr;
                *hi = base + vaddr + vsize;
                return true;
            }
        }
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return false;
    }
    return false;
}

// ---------------------------------------------------------------------------
// AOB scan: "48 8B 05 ?? ?? ?? ??" -- the same notation as UE4SS's signature
// files, so a signature can be pasted between the tools without translation.
// ---------------------------------------------------------------------------
struct AobPattern {
    uint8_t bytes[64];
    uint8_t mask[64];
    int     len = 0;
};

int HexDigit(char c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

bool ParseAob(const char* s, AobPattern& p) {
    p.len = 0;
    while (*s) {
        while (*s == ' ') ++s;
        if (!*s) break;
        if (p.len >= 64) return false;
        if (s[0] == '?' && s[1] == '?') {
            p.mask[p.len] = 1;
            p.bytes[p.len] = 0;
            ++p.len;
            s += 2;
            continue;
        }
        const int hi = HexDigit(s[0]);
        const int lo = (s[1] ? HexDigit(s[1]) : -1);
        if (hi < 0 || lo < 0) return false;
        p.bytes[p.len] = (uint8_t)((hi << 4) | lo);
        p.mask[p.len] = 0;
        ++p.len;
        s += 2;
    }
    return p.len > 0;
}

bool ScanAob(const AobPattern& p, uint8_t** hit) {
    if (!g_textLo || !g_textHi || p.len <= 0) return false;
    int anchor = 0;
    while (anchor < p.len && p.mask[anchor]) ++anchor;
    if (anchor >= p.len) return false;

    uint8_t* cur = g_textLo;
    if ((size_t)(g_textHi - g_textLo) <= (size_t)p.len) return false;
    uint8_t* end = g_textHi - p.len;
    while (cur <= end) {
        uint8_t* found = (uint8_t*)memchr(cur, p.bytes[anchor], (size_t)(end - cur) + 1);
        if (!found) return false;
        uint8_t* start = found - anchor;
        if (start >= g_textLo) {
            int i = 0;
            for (; i < p.len; ++i)
                if (!p.mask[i] && start[i] != p.bytes[i]) break;
            if (i == p.len) { *hit = start; return true; }
        }
        cur = found + 1;
    }
    return false;
}

// ---------------------------------------------------------------------------
// ini overrides -- the escape hatch for a different game build.
// ---------------------------------------------------------------------------
bool ReadIniValue(const wchar_t* iniPath, const char* key, uint64_t* out) {
    if (!iniPath || !iniPath[0]) return false;
    HANDLE h = CreateFileW(iniPath, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
                           NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
    if (h == INVALID_HANDLE_VALUE) return false;
    char buf[4096];
    DWORD got = 0;
    const BOOL ok = ReadFile(h, buf, sizeof(buf) - 1, &got, NULL);
    CloseHandle(h);
    if (!ok || got == 0) return false;
    buf[got] = 0;

    const size_t klen = strlen(key);
    for (char* line = buf; *line; ) {
        char* e = line;
        while (*e && *e != '\n' && *e != '\r') ++e;
        const char save = *e;
        *e = 0;

        char* p = line;
        while (*p == ' ' || *p == '\t') ++p;
        if (*p && *p != ';' && *p != '#' && _strnicmp(p, key, klen) == 0) {
            const char* q = p + klen;
            while (*q == ' ' || *q == '\t') ++q;
            if (*q == '=') {
                ++q;
                while (*q == ' ' || *q == '\t') ++q;
                uint64_t v = 0;
                bool any = false;
                if (q[0] == '0' && (q[1] == 'x' || q[1] == 'X')) {
                    for (q += 2; *q; ++q) {
                        const int d = HexDigit(*q);
                        if (d < 0) break;
                        v = (v << 4) | (uint64_t)d;
                        any = true;
                    }
                } else {
                    for (; *q >= '0' && *q <= '9'; ++q) { v = v * 10 + (uint64_t)(*q - '0'); any = true; }
                }
                *e = save;
                if (any) { *out = v; return true; }
                return false;
            }
        }
        *e = save;
        line = save ? e + 1 : e;
    }
    return false;
}

// ---------------------------------------------------------------------------
// Global resolution: ini, then AOB, then this build's RVA (provenance logged).
// ---------------------------------------------------------------------------
struct GlobalSpec {
    const char* name;
    const char* aob;
    int         dispOffset;   // -1: the match address IS the answer
    uint32_t    fallbackRva;
    uintptr_t*  out;
    const char** source;
};

// Each pattern below was verified offline against this exe: it matches exactly
// once in .text and resolves to the address the recovery pass proved (see
// tools/gen_patterns.py, whose output is quoted in README.md).
const char* kSigProcessEvent =
    "40 55 56 57 41 54 41 55 41 56 41 57 48 81 EC 00 01 00 00 48 8D 6C 24 30";
// FName::AppendString.  This one is EXACT rather than wildcarded on purpose: the
// first attempt wildcarded the "cmp byte ptr [rip+X], 0" displacement and matched
// 27 places in .text (tests/test_scan.cpp caught it, which is why that test
// exists).  A wildcard that costs uniqueness is not worth having, and the RVA
// fallback covers a moved build anyway.
const char* kSigAppendString =
    "48 89 5C 24 10 48 89 74 24 18 57 48 83 EC 20 80 3D 63 E1 B5 09 00 48 8B";
const char* kSigEngineTick =
    "40 55 53 41 54 41 55 41 57 48 8D 6C 24 E0 48 81 EC 20 01 00 00 0F 29 B4";
// The engine's own object-array accessor: mov rax,[GObjects] / mov rcx,[rax+rcx*8].
// Anchoring on the USE rather than on a prologue is what makes this survive a
// rebuild that moves the function.
const char* kSigGObjects =
    "48 8B 05 ?? ?? ?? ?? 48 8B 0C C8 48 8D 0C D1 EB 06 45 33 FF 41 8B CF BA";

bool ResolveGlobal(const GlobalSpec& g, const wchar_t* iniPath) {
    uint64_t rva = 0;
    if (ReadIniValue(iniPath, g.name, &rva) && rva > 0 && rva < 0x40000000ull) {
        *g.out = g_res.imageBase + (uintptr_t)rva;
        *g.source = "ini";
        return true;
    }
    if (g.aob) {
        AobPattern p;
        if (ParseAob(g.aob, p)) {
            uint8_t* hit = nullptr;
            if (ScanAob(p, &hit)) {
                if (g.dispOffset < 0) {
                    *g.out = (uintptr_t)hit;
                } else {
                    int32_t disp = 0;
                    if (SafeRead(hit + g.dispOffset, &disp, sizeof(disp)))
                        *g.out = (uintptr_t)(hit + g.dispOffset + 4 + disp);
                }
                if (*g.out) { *g.source = "aob"; return true; }
            }
        }
    }
    if (g.fallbackRva) {
        const uintptr_t cand = g_res.imageBase + g.fallbackRva;
        const bool inText = g_textLo && (uint8_t*)cand >= g_textLo && (uint8_t*)cand < g_textHi;
        uint8_t probe = 0;
        const bool readable = SafeRead((const void*)cand, &probe, 1);
        if (inText || readable) {
            *g.out = cand;
            *g.source = "rva(build-specific)";
            return true;
        }
    }
    *g.out = 0;
    *g.source = "UNRESOLVED";
    return false;
}

