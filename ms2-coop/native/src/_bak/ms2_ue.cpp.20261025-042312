namespace {

FProperty* FindPropertyLocal(UObject* st, const char* name) {
    if (!PlausiblePtr(st) || !name) return nullptr;
    FField* f = nullptr;
    if (!Read((uint8_t*)st + kOffStructChildProps, f)) return nullptr;
    for (int depth = 0; depth < 8192 && PlausiblePtr(f); ++depth) {
        FName fn;
        if (!Read((uint8_t*)f + kOffFieldName, fn)) return nullptr;
        if (NameToString(fn) == name) return (FProperty*)f;
        FField* next = nullptr;
        if (!Read((uint8_t*)f + kOffFieldNextF, next)) return nullptr;
        f = next;
    }
    return nullptr;
}

}  // namespace

FProperty* FindProperty(UStruct* st, const char* name) {
    UObject* it = (UObject*)st;
    if (!PlausiblePtr(it) || !name) return nullptr;
    for (int depth = 0; depth < 256 && PlausiblePtr(it); ++depth) {
        if (FProperty* p = FindPropertyLocal(it, name)) return p;
        it = (UObject*)SuperOf(it);
    }
    return nullptr;
}

FProperty* FindProperty(UClass* c, const char* name) {
    return FindProperty((UStruct*)c, name);
}

namespace {

std::mutex g_propCacheLock;
std::unordered_map<std::string, int32_t> g_propOffsetCache;

std::string PropKey(UObject* st, const char* name) {
    char key[32];
    _snprintf_s(key, sizeof(key), _TRUNCATE, "%llX:", (unsigned long long)(uintptr_t)st);
    return std::string(key) + name;
}

}  // namespace

int32_t PropOffsetStruct(UStruct* st, const char* name) {
    UObject* s = (UObject*)st;
    if (!PlausiblePtr(s) || !name) return -1;

    const std::string key = PropKey(s, name);
    {
        std::lock_guard<std::mutex> lock(g_propCacheLock);
        auto it = g_propOffsetCache.find(key);
        if (it != g_propOffsetCache.end()) return it->second;
    }

    int32_t result = -1;
    if (FProperty* p = FindProperty(st, name)) {
        int32_t off = -1;
        if (Read((uint8_t*)p + kOffPropOffset, off)) result = off;
    }
    {
        std::lock_guard<std::mutex> lock(g_propCacheLock);
        g_propOffsetCache[key] = result;
    }
    return result;
}

int32_t PropOffset(UObject* o, const char* name) {
    UClass* c = ClassOf(o);
    if (!PlausiblePtr(c)) return -1;
    return PropOffsetStruct((UStruct*)c, name);
}

int32_t PropSize(UObject* o, const char* name) {
    UClass* c = ClassOf(o);
    if (!PlausiblePtr(c)) return -1;
    FProperty* p = FindProperty((UStruct*)c, name);
    if (!p) return -1;
    int32_t sz = -1;
    Read((uint8_t*)p + kOffPropElementSize, sz);
    return sz;
}

// ---------------------------------------------------------------------------
// Booleans
//
// A UE bool property is a MASK, not a bool: FBoolProperty keeps FieldSize,
// ByteOffset and ByteMask at +0x70..0x73, and the value lives in one bit.  Reading
// a byte and calling it a bool is how a mod ends up toggling three unrelated flags
// at once, so this applies the mask.
// ---------------------------------------------------------------------------
namespace {

// A UE bool property is a MASK, not a bool -- see GetBool.

}  // namespace

bool GetBool(UObject* o, const char* prop) {
    if (!IsValid(o)) return false;
    const int32_t off = PropOffset(o, prop);
    if (off < 0) return false;

    UClass* c = ClassOf(o);
    FProperty* p = PlausiblePtr(c) ? FindProperty((UStruct*)c, prop) : nullptr;
    uint8_t fieldSize = 0, byteOffset = 0, byteMask = 0, fieldMask = 0;
    if (PlausiblePtr(p)) {
        Read((uint8_t*)p + 0x70, fieldSize);
        Read((uint8_t*)p + 0x71, byteOffset);
        Read((uint8_t*)p + 0x72, byteMask);
        Read((uint8_t*)p + 0x73, fieldMask);
    }
    uint8_t byte = 0;
    if (!Read((uint8_t*)o + off + (int32_t)byteOffset, byte)) return false;
    const uint8_t mask = fieldMask ? fieldMask : (byteMask ? byteMask : 0xFF);
    return (byte & mask) != 0;
}

bool SetBool(UObject* o, const char* prop, bool v) {
    if (!IsValid(o)) return false;
    const int32_t off = PropOffset(o, prop);
    if (off < 0) return false;

    UClass* c = ClassOf(o);
    FProperty* p = PlausiblePtr(c) ? FindProperty((UStruct*)c, prop) : nullptr;
    uint8_t byteOffset = 0, byteMask = 0, fieldMask = 0;
    if (PlausiblePtr(p)) {
        Read((uint8_t*)p + 0x71, byteOffset);
        Read((uint8_t*)p + 0x72, byteMask);
        Read((uint8_t*)p + 0x73, fieldMask);
    }
    uint8_t* at = (uint8_t*)o + off + (int32_t)byteOffset;
    uint8_t byte = 0;
    if (!Read(at, byte)) return false;
    const uint8_t mask = fieldMask ? fieldMask : (byteMask ? byteMask : 0xFF);
    byte = v ? (uint8_t)(byte | mask) : (uint8_t)(byte & ~mask);
    return WriteMem(at, &byte, 1);
}

UObject* GetCDO(UClass* c) {
    if (!PlausiblePtr(c)) return nullptr;
    UObject* cdo = nullptr;
    if (!Read((uint8_t*)c + kOffClassDefaultObj, cdo)) return nullptr;
    return PlausiblePtr(cdo) ? cdo : nullptr;
}

// GWorld: a UWorld* global.  Validated, because this is the one address in the
// module that comes from the SDK's RVA alone (no signature was recovered for it,
// and the SDK itself calls it "decoration").  A wrong read yields nullptr.
UObject* GetWorld() {
    ProfScope _prof("GetWorld", nullptr);
    if (!g_res.gworld) return nullptr;
    UObject* w = nullptr;
    if (!Read((const void*)g_res.gworld, w)) return nullptr;
    if (!PlausiblePtr(w) || !IsValid(w)) return nullptr;
    if (GetClassName(w) != "World") return nullptr;
    return w;
}

// ---------------------------------------------------------------------------
// Functions
// ---------------------------------------------------------------------------
namespace {

UFunction* FindFunctionLocal(UObject* st, const char* name) {
    if (!PlausiblePtr(st) || !name) return nullptr;
    UField* f = nullptr;
    if (!Read((uint8_t*)st + kOffStructChildren, f)) return nullptr;
    for (int depth = 0; depth < 8192 && PlausiblePtr(f); ++depth) {
        // The Children chain holds nested classes and enums too; the cheap
        // integer class test keeps the string compare off them.
        if (IsFunctionObject((UObject*)f) && NameToString(NameOf((UObject*)f)) == name)
            return (UFunction*)f;
        UField* next = nullptr;
        if (!Read((uint8_t*)f + kOffFieldNext, next)) return nullptr;
        f = next;
    }
    return nullptr;
}

}  // namespace

UFunction* FindFunction(UObject* o, const char* name) {
    if (!PlausiblePtr(o) || !name) return nullptr;
    UObject* c = (UObject*)ClassOf(o);
    for (int depth = 0; depth < 256 && PlausiblePtr(c); ++depth) {
        if (UFunction* f = FindFunctionLocal(c, name)) return f;
        c = (UObject*)SuperOf(c);
    }
    return nullptr;
}

bool Call(UObject* o, UFunction* fn, void* params) {
    if (!IsValid(o) || !PlausiblePtr(fn) || !g_res.processEvent) return false;
    // A UFunction with parameters needs a parameter block.  Passing nullptr would
    // have the engine's own thunk read through it; refuse instead of letting an AV
    // land inside ProcessEvent (SEH would catch it, but the engine is mid-frame).
    uint16_t parmsSize = 0;
    if (Read((uint8_t*)fn + kOffFuncParmsSize, parmsSize) && parmsSize > 0 && !params) {
        ms2::Logf("Call: %s has ParmsSize=%u but no parameter block -- refused",
                  GetName((UObject*)fn).c_str(), (unsigned)parmsSize);
        return false;
    }
    const bool ok = CallProcessEventAt(g_res.processEvent, o, fn, params);
    if (!ok) ms2::Log("Call: ProcessEvent faulted -- suppressed (the offset or the function name is wrong)");
    return ok;
}

bool Call(UObject* o, const char* fnName, void* params) {
    UFunction* fn = FindFunction(o, fnName);
    if (!fn) {
        ms2::Logf("Call: no UFunction '%s' on %s", fnName ? fnName : "(null)",
                  GetClassName(o).c_str());
        return false;
    }
    return Call(o, fn, params);
}

// ---------------------------------------------------------------------------
// MakeName: FName from a string, using the GAME's own conversion.
//
// UKismetStringLibrary::Conv_StringToName(FString InString) -> FName is called
// through ProcessEvent with a Params block.  That keeps the name-pool layout --
// which differs between UE versions and is not documented here -- entirely on the
// engine's side, and it is the one path that is provably right because the game's
// own Blueprint code uses exactly it.
//
// The rejected alternative: calling FName::FName(wchar_t*) at its address.  Its
// prologue (mov rbx,rcx / mov r11,rdx / mov edi,r8d) takes three registers and the
// convention could not be settled from the binary alone; guessing wrong means an
// 8-byte write through a bad pointer, which no SEH guard can undo.
// ---------------------------------------------------------------------------
namespace {
std::atomic<int> g_makeNameState{0};   // 0 = untried, 1 = works, 2 = unavailable

// Conv_StringToName is a full ProcessEvent call, so resolving the same handful of
// class names twice a second would add engine traffic for nothing.  A small
// bounded table is enough: callers ask for a fixed set of class/property names.
struct NameRow {
    char  key[56];
    FName name;
};
NameRow    g_nameRows[128];
int        g_nameRowCount = 0;
std::mutex g_nameRowsLock;

FName CachedName(const char* ascii) {
    std::lock_guard<std::mutex> lock(g_nameRowsLock);
    for (int i = 0; i < g_nameRowCount; ++i) {
        if (strcmp(g_nameRows[i].key, ascii) == 0) return g_nameRows[i].name;
    }
    return FName();
}

void StoreName(const char* ascii, FName n) {
    std::lock_guard<std::mutex> lock(g_nameRowsLock);
    if (g_nameRowCount >= (int)(sizeof(g_nameRows) / sizeof(g_nameRows[0]))) return;
    if (strlen(ascii) >= sizeof(g_nameRows[0].key)) return;
    strcpy_s(g_nameRows[g_nameRowCount].key, sizeof(g_nameRows[0].key), ascii);
    g_nameRows[g_nameRowCount].name = n;
    ++g_nameRowCount;
}
}  // namespace

// RAII: every early return below must clear the recursion flag, or FindClass's
// fast path would stay disabled on this thread after one failed conversion.
namespace {
struct MakeNameScope {
    MakeNameScope() { tl_inMakeName = 1; }
    ~MakeNameScope() { tl_inMakeName = 0; }
};
}  // namespace

FName MakeName(const char* ascii) {
    ProfScope _prof("MakeName", ascii);
    if (!ascii || !*ascii) return FName();
    if (g_makeNameState.load(std::memory_order_acquire) == 2) return FName();
    if (const FName hit = CachedName(ascii); hit.ComparisonIndex != 0) return hit;
    if (tl_inMakeName) return FName();          // FindClass -> MakeName -> FindClass
    MakeNameScope scope;

    UClass* lib = FindClass("KismetStringLibrary");
    if (!lib) {
        if (g_makeNameState.exchange(2) != 2)
            ms2::Log("MakeName: KismetStringLibrary not found -- FName construction is unavailable");
        return FName();
    }
    UObject* cdo = nullptr;
    if (!Read((uint8_t*)lib + kOffClassDefaultObj, cdo) || !PlausiblePtr(cdo)) {
        g_makeNameState.store(2);
        return FName();
    }
    UFunction* fn = FindFunction(cdo, "Conv_StringToName");
    if (!fn) {
        if (g_makeNameState.exchange(2) != 2)
            ms2::Log("MakeName: KismetStringLibrary.Conv_StringToName not found");
        return FName();
    }

    // The argument lives in a stack buffer: FString is ptr/num/max and the engine
    // only reads it -- the same shape the Dumper-7 SDK's name helper uses.
    wchar_t buf[256];
    int n = 0;
    for (; ascii[n] && n < 255; ++n) buf[n] = (wchar_t)(unsigned char)ascii[n];
    buf[n] = 0;
    FString in;
    in.Data = buf;
    in.Num = n;
    in.Max = 256;

    Params p(fn);
    if (!p.data()) return FName();
    // The parameter is "InString" in UE5; older builds spell it "InName".  Ask
    // rather than assume, and say so if neither is there.
    if (PropOffsetStruct((UStruct*)fn, "InString") >= 0)
        p.Set<FString>("InString", in);
    else if (PropOffsetStruct((UStruct*)fn, "InName") >= 0)
        p.Set<FString>("InName", in);
    else {
        ms2::Log("MakeName: Conv_StringToName has neither an InString nor an InName parameter");
        g_makeNameState.store(2);
        return FName();
    }

    if (!Call(cdo, fn, p.data())) {
        g_makeNameState.store(2);
        return FName();
    }
    const FName out = p.Get<FName>("ReturnValue");
    g_makeNameState.store(out.ComparisonIndex ? 1 : 2);
    if (!out.ComparisonIndex) {
        ms2::Logf("MakeName: Conv_StringToName(\"%s\") returned None", ascii);
    } else {
        StoreName(ascii, out);
    }
    return out;
}

// Alias -- the co-op lanes write ue::MakeFName.
FName MakeFName(const char* ascii) { return MakeName(ascii); }

// ---------------------------------------------------------------------------
// Params
// ---------------------------------------------------------------------------
Params::Params(UFunction* fn) : fn_(fn) {
    if (!PlausiblePtr(fn)) return;
    uint16_t parmsSize = 0;
    if (!Read((uint8_t*)fn + kOffFuncParmsSize, parmsSize)) return;
    // A UFunction with parameters must report a block size that covers them.  This
    // is the offset README.md marks as the one value not measured off this build
    // (ParmsSize sits between NumParms 0xB4 and ReturnValueOffset 0xB8), so say
    // what it reads for the first few functions with parameters; a wrong value
    // shows up here as ReturnValue reading garbage instead of a pointer.
    static std::atomic<int> sizeLogs{0};
    if (parmsSize > 0 && sizeLogs.fetch_add(1) < 12) {
        uint8_t numParms = 0;
        uint16_t retOff = 0;
        Read((uint8_t*)fn + kOffFuncNumParms, numParms);
        Read((uint8_t*)fn + kOffFuncReturnValue, retOff);
        ms2::Logf("Params: %s -> ParmsSize=%d NumParms=%d ReturnValueOffset=%d",
                  GetFullName((UObject*)fn).c_str(), (int)parmsSize, (int)numParms, (int)retOff);
    }
    size_ = parmsSize > 0 ? parmsSize : 8;
    if (size_ > 0x4000) {
        ms2::Logf("Params: %s reports ParmsSize=%d -- refusing", GetName((UObject*)fn).c_str(), (int)size_);
        size_ = 0;
        return;
    }
    buf_ = (uint8_t*)VirtualAlloc(nullptr, (size_t)size_, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
    if (!buf_) { size_ = 0; return; }
    memset(buf_, 0, (size_t)size_);
}

Params::~Params() {
    if (buf_) VirtualFree(buf_, 0, MEM_RELEASE);
    buf_ = nullptr;
}

int32_t Params::offset_of(const char* name) const {
    if (!PlausiblePtr(fn_) || !name) return -1;
    return PropOffsetStruct((UStruct*)fn_, name);
}

// ---------------------------------------------------------------------------
// Hooks, the game-thread queue and per-frame callbacks
// ---------------------------------------------------------------------------
namespace {

struct HookSlot {
    FName    fnName{};
    HookFn   pre = nullptr;
    HookFn   post = nullptr;
    char     name[192] = {0};
};

std::mutex            g_hookLock;
std::vector<HookSlot> g_hooks;
std::atomic<int>      g_hookCount{0};

std::mutex                          g_queueLock;
std::vector<std::function<void()>>  g_queue;

std::mutex                              g_tickLock;
std::vector<std::function<void(float)>> g_tickFns;

// FName-only histogram for the self-test: resolving a name here would put an
// engine call on the ProcessEvent hot path, so the strings are resolved later.
struct HistEntry { FName name{}; uint32 count = 0; };
constexpr int kHistMax = 128;
HistEntry       g_hist[kHistMax];
int             g_histUsed = 0;
std::atomic<bool> g_histOn{true};

void HistogramNote(UFunction* fn) {
    if (!g_histOn.load(std::memory_order_relaxed)) return;
    const FName n = NameOf((UObject*)fn);
    for (int i = 0; i < g_histUsed; ++i) {
        if (g_hist[i].name == n) { ++g_hist[i].count; return; }
    }
    if (g_histUsed >= kHistMax) return;
    g_hist[g_histUsed].name = n;
    g_hist[g_histUsed].count = 1;
    ++g_histUsed;
}

void RunHooksOn(UObject* self, UFunction* fn, void* parms, bool pre) {
    if (g_hookCount.load(std::memory_order_acquire) == 0) return;
    const FName n = NameOf((UObject*)fn);
    for (size_t i = 0; i < g_hooks.size(); ++i) {
        HookSlot& h = g_hooks[i];
        if (!(h.fnName == n)) continue;
        HookFn f = pre ? h.pre : h.post;
        if (!f) continue;
        if (!RunHookFn(f, self, fn, parms))
            ms2::Log("hook faulted -- suppressed (check the hook's own code)");
    }
}

void DrainQueue() {
    std::vector<std::function<void()>> take;
    {
        std::lock_guard<std::mutex> lock(g_queueLock);
        if (g_queue.empty()) return;
        take.swap(g_queue);
    }
    for (auto& f : take) {
        if (!RunTaskFn(&f)) ms2::Log("game-thread task faulted -- suppressed");
    }
}

void FireTick(float dt) {
    std::vector<std::function<void(float)>> fns;
    {
        std::lock_guard<std::mutex> lock(g_tickLock);
        if (g_tickFns.empty()) return;
        fns = g_tickFns;
    }
    for (auto& f : fns) {
        if (!RunTickFn(&f, dt)) ms2::Log("tick callback faulted -- suppressed");
    }
}

// Wall-clock pacing for the per-frame callbacks when the engine-tick hook could
// not be installed.  Rate-limited so a busy frame does not fire them per call.
std::atomic<uint64> g_lastFallbackTickMs{0};

void FallbackTick() {
    const uint64_t now = GetTickCount64();
    uint64_t last = g_lastFallbackTickMs.load(std::memory_order_relaxed);
    if (now - last < 4) return;
    if (!g_lastFallbackTickMs.compare_exchange_strong(last, now)) return;
    static uint64_t prev = 0;
    const float dt = prev ? (float)(now - prev) / 1000.0f : 0.016f;
    prev = now;
    FireTick(dt);
    NoteSelfTestTick(dt);
}

// The ProcessEvent detour.  Per call: one counter bump, an O(hooks) integer
// compare, the original, and a mutex test for the queue.
void DetourProcessEvent(UObject* self, UFunction* fn, void* parms) {
    ++g_peCount;
    const uint32 tid = GetCurrentThreadId();

    // Which thread is the game thread?  Latch the first thread that is seen
    // calling ProcessEvent TWICE IN A ROW, not merely the first one: the async
    // loading thread calls ProcessEvent too, and latching on a single call from it
    // would send every EnqueueGameThread task to the wrong thread for the rest of
    // the session.  The engine-tick detour, once installed, sets this exactly.
    if (g_gameThreadId.load(std::memory_order_relaxed) == 0) {
        static std::atomic<uint32> lastTid{0};
        if (lastTid.load(std::memory_order_relaxed) == tid)
            g_gameThreadId.store(tid, std::memory_order_relaxed);
        else
            lastTid.store(tid, std::memory_order_relaxed);
    }

    tl_inDetour = 1;
    HistogramNote(fn);
    RunHooksOn(self, fn, parms, true);

    if (g_peTrampoline) {
        if (!CallProcessEventAt((uintptr_t)g_peTrampoline, self, fn, parms))
            ms2::Log("original ProcessEvent faulted -- swallowed");
    }

    RunHooksOn(self, fn, parms, false);

    if (tid == g_gameThreadId.load(std::memory_order_relaxed)) {
        DrainQueue();
        if (!g_tickHooked) FallbackTick();
    }
    tl_inDetour = 0;
}

void DetourEngineTick(void* self, float dt, bool idle) {
    g_gameThreadId.store(GetCurrentThreadId(), std::memory_order_relaxed);
    tl_inDetour = 1;
    if (g_tickTrampoline) {
        if (!CallEngineTickAt((uintptr_t)g_tickTrampoline, self, dt, idle))
            ms2::Log("original UGameEngine::Tick faulted -- swallowed");
    }
    DrainQueue();
    FireTick(dt);
    NoteSelfTestTick(dt);
    tl_inDetour = 0;
}

}  // namespace

namespace {

// One resolver, two entry points: find the UFunction a hook spec names.
UFunction* ResolveHookTarget(const char* spec) {
    if (!spec || !*spec) return nullptr;
    const std::string s(spec);

    // 1. Full object path, e.g. "/Script/Engine.Actor.ReceiveBeginPlay".
    if (s.find('/') != std::string::npos) {
        UObject* o = FindObject(s.c_str());
        if (PlausiblePtr(o) && IsFunctionObject(o)) return (UFunction*)o;
    }

    // 2. "Class.Function" -- resolve the class, then the function on its CDO.
    const size_t dot = s.rfind('.');
    if (dot != std::string::npos) {
        const std::string cls = s.substr(0, dot);
        const std::string leaf = s.substr(dot + 1);
        if (UClass* c = FindClass(cls.c_str())) {
            UObject* cdo = nullptr;
            if (Read((uint8_t*)c + kOffClassDefaultObj, cdo) && PlausiblePtr(cdo)) {
                if (UFunction* f = FindFunction(cdo, leaf.c_str())) return f;
            }
            UFunction* f = FindFunctionLocal((UObject*)c, leaf.c_str());
            if (f) return f;
        }
    }

    // 3. Bare function name -- unique in practice for the ones a mod hooks, and
    //    ambiguity is reported rather than silently picking one.
    UFunction* found = nullptr;
    int matches = 0;
    for (int32_t i = 0; i < g_arr.numElements && matches < 8; ++i) {
        UObject* o = ObjectAt(i);
        if (!o || !IsFunctionObject(o)) continue;
        if (NameToString(NameOf(o)) != s) continue;
        found = (UFunction*)o;
        ++matches;
    }
    if (matches > 1) {
        ms2::Logf("hook: '%s' is ambiguous (%d UFunctions) -- using the first", spec, matches);
    }
    return found;
}

bool RegisterHook(const char* spec, HookFn f, bool pre) {
    if (!f || !spec || !*spec) return false;
    UFunction* fn = ResolveHookTarget(spec);
    if (!fn) {
        ms2::Logf("hook: could not resolve '%s' -- it will NOT fire", spec);
        return false;
    }
    const FName name = NameOf((UObject*)fn);

    std::lock_guard<std::mutex> lock(g_hookLock);
    for (auto& h : g_hooks) {
        if (h.fnName == name) {
            if (pre) h.pre = f; else h.post = f;
            g_hookCount.store((int)g_hooks.size(), std::memory_order_release);
            ms2::Logf("hook: %s hook replaced on %s", pre ? "pre" : "post", spec);
            return true;
        }
    }
    HookSlot slot;
    slot.fnName = name;
    if (pre) slot.pre = f; else slot.post = f;
    strncpy_s(slot.name, sizeof(slot.name), spec, _TRUNCATE);
    g_hooks.push_back(slot);
    g_hookCount.store((int)g_hooks.size(), std::memory_order_release);
    ms2::Logf("hook: %s hook on %s (FName %u:%u)", pre ? "pre" : "post", spec,
              name.ComparisonIndex, name.Number);
    return true;
}

}  // namespace

bool HookPre(const char* spec, HookFn f)  { return RegisterHook(spec, f, true); }
bool HookPost(const char* spec, HookFn f) { return RegisterHook(spec, f, false); }

void EnqueueGameThread(std::function<void()> f) {
    if (!f) return;
    std::lock_guard<std::mutex> lock(g_queueLock);
    if (g_queue.size() > 4096) { ++g_queueDropped; return; }
    g_queue.push_back(std::move(f));
}

void OnTick(std::function<void(float)> f) {
    if (!f) return;
    std::lock_guard<std::mutex> lock(g_tickLock);
    g_tickFns.push_back(std::move(f));
}

bool IsGameThread() {
    const uint32 g = g_gameThreadId.load(std::memory_order_relaxed);
    return g != 0 && GetCurrentThreadId() == g;
}

uint64 ProcessEventCount() { return g_peCount.load(); }
const Resolved& GetResolved() { return g_res; }
bool IsReady() { return g_ready.load(); }
const char* InitReport() { return g_initReport.c_str(); }

namespace {

uint32 VerifyProcessEventIndex(UObject* probe) {
    if (!PlausiblePtr(probe)) return g_res.processEventIndex;
    void** vt = nullptr;
    if (!Read(probe, vt) || !PlausiblePtr(vt)) return g_res.processEventIndex;

    for (uint32 i = 0; i < 0x80; ++i) {
        void* slot = nullptr;
        if (!Read(vt + i, slot)) break;
        if ((uintptr_t)slot == g_res.processEvent) {
            if (i != g_res.processEventIndex) {
                ms2::Logf("ProcessEvent: vtable index is 0x%X, not the 0x%X the SDK reported -- "
                          "using the measured one", i, g_res.processEventIndex);
                g_res.processEventIndex = i;
            }
            return i;
        }
    }
    ms2::Log("ProcessEvent: the resolved address is not in the probe object's vtable -- calls use the "
             "address, but the slot number stays unverified");
    return g_res.processEventIndex;
}

void InitPaths() {
    wchar_t exe[MAX_PATH] = L"";
    GetModuleFileNameW(nullptr, exe, MAX_PATH);
    wchar_t* slash = wcsrchr(exe, L'\\');
    if (slash) *slash = 0;
    wcscpy_s(g_exeDir, MAX_PATH, exe);
    _snwprintf_s(g_iniPath, MAX_PATH, _TRUNCATE, L"%s\\ms2coop-native.ini", g_exeDir);
}

void WriteIniTemplate() {
    if (GetFileAttributesW(g_iniPath) != INVALID_FILE_ATTRIBUTES) return;
    HANDLE h = CreateFileW(g_iniPath, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
    if (h == INVALID_HANDLE_VALUE) return;
    const char* text =
        "; ms2 native module -- optional overrides.\r\n"
        "; README.md explains these.  Values are RVAs (offsets from the exe image\r\n"
        "; base) in hex, measured on game build 5.6.1 CL92086.  Leave them\r\n"
        "; commented out: the AOB scan finds the globals on its own.  Uncomment and\r\n"
        "; correct a value only if the log says UNRESOLVED for it.\r\n"
        ";\r\n"
        "; ProcessEvent=0x1619320\r\n"
        "; AppendString=0x13F8FA0\r\n"
        "; GObjects=0xB03AEF0\r\n"
        "; EngineTick=0x3DA7B30\r\n"
        "; ProcessEventIdx=76\r\n";
    DWORD wrote = 0;
    WriteFile(h, text, (DWORD)strlen(text), &wrote, NULL);
    CloseHandle(h);
}

bool InstallProcessEventHook() {
    if (!g_res.processEvent) return false;
    if (MH_CreateHook((LPVOID)g_res.processEvent, (LPVOID)&DetourProcessEvent,
                      (LPVOID*)&g_peTrampoline) != MH_OK) {
        ms2::Log("MinHook: could not hook ProcessEvent");
        return false;
    }
    if (MH_EnableHook((LPVOID)g_res.processEvent) != MH_OK) {
        MH_RemoveHook((LPVOID)g_res.processEvent);
        g_peTrampoline = nullptr;
        ms2::Log("MinHook: could not ENABLE the ProcessEvent hook");
        return false;
    }
    g_peHooked = true;
    ms2::Logf("ProcessEvent HOOKED at 0x%llX -- hooks, EnqueueGameThread and the self-test hang off it",
              (unsigned long long)g_res.processEvent);
    return true;
}

bool InstallTickHook() {
    if (!g_res.engineTick) return false;
    if (MH_CreateHook((LPVOID)g_res.engineTick, (LPVOID)&DetourEngineTick,
                      (LPVOID*)&g_tickTrampoline) != MH_OK) {
        ms2::Log("MinHook: could not hook UGameEngine::Tick");
        return false;
    }
    if (MH_EnableHook((LPVOID)g_res.engineTick) != MH_OK) {
        MH_RemoveHook((LPVOID)g_res.engineTick);
        g_tickTrampoline = nullptr;
        ms2::Log("MinHook: could not enable the UGameEngine::Tick hook");
        return false;
    }
    g_tickHooked = true;
    ms2::Logf("UGameEngine::Tick HOOKED at 0x%llX -- OnTick runs on the game thread once per frame",
              (unsigned long long)g_res.engineTick);
    return true;
}

}  // namespace

// ---------------------------------------------------------------------------
// Init
// ---------------------------------------------------------------------------
bool Init() {
    if (g_ready.load()) return true;
    std::lock_guard<std::mutex> lock(g_initLock);
    if (g_ready.load()) return true;

    InitPaths();
    ms2::OpenLog(g_exeDir);
    WriteIniTemplate();

    if (MH_Initialize() != MH_OK) {
        // MH_ERROR_ALREADY_INITIALIZED is fine (a second Init call), and so is any
        // other failure: reflection works without hooks, and the log says which.
        ms2::Log("init: MH_Initialize did not return MH_OK -- hooks may be unavailable, "
                 "reflection is unaffected");
    }

    uint8_t* base = (uint8_t*)GetModuleHandleW(nullptr);
    g_res.imageBase = (uintptr_t)base;

    char exeDirNarrow[MAX_PATH];
    for (int i = 0; i < MAX_PATH && g_exeDir[i]; ++i) exeDirNarrow[i] = (char)g_exeDir[i];
    ms2::Logf("init: exe base 0x%llX, dir %s", (unsigned long long)g_res.imageBase, exeDirNarrow);

    if (!FindTextRange(base, &g_textLo, &g_textHi)) {
        ms2::Log("init: could not find .text -- AOB scanning disabled, only RVA fallbacks are possible");
        g_textLo = g_textHi = nullptr;
    } else {
        ms2::Logf("init: .text 0x%llX .. 0x%llX (%.1f MB)",
                  (unsigned long long)(uintptr_t)g_textLo, (unsigned long long)(uintptr_t)g_textHi,
                  (double)(g_textHi - g_textLo) / 1048576.0);
    }

    GlobalSpec specs[] = {
        {"ProcessEvent", kSigProcessEvent, -1, 0x01619320, &g_res.processEvent, &g_res.processEventSource},
        {"AppendString", kSigAppendString, -1, 0x013F8FA0, &g_res.appendString, &g_res.appendStringSource},
        {"EngineTick",   kSigEngineTick,   -1, 0x03DA7B30, &g_res.engineTick,   &g_res.engineTickSource},
        {"GObjects",     kSigGObjects,      3, 0x0B03AEF0, &g_res.objects,      &g_res.objectsSource},
        // GWorld has no recovered signature, so it is RVA-only and validated on
        // every use (GetWorld).  Recorded rather than omitted so the log names it.
        {"GWorld",       nullptr,          -1, 0x0AD4E7F0, &g_res.gworld,       &g_res.gworldSource},
    };
    int resolvedCount = 0;
    for (auto& s : specs) {
        const bool ok = ResolveGlobal(s, g_iniPath);
        ms2::Logf("init: %-13s = 0x%llX  [%s]%s", s.name, (unsigned long long)*s.out, *s.source,
                  ok ? "" : "   <<< FAILED");
        if (ok) ++resolvedCount;
    }

    g_res.processEventIndex = 0x4C;   // Dumper-7's Offsets::ProcessEventIdx for this build
    uint64_t idxOverride = 0;
    if (ReadIniValue(g_iniPath, "ProcessEventIdx", &idxOverride) && idxOverride < 0x1000)
        g_res.processEventIndex = (uint32)idxOverride;

    g_appendString = (AppendStringFn)g_res.appendString;

    if (!g_res.objects) {
        g_initReport = "FAILED: GObjects unresolved";
        ms2::Logf("init: %s", g_initReport.c_str());
        return false;
    }

    bool arrayOk = false;
    // 60 x 250 ms: the module can be mapped before the engine has populated the
    // object array, and an empty array is not a failure -- it is "too early".
    for (int attempt = 0; attempt < 60 && !arrayOk; ++attempt) {
        arrayOk = ValidateArray();
        if (!arrayOk) Sleep(250);
    }
    if (!arrayOk)
        ms2::Log("init: the object array did not validate -- continuing so the log shows why");
    DumpArrayRaw(arrayOk ? "init, validated" : "init, NOT validated");

    if (g_appendString) {
        UObject* probe = ObjectAt(0);
        uint64_t nameWord = 0;
        if (probe) Read((uint8_t*)probe + kOffName, nameWord);
        const FName nm = probe ? NameOf(probe) : FName();
        ms2::Logf("init: FName::AppendString probe -> obj=0x%llX nameWord=%016llX fname=%u:%u \"%s\"",
                  (unsigned long long)(uintptr_t)probe, (unsigned long long)nameWord,
                  nm.ComparisonIndex, nm.Number, probe ? GetName(probe).c_str() : "");
    } else {
        ms2::Log("init: FName::AppendString is unresolved -- names will read as <fname i:n>");
    }

    for (int32_t i = 0; i < g_arr.numElements; ++i) {
        UObject* o = ObjectAt(i);
        if (!o || !PlausiblePtr(ClassOf(o))) continue;
        VerifyProcessEventIndex(o);
        break;
    }

    if (!InstallProcessEventHook())
        ms2::Log("init: ProcessEvent NOT hooked -- HookPre/HookPost and the call count are dead");
    if (!InstallTickHook())
        ms2::Log("init: per-frame callbacks will be paced from ProcessEvent (measured dt)");

    g_ready.store(resolvedCount > 0 && g_arr.numElements > 0);

    char report[512];
    _snprintf_s(report, sizeof(report), _TRUNCATE,
                "objects=%s pe=%s names=%s tick=%s | %d objects, layout %s, hooked=%s",
                g_res.objectsSource, g_res.processEventSource,
                g_res.appendString ? g_res.appendStringSource : "MISSING",
                g_res.engineTick ? g_res.engineTickSource : "MISSING",
                (int)g_arr.numElements, g_arr.layoutB ? "5.6(chunk-at-0)" : "legacy(flat-0)",
                g_peHooked ? "yes" : "NO");
    g_initReport = report;
    ms2::Logf("init: %s -> %s", g_ready.load() ? "READY" : "NOT READY", report);
    return g_ready.load();
}

