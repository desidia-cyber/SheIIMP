// The object array.
//
// 5.6 stores the CHUNK TABLE in word 0 of GObjects -- proven from the engine's
// own accessor, which the GObjects pattern matches (a 64-bit load of [GObjects]
// followed by [chunk]*8).  Pre-5.4 UE put a flat first chunk there instead and
// the table at +0x08.  Which shape this build has is not assumed: it is decided
// by ScoreLayout below and recorded in the log.
// ---------------------------------------------------------------------------
struct ObjArray {
    int32_t maxElements = 0;
    int32_t numElements = 0;
    int32_t maxChunks = 0;
    int32_t numChunks = 0;
    bool    layoutB = true;
};

ObjArray g_arr;

// ---------------------------------------------------------------------------
// The object array GROWS, and ValidateArray() is a one-time snapshot.
//
// Every actor, component and widget created after Init() (the local pawn, the
// summoned puppet, everything that streams in with a map) lands at an internal
// index ABOVE the snapshot's NumElements.  With the stale count:
//   * IsValid() rejects those objects ("index out of range"),
//   * FindObject/FindAllOf never reach them,
// so the whole module would quietly decide nothing exists.  Re-read the four
// counts on a throttle instead.  Growth only, so the chunk count is published
// before the element count: a reader that sees the larger NumElements must already
// see the NumChunks that covers it.
// ---------------------------------------------------------------------------
std::atomic<uint64> g_arrCountsAt{0};    // GetTickCount64 of the last re-read

void RefreshArrayCounts() {
    if (!g_res.objects) return;
    const uint64 now = GetTickCount64();
    const uint64 last = g_arrCountsAt.load(std::memory_order_relaxed);
    if (last != 0 && now - last < 100) return;
    g_arrCountsAt.store(now, std::memory_order_relaxed);

    int32_t maxElements = 0, numElements = 0, maxChunks = 0, numChunks = 0;
    if (!Read((const void*)(g_res.objects + kOffArrMaxElements), maxElements)) return;
    if (!Read((const void*)(g_res.objects + kOffArrNumElements), numElements)) return;
    if (!Read((const void*)(g_res.objects + kOffArrMaxChunks), maxChunks)) return;
    if (!Read((const void*)(g_res.objects + kOffArrNumChunks), numChunks)) return;
    if (numElements < 0 || numElements > 50000000) return;
    if (numChunks < 0 || numChunks > 4096) return;
    if (numElements == g_arr.numElements && numChunks == g_arr.numChunks) return;

    g_arr.maxChunks = maxChunks;
    g_arr.numChunks = numChunks;
    g_arr.maxElements = maxElements;
    g_arr.numElements = numElements;
}

bool ArrayUsable() {
    if (!g_res.objects) return false;
    RefreshArrayCounts();
    return g_arr.numElements > 0;
}

// The base of chunk N.  TWO indirections, not one: GObjects+0 holds the chunk
// TABLE and the item array lives at table[chunk].  Reading GObjects+0 and calling
// that the chunk (the bug this replaces) hands back the table's own first words as
// "objects": every lookup then returns a heap pointer, names decode as garbage and
// the array's index invariant scores 0.  The legacy shape keeps chunk 0 inline at
// +0 and its table at +8, which is why the branches differ.
//
// Split out of ItemAt so a whole-array walk reads the table/chunk pointers once per
// chunk instead of once per object: FindAllOf runs over ~140k objects at 2 Hz, and
// the per-index table read was most of its cost.
void* ChunkBase(int32_t chunk) {
    if (chunk < 0 || chunk >= g_arr.numChunks) return nullptr;
    void* chunkBase = nullptr;
    if (g_arr.layoutB) {
        void** table = nullptr;
        if (!Read((const void*)(g_res.objects + kOffArrChunks), table)) return nullptr;
        if (!PlausiblePtr(table)) return nullptr;
        if (!Read(table + chunk, chunkBase)) return nullptr;
    } else if (chunk == 0) {
        if (!Read((const void*)(g_res.objects + kOffArrChunks), chunkBase)) return nullptr;
    } else {
        void** table = nullptr;
        if (!Read((const void*)(g_res.objects + kOffArrObjectsAlt), table)) return nullptr;
        if (!PlausiblePtr(table)) return nullptr;
        if (!Read(table + chunk, chunkBase)) return nullptr;
    }
    return PlausiblePtr(chunkBase) ? chunkBase : nullptr;
}

void* ItemAt(int32_t index) {
    if (index < 0 || index >= g_arr.numElements) return nullptr;
    const int32_t chunk = index / (int32_t)kElementsPerChunk;
    const int32_t inChunk = index % (int32_t)kElementsPerChunk;
    void* chunkBase = ChunkBase(chunk);
    if (!chunkBase) return nullptr;
    return (uint8_t*)chunkBase + (size_t)inChunk * kSizeObjectItem;
}

UObject* ObjectAt(int32_t index) {
    void* item = ItemAt(index);
    if (!item) return nullptr;
    UObject* obj = nullptr;
    if (!Read(item, obj)) return nullptr;
    return PlausiblePtr(obj) ? obj : nullptr;
}

int32_t ItemFlags(int32_t index) {
    void* item = ItemAt(index);
    if (!item) return 0;
    int32_t f = 0;
    Read((uint8_t*)item + 0x08, f);
    return f;
}

// The array's own invariant: object #i must report internal index i.  True for
// either layout, so a wrong guess is detectable without knowing anything else.
int ScoreLayout(bool layoutB) {
    g_arr.layoutB = layoutB;
    int score = 0, tried = 0;
    for (int32_t i = 0; i < g_arr.numElements && tried < 64; ++i) {
        void* item = ItemAt(i);
        if (!item) continue;
        UObject* obj = nullptr;
        if (!Read(item, obj) || !PlausiblePtr(obj)) continue;
        int32_t idx = -1;
        if (!Read((uint8_t*)obj + kOffInternalIndex, idx)) continue;
        UObject* cls = nullptr;
        if (!Read((uint8_t*)obj + kOffClass, cls) || !PlausiblePtr(cls)) continue;
        ++tried;
        if (idx == i) ++score;
    }
    // A failing score used to be a dead end ("0 of 64" and nothing else).  Print
    // what the first items actually decode to, once, so the next reader knows
    // whether the item pointer, the stride or the index field is the broken one.
    static std::atomic<int> diagLeft{2};
    if (score == 0 && diagLeft.load() > 0 && diagLeft.fetch_sub(1) > 0) {
        ms2::Logf("object array: score-detail (%s): tried=%d score=%d",
                  layoutB ? "chunk-at-0" : "flat-first-chunk", tried, score);
        int shown = 0;
        for (int32_t i = 0; i < g_arr.numElements && shown < 6; ++i) {
            void* item = ItemAt(i);
            if (!item) continue;
            UObject* obj = nullptr;
            if (!Read(item, obj) || !PlausiblePtr(obj)) continue;
            int32_t idx = -1;
            Read((uint8_t*)obj + kOffInternalIndex, idx);
            UObject* cls = nullptr;
            const bool cok = Read((uint8_t*)obj + kOffClass, cls) && PlausiblePtr(cls);
            ms2::Logf("object array:   i=%d item=0x%llX obj=0x%llX idx=%d classOk=%d",
                      (int)i, (unsigned long long)(uintptr_t)item,
                      (unsigned long long)(uintptr_t)obj, (int)idx, cok ? 1 : 0);
            ++shown;
        }
    }
    return tried == 0 ? -1 : score;
}

bool ValidateArray() {
    if (!g_res.objects) return false;

    ObjArray a;
    if (!Read((const void*)(g_res.objects + kOffArrMaxElements), a.maxElements)) return false;
    if (!Read((const void*)(g_res.objects + kOffArrNumElements), a.numElements)) return false;
    if (!Read((const void*)(g_res.objects + kOffArrMaxChunks), a.maxChunks)) return false;
    if (!Read((const void*)(g_res.objects + kOffArrNumChunks), a.numChunks)) return false;

    // This runs up to 60 times while the engine is still creating objects, so the
    // same two lines used to be 300 lines of log.  Log on a 1 s throttle instead
    // (and always on the line that decides the layout).
    static uint64 lastLogMs = 0;
    static int lastScoreB = -2, lastScoreA = -2;
    const uint64 nowMs = GetTickCount64();
    const bool logNow = lastLogMs == 0 || nowMs - lastLogMs > 1000;
    if (logNow) {
        ms2::Logf("object array: MaxElements=%d NumElements=%d MaxChunks=%d NumChunks=%d",
                  (int)a.maxElements, (int)a.numElements, (int)a.maxChunks, (int)a.numChunks);
        lastLogMs = nowMs;
    }

    if (a.numElements <= 0 || a.numElements > 50000000) {
        if (logNow) ms2::Logf("object array: NumElements=%d is not plausible", (int)a.numElements);
        return false;
    }
    if (a.numChunks <= 0 || a.numChunks > 4096 || a.maxElements < a.numElements) {
        if (logNow)
            ms2::Logf("object array: chunk counts inconsistent (MaxChunks=%d NumChunks=%d)",
                      (int)a.maxChunks, (int)a.numChunks);
        return false;
    }
    g_arr = a;

    const int scoreB = ScoreLayout(true);
    const int scoreA = ScoreLayout(false);
    if (scoreB != lastScoreB || scoreA != lastScoreA || scoreB > 0) {
        ms2::Logf("object array: layout check -- chunk-table-at-0 scored %d, flat-first-chunk scored %d (of 64)",
                  scoreB, scoreA);
        lastScoreB = scoreB;
        lastScoreA = scoreA;
    }

    if (scoreB >= scoreA && scoreB > 0) {
        g_arr.layoutB = true;
        g_res.objectArrayLayoutB = true;
        return true;
    }
    if (scoreA > 0) {
        g_arr.layoutB = false;
        g_res.objectArrayLayoutB = false;
        ms2::Log("object array: using the legacy flat-first-chunk layout -- this build is NOT the one "
                 "the offsets were measured on, expect trouble");
        return true;
    }
    g_arr.layoutB = true;
    if (logNow)
        ms2::Log("object array: NEITHER layout validated -- continuing with the 5.6 layout, reads may return nothing");
    return false;
}

// ---------------------------------------------------------------------------
// Raw shape dump -- the diagnostic that says WHY the array did not validate.
//
// The scored check above can only say "0 of 64"; this prints the actual words so
// the next reader does not have to guess whether the chunk table pointer, the
// item stride, the internal index or the class pointer is the broken one.
// ---------------------------------------------------------------------------
void DumpArrayRaw(const char* when) {
    if (!g_res.objects) { ms2::Logf("diag(%s): GObjects is unresolved", when); return; }

    uint64_t w[4] = {0, 0, 0, 0};
    Read((const void*)g_res.objects, w);
    ms2::Logf("diag(%s): GObjects@0x%llX -> %016llX %016llX %016llX %016llX", when,
              (unsigned long long)g_res.objects,
              (unsigned long long)w[0], (unsigned long long)w[1],
              (unsigned long long)w[2], (unsigned long long)w[3]);

    void* table = nullptr;
    Read((const void*)(g_res.objects + kOffArrChunks), table);
    void* chunk0 = nullptr;
    if (PlausiblePtr(table)) Read(table, chunk0);
    ms2::Logf("diag(%s): Objects(chunk table)=0x%llX  chunk[0]=0x%llX  plausible(table)=%d plausible(chunk0)=%d",
              when, (unsigned long long)(uintptr_t)table, (unsigned long long)(uintptr_t)chunk0,
              PlausiblePtr(table) ? 1 : 0, PlausiblePtr(chunk0) ? 1 : 0);
    if (!PlausiblePtr(chunk0)) {
        // Try the legacy shape's table, so one log line settles which is which.
        void* alt = nullptr;
        Read((const void*)(g_res.objects + kOffArrObjectsAlt), alt);
        void* altChunk = nullptr;
        if (PlausiblePtr(alt)) Read(alt, altChunk);
        ms2::Logf("diag(%s): legacy table(+0x08)=0x%llX chunk[0]=0x%llX plausible(table)=%d plausible(chunk)=%d",
                  when, (unsigned long long)(uintptr_t)alt, (unsigned long long)(uintptr_t)altChunk,
                  PlausiblePtr(alt) ? 1 : 0, PlausiblePtr(altChunk) ? 1 : 0);
        return;
    }

    for (int32_t i = 0; i < 4; ++i) {
        // Go through ItemAt so this dump proves the path every caller uses, not a
        // second copy of the arithmetic that could be right while ItemAt is wrong.
        uint8_t* item = (uint8_t*)ItemAt(i);
        if (!item) { ms2::Logf("diag(%s): ItemAt(%d) = null", when, (int)i); continue; }
        UObject* obj = nullptr;
        if (!Read(item, obj)) { ms2::Logf("diag(%s): item[%d] unreadable", when, (int)i); continue; }
        if (!PlausiblePtr(obj)) {
            ms2::Logf("diag(%s): item[%d] @0x%llX obj=0x%llX NOT a plausible pointer",
                      when, (int)i, (unsigned long long)(uintptr_t)item, (unsigned long long)(uintptr_t)obj);
            continue;
        }
        uint32 flags = 0; int32 idx = -1; UClass* cls = nullptr; FName nm{};
        Read((uint8_t*)obj + kOffObjectFlags, flags);
        Read((uint8_t*)obj + kOffInternalIndex, idx);
        Read((uint8_t*)obj + kOffClass, cls);
        Read((uint8_t*)obj + kOffName, nm);
        ms2::Logf("diag(%s): item[%d] @0x%llX obj=0x%llX flags=0x%X internalIndex=%d class=0x%llX name=%u:%u classname=\"%s\"",
                  when, (int)i, (unsigned long long)(uintptr_t)item, (unsigned long long)(uintptr_t)obj,
                  flags, (int)idx, (unsigned long long)(uintptr_t)cls, nm.ComparisonIndex, nm.Number,
                  PlausiblePtr(cls) ? GetName((UObject*)cls).c_str() : "<bad class ptr>");
    }
}

// ---------------------------------------------------------------------------
// FName -> string via FName::AppendString(FString&).
//
// One FString is kept for the process lifetime and its length is reset before
// each call, so the engine appends into an existing allocation.  Nothing is ever
// freed, which is what makes this safe: freeing it would mean calling the game's
// allocator through its vtable, and a FString leaked per call would be worse.
// ---------------------------------------------------------------------------
// FName::AppendString(FString&) is called with a STACK buffer, the way Dumper-7's
// own SDK calls it (Basic.hpp: `wchar_t buffer[1024]; FString TempString(buffer, 0,
// 1024);`).  For any name that fits, the engine appends without allocating -- so
// this neither allocates nor frees game memory, which is exactly what makes it
// safe to call from a log line.  If a name ever does not fit, the engine grows the
// FString off our stack; that pointer is then ADOPTED (see g_nameBuf) and reused
// for every later call, so even that case allocates at most once.
FString        g_nameBuf;
wchar_t        g_nameStack[1024];
bool           g_nameBufSeeded = false;
std::mutex     g_nameBufLock;
typedef void (*AppendStringFn)(const FName* self, FString* out);
AppendStringFn g_appendString = nullptr;

// POD-only: owns the __try, so the CALLER may hold a lock or a std::string.
bool CallAppendString(const FName* self, FString* out) {
    __try {
        g_appendString(self, out);
        return true;
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return false;
    }
}

std::string Narrow(const wchar_t* w, int32_t num) {
    std::string out;
    if (!w || num <= 0) return out;
    out.reserve((size_t)num);
    for (int32_t i = 0; i < num; ++i) {
        const wchar_t c = w[i];
        if (c == 0) break;          // an FString's buffer is NUL-terminated; Num counts it
        out.push_back(c > 0 && c < 128 ? (char)c : '?');
    }
    return out;
}

bool AppendNameToString(const FName& name, std::string& out) {
    if (!g_appendString) return false;
    std::lock_guard<std::mutex> lock(g_nameBufLock);
    if (!g_nameBufSeeded) {
        g_nameBuf.Data = g_nameStack;
        g_nameBuf.Num = 0;
        g_nameBuf.Max = (int32)sizeof(g_nameStack) / (int32)sizeof(wchar_t);
        g_nameStack[0] = 0;
        g_nameBufSeeded = true;
    } else if (g_nameBuf.Data) {
        g_nameBuf.Num = 0;
        g_nameBuf.Data[0] = 0;
    }
    // The engine call itself carries the __try, in a POD-only helper: a __try
    // here would be illegal (this function holds a lock_guard, so it needs
    // unwinding) and the compiler says so with C2712 rather than at runtime.
    if (!CallAppendString(&name, &g_nameBuf)) return false;
    out = Narrow(g_nameBuf.Data, g_nameBuf.Num);
    return true;
}

// FName -> string is IMMUTABLE (the engine's name pool only grows; an index is
// never re-used for different text), and the co-op modules resolve the same few
// thousand names over and over: net::FullName builds a path for every actor it
// looks at, and a single `appear` step was measured resolving 188 664 names for
// 80 647 objects (745 ms of one frame).  Caching the TEXT per thread turns the
// engine AppendString call (~2 us, plus this mutex) into a hash lookup (~0.1 us).
// Per thread, so no lock and no contention; a name pool bound keeps it honest.
static thread_local std::unordered_map<uint64, std::string> tl_nameCache;

std::string NameToString(const FName& name) {
    if (name.ComparisonIndex == 0 && name.Number == 0) return "None";
    const uint64 key = ((uint64)name.ComparisonIndex << 32) | (uint64)name.Number;
    auto hit = tl_nameCache.find(key);
    if (hit != tl_nameCache.end()) return hit->second;

    ++tl_profNames;              // one engine AppendString call: the scan-cost unit
    std::string s;
    if (!AppendNameToString(name, s)) {
        char raw[32];
        _snprintf_s(raw, sizeof(raw), _TRUNCATE, "<fname %u:%u>", name.ComparisonIndex, name.Number);
        return raw;
    }
    if (name.Number > 0) {
        char suffix[16];
        _snprintf_s(suffix, sizeof(suffix), _TRUNCATE, "_%d", (int)name.Number);
        s += suffix;
    }
    if (tl_nameCache.size() > 200000) tl_nameCache.clear();
    tl_nameCache.emplace(key, s);
    return s;
}

// ---------------------------------------------------------------------------
// Object accessors
// ---------------------------------------------------------------------------
UClass* ClassOf(UObject* o) {
    if (!PlausiblePtr(o)) return nullptr;
    UClass* c = nullptr;
    if (!Read((uint8_t*)o + kOffClass, c)) return nullptr;
    return PlausiblePtr(c) ? c : nullptr;
}

FName NameOf(UObject* o) {
    FName n;
    if (!PlausiblePtr(o)) return n;
    if (!Read((uint8_t*)o + kOffName, n)) return FName();
    return n;
}

UObject* OuterOf(UObject* o) {
    if (!PlausiblePtr(o)) return nullptr;
    UObject* p = nullptr;
    if (!Read((uint8_t*)o + kOffOuter, p)) return nullptr;
    return PlausiblePtr(p) ? p : nullptr;
}

UClass* SuperOf(UObject* c) {
    if (!PlausiblePtr(c)) return nullptr;
    UClass* s = nullptr;
    if (!Read((uint8_t*)c + kOffStructSuper, s)) return nullptr;
    return PlausiblePtr(s) ? s : nullptr;
}

namespace {
// Memo for IsChildOf -- see its comment.  Per thread because every engine read in
// this module happens on the game thread; the epoch invalidates it on a map load.
struct ChildRow {
    const void* cls = nullptr;
    const void* base = nullptr;
    bool        result = false;
};
// Linear table, exactly like the original (an open-addressed probe was tried and
// made FindAllOf report ZERO instances of a widget class that plainly existed on
// screen -- the linear form is the one that is known to agree with the game).
// 4096 rows because FindAllOf now asks this once per DISTINCT CLASS when it builds
// a base class's descendant list (thousands of questions, not a handful); the row
// is only appended when there is room, so a full table costs re-walks, never a
// wrong answer.
constexpr int kChildRows = 4096;
thread_local ChildRow  tl_childRows[kChildRows];
thread_local int       tl_childUsed = 0;
thread_local uint32_t  tl_childEpoch = 0;
}  // namespace

bool IsChildOf(UClass* c, UClass* base) {
    if (!PlausiblePtr(c) || !PlausiblePtr(base)) return false;
    // Memoised per thread: the answer is a pure function of two class pointers,
    // and the same few thousand (class, base) pairs are asked over and over.
    const uint32_t epoch = g_lookupEpoch.load(std::memory_order_relaxed);
    if (tl_childEpoch != epoch) {
        tl_childEpoch = epoch;
        tl_childUsed = 0;
    }
    const void* wantCls = (const void*)c;
    const void* wantBase = (const void*)base;
    for (int i = 0; i < tl_childUsed; ++i) {
        if (tl_childRows[i].cls == wantCls && tl_childRows[i].base == wantBase)
            return tl_childRows[i].result;
    }
    bool result = false;
    for (int depth = 0; depth < 256 && PlausiblePtr(c); ++depth) {
        if (c == base) { result = true; break; }
        c = SuperOf((UObject*)c);
    }
    if (tl_childUsed < kChildRows) {
        tl_childRows[tl_childUsed].cls = wantCls;
        tl_childRows[tl_childUsed].base = wantBase;
        tl_childRows[tl_childUsed].result = result;
        ++tl_childUsed;
    }
    return result;
}

// ---------------------------------------------------------------------------
// Cheap "is this object of class X" via the class's FName, discovered once.
// Comparing FNames is two integer compares; comparing strings would resolve a
// name for every object in the array.
// ---------------------------------------------------------------------------
FName     g_fnameClass{};
FName     g_fnameFunction{};
bool      g_classNamesReady = false;
std::mutex g_classNamesLock;

// A FAILED discovery must not be retried on every call: IsClassObject/IsFunctionObject
// are called from per-object loops (FindAllOf, hooks, ResolveHookTarget), so an
// un-throttled retry turns one bad name lookup into an unbounded rescan.  That is
// exactly what happened on the first real launch: the array did not validate, the
// names never resolved, and the module logged 12k lines and never left init.
std::atomic<uint64> g_classNamesRetryAt{0};
std::atomic<int>    g_classNamesFailLogs{0};

bool DiscoverClassFNames() {
    ProfScope _prof("DiscoverClassFNames", nullptr);
    if (g_classNamesReady) return true;
    const uint64 now = GetTickCount64();
    if (now < g_classNamesRetryAt.load(std::memory_order_relaxed)) return false;
    std::lock_guard<std::mutex> lock(g_classNamesLock);
    if (g_classNamesReady) return true;
    g_classNamesRetryAt.store(now + 2000, std::memory_order_relaxed);

    int wanted = 0;
    for (int32_t i = 0; i < g_arr.numElements && wanted < 2 && i < 200000; ++i) {
        ++tl_profObjs;
        UObject* o = ObjectAt(i);
        if (!o) continue;
        UClass* c = ClassOf(o);
        if (!PlausiblePtr(c)) continue;
        const std::string cn = NameToString(NameOf((UObject*)c));
        if (cn == "Class" && g_fnameClass.ComparisonIndex == 0) {
            g_fnameClass = NameOf((UObject*)c);
            ++wanted;
        } else if (cn == "Function" && g_fnameFunction.ComparisonIndex == 0) {
            g_fnameFunction = NameOf((UObject*)c);
            ++wanted;
        }
    }
    g_classNamesReady = (g_fnameClass.ComparisonIndex != 0);
    if (g_classNamesReady) {
        ms2::Logf("init: class FNames discovered -- Class=%u:%u Function=%u:%u",
                  g_fnameClass.ComparisonIndex, g_fnameClass.Number,
                  g_fnameFunction.ComparisonIndex, g_fnameFunction.Number);
    } else if (g_classNamesFailLogs.fetch_add(1, std::memory_order_relaxed) < 3) {
        ms2::Log("init: class FNames NOT discovered (no object resolved a class name) -- "
                 "retrying every 2 s; this is the object-array/name layer, not the caller");
    }
    return g_classNamesReady;
}

bool IsClassObject(UObject* o) {
    if (!g_classNamesReady) DiscoverClassFNames();
    if (g_fnameClass.ComparisonIndex == 0) return false;
    // Walk the CLASS's own inheritance chain looking for the class named "Class".
    // Comparing only ClassOf(o) == "Class" (the old test) silently excluded every
    // blueprint class -- their class is "BlueprintGeneratedClass" /
    // "WidgetBlueprintGeneratedClass" -- which is why FindAllOf("WBP_MainMenu_C")
    // and FindAllOf("BP_PlayerCharacter_C") returned nothing and the module never
    // left the menu phase.  UObject-derived non-classes (UFunction, UStruct, UEnum)
    // still fail here: their class chain is Field -> Object, not Class.
    UClass* c = ClassOf(o);
    for (int depth = 0; depth < 32 && PlausiblePtr(c); ++depth) {
        if (NameOf((UObject*)c) == g_fnameClass) return true;
        c = SuperOf((UObject*)c);
    }
    return false;
}

// The same chain walk, starting at a class pointer: "are this class's instances
// class objects?".  Split out so the index can answer it ONCE per class pointer
// (a few thousand) instead of once per object (140k) while it builds its list of
// the slots that hold a class object.
bool ChainHasClass(UClass* c) {
    if (!g_classNamesReady) DiscoverClassFNames();
    if (g_fnameClass.ComparisonIndex == 0) return false;
    for (int depth = 0; depth < 32 && PlausiblePtr(c); ++depth) {
        if (NameOf((UObject*)c) == g_fnameClass) return true;
        c = SuperOf((UObject*)c);
    }
    return false;
}

bool IsFunctionObject(UObject* o) {
    if (!g_classNamesReady) DiscoverClassFNames();
    if (g_fnameFunction.ComparisonIndex != 0) {
        UClass* c = ClassOf(o);
        return PlausiblePtr(c) && NameOf((UObject*)c) == g_fnameFunction;
    }
    return ClassOf(o) ? NameToString(NameOf((UObject*)ClassOf(o))) == "Function" : false;
}

// ---------------------------------------------------------------------------
// Small result caches so a lookup does not rescan the array every call.
//
// A MISS is only remembered for a moment (kMissRetryMs): Blueprint classes, CDOs
// and the save subsystem appear when a map streams in, well AFTER Init(), so a
// permanently cached "not found" would disable whichever feature asked for it for
// the rest of the session.  A HIT is kept (callers still re-check IsValid).
// ---------------------------------------------------------------------------
constexpr uint64 kMissRetryMs = 2000;

struct LookupRow {
    UObject* obj = nullptr;
    uint64   retryAt = 0;      // non-zero only on a miss: no re-scan before this
};

std::mutex g_lookupLock;
std::unordered_map<std::string, LookupRow> g_classCache;
std::unordered_map<std::string, LookupRow> g_objectCache;
std::atomic<int> g_fastNameMismatch{0};   // one log line about MakeName disagreeing

bool CachedHit(std::unordered_map<std::string, LookupRow>& cache, const std::string& key,
               uint64 now, UObject** out) {
    auto it = cache.find(key);
    if (it == cache.end()) return false;
    if (it->second.obj) {
        *out = it->second.obj;
        return true;
    }
    if (now < it->second.retryAt) {
        *out = nullptr;
        return true;
    }
    return false;                       // a stale miss: let the caller re-scan
}

void CacheStore(std::unordered_map<std::string, LookupRow>& cache, const std::string& key,
                UObject* found, uint64 now) {
    LookupRow& row = cache[key];
    row.obj = found;
    row.retryAt = found ? 0 : now + kMissRetryMs;
}

// ---------------------------------------------------------------------------
// The object index -- why FindAllOf stopped walking 140k slots per call.
//
// Measured on the 2026-10-25 perf run (PROF table in ms2coop-native.log):
// FindAllOf cost 200-300 ms per call and was called 704 times in 150 s; the 2 Hz
// tick contains per-actor loops that call it, so one tick reached 6.3 s with
// 11.2 M slot reads (~80 full walks of the array).  That is the freeze.
//
// Two maps, both keyed by SLOT INDEX and never by raw UObject*, because the array
// recycles slots: a stale entry can therefore only waste a read, never hand back
// an object that is not there any more.  A query re-reads every candidate slot and
// re-checks internal index, class, name and the liveness flags -- the same tests
// IsValid applies -- so the index can drop a live object from a result but cannot
// invent one.
//
//   byClass[class pointer] -> slots, exact class
//   byName [FName key]     -> slots, exact (ComparisonIndex, Number)
//
// Names are compared as integers inside every scan (NameKey below), which is the
// other half of the fix: the old paths resolved an FName to a string for every
// object they looked at, i.e. one engine AppendString call per slot.
// ---------------------------------------------------------------------------
uint64 NameKey(const FName& n) {
    return ((uint64)n.ComparisonIndex << 32) | (uint64)n.Number;
}

struct ObjIndex {
    std::mutex lock;
    int32_t    scanned = 0;                                    // slots already indexed
    std::unordered_map<const void*, std::vector<int32_t>> byClass;
    std::unordered_map<uint64, std::vector<int32_t>>      byName;
    std::vector<const void*>                              classes;    // distinct class ptrs
    std::unordered_map<const void*, std::vector<const void*>> desc;   // base -> descendants
    size_t descClassCount = 0;                                 // desc valid for this class count

    // ---- slot verification (IndexVerifyLocked) ---------------------------
    // The object the index believes sits in each slot.  UE RECYCLES freed
    // GUObjectArray slots, so a new object (a widget, a blueprint class, its CDO)
    // can be created at an index BELOW the high-water mark.  "Scan only the slots
    // added since last time" never looks at those again, and the result is an index
    // that disagrees with the array: measured 2026-10-25, FindClass("WBP_MainMenu_C")
    // returned the class found at slot ~114034 on the first call and the one at
    // ~106089 on the second -- i.e. a same-named class object appeared in a recycled
    // slot -- while FindAllOf("WBP_MainMenu_C") stayed at "no instances" (firstBucket=1,
    // the CDO only) for 200+ s and boot never left Phase::Menu.  A full walk found
    // the widget the whole time.
    std::vector<UObject*> slotObj;      // last object indexed at this slot
    std::vector<const void*> slotCls;   // class recorded for it (bucket membership)
    std::vector<uint64>    slotName;    // name key recorded for it
    std::vector<int32_t>   classSlots;  // slots whose object is a CLASS object
    std::unordered_map<const void*, bool> meta;   // class ptr -> "its instances are classes"
    std::unordered_map<const void*, const void*> parentOf;   // class ptr -> SuperStruct
    uint64   lastVerifyMs = 0;          // throttle for the pointer sweep
};

ObjIndex g_idx;

// Read one slot's item and the object it names.  |wantClass| filters by exact
// class, |wantName| by exact FName.  Returns nullptr for a freed/recycled/dead
// slot, which is what makes a stale index entry harmless.
UObject* SlotObject(const uint8_t* chunkBase, int32_t chunkFirst, int32_t slot,
                    const void* wantClass, const FName* wantName, int32_t* outItemFlags) {
    UObject* o = nullptr;
    if (!Read(chunkBase + (size_t)(slot - chunkFirst) * kSizeObjectItem, o)) return nullptr;
    if (!o || !PlausiblePtr(o)) return nullptr;
    int32_t idx = -1;
    if (!Read((uint8_t*)o + kOffInternalIndex, idx) || idx != slot) return nullptr;
    if (wantClass) {
        UClass* c = nullptr;
        if (!Read((uint8_t*)o + kOffClass, c) || (const void*)c != wantClass) return nullptr;
    }
    if (wantName) {
        FName n;
        if (!Read((uint8_t*)o + kOffName, n) || !(n == *wantName)) return nullptr;
    }
    int32_t itemFlags = 0;
    Read(chunkBase + (size_t)(slot - chunkFirst) * kSizeObjectItem + 0x08, itemFlags);
    if (outItemFlags) *outItemFlags = itemFlags;
    if (itemFlags & (kIOFGarbage | kIOFPendingKill | kIOFBeginDestroyed | kIOFFinishDestroyed))
        return nullptr;
    uint32_t flags = 0;
    if (!Read((uint8_t*)o + kOffObjectFlags, flags)) return nullptr;
    if (flags & (kRFMirroredGarbage | kRFBeginDestroyed | kRFFinishDestroyed)) return nullptr;
    return o;
}

// "Are this class's instances class objects?" -- cached per class pointer, because
// the chain walk behind it is the expensive part of indexing a slot.
bool ClassOfHoldsClasses(const void* c) {
    auto it = g_idx.meta.find(c);
    if (it != g_idx.meta.end()) return it->second;
    const bool v = ChainHasClass((UClass*)c);
    g_idx.meta.emplace(c, v);
    return v;
}

void IndexSlotLocked(const uint8_t* chunkBase, int32_t chunkFirst, int32_t slot) {
    UObject* o = nullptr;
    if (!Read(chunkBase + (size_t)(slot - chunkFirst) * kSizeObjectItem, o)) return;
    if (!o || !PlausiblePtr(o)) return;
    UClass* c = nullptr;
    if (!Read((uint8_t*)o + kOffClass, c) || !PlausiblePtr(c)) return;
    FName n;
    if (!Read((uint8_t*)o + kOffName, n)) return;
    const uint64 key = NameKey(n);
    if ((size_t)slot < g_idx.slotObj.size()) {
        g_idx.slotObj[slot] = o;
        g_idx.slotCls[slot] = (const void*)c;
        g_idx.slotName[slot] = key;
    }
    auto it = g_idx.byClass.find((const void*)c);
    if (it == g_idx.byClass.end()) {
        it = g_idx.byClass.emplace((const void*)c, std::vector<int32_t>()).first;
        g_idx.classes.push_back((const void*)c);
        // Remember the parent pointer: "is this class below that one" is then a walk
        // in memory instead of two engine reads per step.  The descendant list below
        // asks it once per class, thousands of times per query.
        g_idx.parentOf[(const void*)c] = (const void*)SuperOf((UObject*)c);
    }
    it->second.push_back(slot);
    g_idx.byName[key].push_back(slot);
    // Remember where the CLASS objects are.  FindClass's fallback for a name with no
    // learned FName key used to resolve a name for every object in the array (one
    // engine AppendString per slot -- 90-330 ms a call, and a module that asks for a
    // name that never exists paid it again every few seconds).  ~8.5k class objects
    // out of 140k is a 16x smaller scan, and the list costs one cached test per slot.
    if (ClassOfHoldsClasses((const void*)c)) g_idx.classSlots.push_back(slot);
}

// Throw the index away.  Called from ResetLookupCaches (a map unload recycles
// addresses en masse) and when the array shrank or the buckets accumulated too
// many dead slots.
void IndexResetLocked() {
    g_idx.byClass.clear();
    g_idx.byName.clear();
    // Keep the bucket arrays: a rebuild after a map load then does not rehash
    // 140k inserts through a growing table (that rehash was a large share of the
    // one-off ~200 ms rebuild measured at the menu -> world transition).
    if (g_idx.byClass.bucket_count() < 16384) g_idx.byClass.reserve(16384);
    if (g_idx.byName.bucket_count() < 65536) g_idx.byName.reserve(65536);
    g_idx.classes.clear();
    g_idx.classSlots.clear();
    g_idx.meta.clear();
    g_idx.desc.clear();
    g_idx.descClassCount = 0;
    g_idx.slotObj.clear();
    g_idx.slotCls.clear();
    g_idx.slotName.clear();
    g_idx.parentOf.clear();
    g_idx.scanned = 0;
}

// Grow the per-slot record arrays to cover |n| slots.
void SlotRecordsReserve(int32_t n) {
    if ((int32_t)g_idx.slotObj.size() < n) {
        g_idx.slotObj.resize((size_t)n, nullptr);
        g_idx.slotCls.resize((size_t)n, nullptr);
        g_idx.slotName.resize((size_t)n, 0);
    }
}

// Re-index every slot whose object pointer no longer matches what the index has:
// UE recycles freed slots, so this is the ONLY way a new object created below the
// high-water mark (a menu widget, a recreated blueprint class, its CDO) ever enters
// the index.  Skipping it is exactly the bug that kept the module in Phase::Menu.
//
// Cost: the item table is read ONE chunk at a time (~1.5 MB) and then compared with
// plain loads -- 140k pointer compares plus one memcpy per chunk, well under a
// millisecond -- and the sweep is throttled to 10 Hz, so the per-call cost in
// FindAllOf (which runs 40x per tick) is a clock read.
void IndexVerifyLocked() {
    const uint64 now = GetTickCount64();
    if (g_idx.lastVerifyMs != 0 && now - g_idx.lastVerifyMs < 100) return;
    g_idx.lastVerifyMs = now;

    const int32_t total = g_idx.scanned;
    if (total <= 0) return;
    SlotRecordsReserve(total);

    static thread_local std::vector<uint8_t> items;   // game thread only
    uint32_t changed = 0;
    bool sawClass = false;
    for (int32_t chunk = 0; chunk < g_arr.numChunks; ++chunk) {
        const int32_t first = chunk * (int32_t)kElementsPerChunk;
        if (first >= total) break;
        const uint8_t* base = (const uint8_t*)ChunkBase(chunk);
        if (!base) continue;
        int32_t last = first + (int32_t)kElementsPerChunk;
        if (last > total) last = total;
        const size_t bytes = (size_t)(last - first) * kSizeObjectItem;
        items.resize(bytes);
        if (!SafeRead(base, items.data(), bytes)) continue;   // chunk unreadable: skip it
        for (int32_t slot = first; slot < last; ++slot) {
            UObject* cur = nullptr;
            std::memcpy(&cur, items.data() + (size_t)(slot - first) * kSizeObjectItem,
                        sizeof(cur));
            if (cur == g_idx.slotObj[slot]) continue;   // unchanged: the common case
            // Whatever the index recorded for this slot is now stale: forget it (the
            // bucket entries it left behind are dropped by the slotCls/slotName test
            // in every query) and index what is there now.
            g_idx.slotObj[slot] = nullptr;
            g_idx.slotCls[slot] = nullptr;
            g_idx.slotName[slot] = 0;
            if (cur == nullptr || !PlausiblePtr(cur)) continue;   // free list / garbage
            IndexSlotLocked(base, first, slot);
            if (g_idx.slotObj[slot] == nullptr) continue;         // retried next sweep
            ++changed;
            // The slot may now hold a CLASS object where the one whose memory it took
            // used to be.  The class-chain memo is keyed by class pointer, so drop it.
            if (!sawClass && IsClassObject(cur)) sawClass = true;
        }
    }
    if (changed == 0) return;
    if (sawClass) {
        g_idx.desc.clear();
        g_idx.descClassCount = 0;
        g_lookupEpoch.fetch_add(1, std::memory_order_relaxed);
    }
    static std::atomic<int> logs{0};
    if (logs.fetch_add(1) < 6)
        ms2::Logf("index: %u slot(s) re-used by new objects (objects=%d scanned=%d%s)",
                  changed, (int)g_arr.numElements, (int)g_idx.scanned,
                  sawClass ? ", a class object re-created" : "");
}

// Extend the index over the slots added since the last call, then verify the slots
// already indexed (IndexVerifyLocked): new objects are NOT only appended above the
// high-water mark, they are also dropped into recycled slots below it.
void IndexSyncLocked() {
    ProfScope _prof("indexSync", nullptr);
    const int32_t total = g_arr.numElements;
    if (total <= 0) return;
    if (g_idx.scanned > total) IndexResetLocked();   // the array shrank (map unload)
    SlotRecordsReserve(total);
    int32_t i = g_idx.scanned;
    while (i < total) {
        const int32_t chunk = i / (int32_t)kElementsPerChunk;
        const int32_t first = chunk * (int32_t)kElementsPerChunk;
        int32_t last = first + (int32_t)kElementsPerChunk;
        if (last > total) last = total;
        const uint8_t* base = (const uint8_t*)ChunkBase(chunk);
        if (!base) break;         // chunk not published yet: retry, do not mark it scanned
        for (int32_t slot = i; slot < last; ++slot) IndexSlotLocked(base, first, slot);
        i = last;
    }
    g_idx.scanned = i;
    IndexVerifyLocked();
}

// "Is |c| below |base|", answered from the index's own parent map: no engine reads,
// no IsChildOf memo.  This matters a lot more than it looks -- IsChildOf's memo is a
// 4096-row LINEAR table, and it is full after the first few thousand questions, so
// every miss costs a 4096-entry scan.  Asking it once per class per query (thousands
// of times) made a FindAllOf that touched 5 slots take 60-100 ms; PROF showed
// `FindAllOf max 343.7 ms x267` with `objs=5`.
bool IsChildOfFast(const void* c, const void* base) {
    for (int depth = 0; depth < 64 && c; ++depth) {
        if (c == base) return true;
        auto it = g_idx.parentOf.find(c);
        if (it == g_idx.parentOf.end()) return false;
        c = it->second;
    }
    return false;
}

// The classes whose instances a query for |base| must visit: |base| plus every
// indexed class below it.  Cached per base class and invalidated when the set of
// classes changes (which is what a map load looks like from here).
const std::vector<const void*>& DescendantsOfLocked(const void* base) {
    ProfScope _prof("descendants", nullptr);
    // A class whose instances are all gone (a blueprint class destroyed by a map
    // unload) leaves a dangling pointer in |classes|: its bucket was emptied by the
    // exact compaction in each query, so drop the class here and let a later instance
    // re-register it.  Without this, |classes| only ever grows.
    for (size_t i = 0; i < g_idx.classes.size();) {
        auto b = g_idx.byClass.find(g_idx.classes[i]);
        if (b == g_idx.byClass.end() || b->second.empty()) {
            if (b != g_idx.byClass.end()) g_idx.byClass.erase(b);
            g_idx.classes[i] = g_idx.classes.back();
            g_idx.classes.pop_back();
            if (g_idx.descClassCount != g_idx.classes.size()) {
                g_idx.desc.clear();
                g_idx.descClassCount = g_idx.classes.size();
            }
        } else {
            ++i;
        }
    }
    if (g_idx.descClassCount != g_idx.classes.size()) {
        g_idx.desc.clear();
        g_idx.descClassCount = g_idx.classes.size();
    }
    auto it = g_idx.desc.find(base);
    if (it != g_idx.desc.end()) return it->second;
    std::vector<const void*> v;
    for (const void* cc : g_idx.classes) {
        if (cc == base || IsChildOfFast(cc, base)) v.push_back(cc);
    }
    return g_idx.desc.emplace(base, std::move(v)).first->second;
}

// ARRAY ORDER, not insertion order.  The walk these replace returns the object at
// the LOWEST internal index, and a bucket does not guarantee that a later entry has
// a higher slot (a recycled slot is appended after slots above it).  Callers pick
// "the first" hit -- World(), Pawn(), the menu widget -- so every query sorts.
//
// A bucket entry is dropped EXACTLY, using the per-slot record the index keeps: it
// is stale iff the slot no longer records the class (or name) the bucket was built
// for.  That is an array compare, so compaction costs no engine reads and can never
// drop a live entry -- dropping on "the object failed a liveness test" is what a
// previous version did, and a slot whose object was momentarily unreadable then
// vanished from the index forever (its cached pointer still matched, so the verify
// sweep never re-added it).
void LiveSlotsForClassLocked(std::vector<int32_t>& bucket, const void* cls) {
    size_t w = 0;
    for (size_t i = 0; i < bucket.size(); ++i) {
        const int32_t slot = bucket[i];
        if ((size_t)slot >= g_idx.slotCls.size() || g_idx.slotCls[slot] != cls) continue;
        bucket[w++] = slot;
    }
    bucket.resize(w);
}

void LiveSlotsForNameLocked(std::vector<int32_t>& bucket, uint64 key) {
    size_t w = 0;
    for (size_t i = 0; i < bucket.size(); ++i) {
        const int32_t slot = bucket[i];
        if ((size_t)slot >= g_idx.slotName.size() || g_idx.slotName[slot] != key) continue;
        bucket[w++] = slot;
    }
    bucket.resize(w);
}

// The first live object whose FName is |name| and, when |wantPath| is given, whose
// object path equals it.  A path compare is only attempted for a candidate whose
// immediate outer already names the path's second-to-last segment, so a name with
// thousands of instances does not build thousands of paths.
UObject* FindByNameLocked(const FName& name, const char* wantPath, const std::string& wantOuter) {
    const uint64 key = NameKey(name);
    auto it = g_idx.byName.find(key);
    if (it == g_idx.byName.end()) return nullptr;
    std::vector<int32_t>& bucket = it->second;
    LiveSlotsForNameLocked(bucket, key);
    std::sort(bucket.begin(), bucket.end());   // lowest internal index first
    int32_t curChunk = -1;
    int32_t chunkFirst = 0;
    const uint8_t* chunkBase = nullptr;
    for (size_t k = 0; k < bucket.size(); ++k) {
        const int32_t slot = bucket[k];
        const int32_t chunk = slot / (int32_t)kElementsPerChunk;
        if (chunk != curChunk) {
            curChunk = chunk;
            chunkFirst = chunk * (int32_t)kElementsPerChunk;
            chunkBase = (const uint8_t*)ChunkBase(chunk);
        }
        ++tl_profObjs;
        UObject* o = chunkBase ? SlotObject(chunkBase, chunkFirst, slot, nullptr, &name, nullptr)
                               : nullptr;
        if (!o) continue;                       // freed/recycled: skipped, not dropped
        bool match = true;
        if (wantPath) {
            match = false;
            UObject* outer = OuterOf(o);
            if (!wantOuter.empty() && outer && NameToString(NameOf(outer)) == wantOuter)
                match = (ObjectPath(o) == wantPath);
        }
        if (!match) continue;
        return o;
    }
    return nullptr;
}

// First live class object whose FName is |name| and whose class chain reaches
// "Class".  Verified against the real string, so a bad Conv_StringToName index can
// never hand a caller an unrelated class.  Lowest slot wins, like the walk.
UClass* FindClassByFNameLocked(const FName& name, const char* want) {
    const uint64 key = NameKey(name);
    auto it = g_idx.byName.find(key);
    if (it == g_idx.byName.end()) return nullptr;
    std::vector<int32_t>& bucket = it->second;
    LiveSlotsForNameLocked(bucket, key);
    std::sort(bucket.begin(), bucket.end());
    int32_t curChunk = -1;
    int32_t chunkFirst = 0;
    const uint8_t* chunkBase = nullptr;
    for (size_t k = 0; k < bucket.size(); ++k) {
        const int32_t slot = bucket[k];
        const int32_t chunk = slot / (int32_t)kElementsPerChunk;
        if (chunk != curChunk) {
            curChunk = chunk;
            chunkFirst = chunk * (int32_t)kElementsPerChunk;
            chunkBase = (const uint8_t*)ChunkBase(chunk);
        }
        ++tl_profObjs;
        UObject* o = chunkBase ? SlotObject(chunkBase, chunkFirst, slot, nullptr, &name, nullptr)
                               : nullptr;
        if (!o) continue;
        if (!IsClassObject(o)) continue;
        if (NameToString(NameOf(o)) != want) continue;
        return (UClass*)o;
    }
    return nullptr;
}

// Every live CLASS object whose name is |want|, in array order, plus the "_C"
// variant of the same question.  This is the fallback for a name with no learned
// FName key, and it walks classSlots (~8.5k) instead of every object in the array
// (~140k) resolving a name for each: the measured cost of the old full scan was
// 90-330 ms per call, and a name the module asks about that does not exist paid it
// again every time the negative cache expired (PROF: FindClass("BPSO_EridrimUnlock
// Manager_C") 329.7 ms x116, 18.8 s of game thread in one two-client run).
UClass* ScanClassSlotsLocked(const std::string& want) {
    std::vector<int32_t> slots = g_idx.classSlots;
    std::sort(slots.begin(), slots.end());
    slots.erase(std::unique(slots.begin(), slots.end()), slots.end());
    int32_t curChunk = -1;
    int32_t chunkFirst = 0;
    const uint8_t* chunkBase = nullptr;
    UClass* suffix = nullptr;
    for (size_t k = 0; k < slots.size(); ++k) {
        const int32_t slot = slots[k];
        const int32_t chunk = slot / (int32_t)kElementsPerChunk;
        if (chunk != curChunk) {
            curChunk = chunk;
            chunkFirst = chunk * (int32_t)kElementsPerChunk;
            chunkBase = (const uint8_t*)ChunkBase(chunk);
        }
        ++tl_profObjs;
        UObject* o = chunkBase ? SlotObject(chunkBase, chunkFirst, slot, nullptr, nullptr,
                                            nullptr)
                               : nullptr;
        if (!o) continue;
        const std::string n = NameToString(NameOf(o));
        if (n == want) return (UClass*)o;                      // exact: lowest slot wins
        if (!suffix && n.size() > 2 && n.compare(n.size() - 2, 2, "_C") == 0 &&
            n.compare(0, n.size() - 2, want) == 0)
            suffix = (UClass*)o;                               // "BP_X" -> "BP_X_C"
    }
    return suffix;
}

// The "every slot" scans, kept as the degradation path for the one case the index
// cannot serve: MakeName is unavailable, so a wanted name has no FName to look up.
// Everything else goes through the index.
UObject* SlowScanObject(const std::string& want, const std::string& leaf, bool fullPath) {
    for (int32_t i = 0; i < g_arr.numElements; ++i) {
        ++tl_profObjs;
        UObject* o = ObjectAt(i);
        if (!o) continue;
        if (NameToString(NameOf(o)) != leaf) continue;
        if (fullPath && ObjectPath(o) != want) continue;
        return o;
    }
    return nullptr;
}

UClass* SlowScanClass(const std::string& want) {
    for (int32_t i = 0; i < g_arr.numElements; ++i) {
        ++tl_profObjs;
        UObject* o = ObjectAt(i);
        if (!o) continue;
        if (!(NameToString(NameOf(o)) == want)) continue;
        if (!IsClassObject(o)) continue;
        return (UClass*)o;
    }
    // Blueprint classes are usually addressed without the "_C" suffix.
    for (int32_t i = 0; i < g_arr.numElements; ++i) {
        ++tl_profObjs;
        UObject* o = ObjectAt(i);
        if (!o) continue;
        if (!IsClassObject(o)) continue;
        const std::string n = NameToString(NameOf(o));
        if (n.size() > 2 && n.compare(n.size() - 2, 2, "_C") == 0 &&
            n.compare(0, n.size() - 2, want) == 0)
            return (UClass*)o;
    }
    return nullptr;
}

// The ORIGINAL FindAllOf walk (every slot, IsChildOf per object).  It is no longer
// on any hot path; it exists so the index can be checked against something that
// cannot be wrong (see the cross-check in FindAllOf).
std::vector<UObject*> SlowScanAllOf(UClass* c) {
    std::vector<UObject*> out;
    if (!PlausiblePtr(c)) return out;
    const int32_t total = g_arr.numElements;
    for (int32_t chunk = 0; chunk < g_arr.numChunks; ++chunk) {
        const uint8_t* base = (const uint8_t*)ChunkBase(chunk);
        if (!base) continue;
        const int32_t first = chunk * (int32_t)kElementsPerChunk;
        if (first >= total) break;
        int32_t last = first + (int32_t)kElementsPerChunk;
        if (last > total) last = total;
        for (int32_t i = first; i < last; ++i) {
            ++tl_profObjs;
            UObject* o = nullptr;
            if (!Read(base + (size_t)(i - first) * kSizeObjectItem, o)) continue;
            if (!o || !PlausiblePtr(o) || o == (UObject*)c) continue;
            if (!IsChildOf(ClassOf(o), c)) continue;
            int32_t idx = -1;
            if (!Read((uint8_t*)o + kOffInternalIndex, idx) || idx != i) continue;
            int32_t itemFlags = 0;
            Read(base + (size_t)(i - first) * kSizeObjectItem + 0x08, itemFlags);
            if (itemFlags & (kIOFGarbage | kIOFPendingKill | kIOFBeginDestroyed | kIOFFinishDestroyed))
                continue;
            uint32_t flags = 0;
            Read((uint8_t*)o + kOffObjectFlags, flags);
            if (flags & (kRFClassDefaultObject | kRFArchetypeObject)) continue;
            if (flags & (kRFMirroredGarbage | kRFBeginDestroyed | kRFFinishDestroyed)) continue;
            out.push_back(o);
        }
    }
    return out;
}

// ---------------------------------------------------------------------------
// Negative lookup cache: back off exponentially, and do not rescan for a name
// already proven absent until the object array GROWS (a new class/CDO can only
// appear together with new objects).  The old 2 s flat TTL made every module that
// asks for a name that never exists -- "DataLayerManager" is one -- rescan the
// whole array every 2 s, for the whole session.
// ---------------------------------------------------------------------------
struct NegRow {
    uint64  retryAt = 0;
    int32_t countAtMiss = 0;
    uint32_t strikes = 0;
};

std::unordered_map<std::string, NegRow> g_classNeg;
std::unordered_map<std::string, NegRow> g_objectNeg;

// ---------------------------------------------------------------------------
// string -> the object-side FName key, LEARNED.
//
// Conv_StringToName does not return the FNameEntryId the object array stores for
// the same text: measured on this build, "WBP_MainMenu_C" comes back as 6863537
// from the engine call while every object named WBP_MainMenu_C carries 2449538
// (UE5 keeps a comparison index and a case-preserving/display index, and the two
// calls land on different ones).  Comparing the two as integers therefore never
// matches, which is why the old "fast path" fell through to the string scan on
// every lookup.
//
// So: the first lookup of a name still costs one string scan, and what it LEARNS
// is the object-side key.  Every later lookup is served by the name index.  These
// keys are a property of the build's name pool, not of the level, so they survive
// ResetLookupCaches (a map load) and keep class lookups index-fast after it.
// ---------------------------------------------------------------------------
std::unordered_map<std::string, uint64> g_nameKeyOf;

FName FNameFromKey(uint64 k) {
    FName n;
    n.ComparisonIndex = (uint32)(k >> 32);
    n.Number = (uint32)k;
    return n;
}

void LearnNameKey(const char* text, const FName& actual) {
    if (!text || !*text) return;
    if (actual.ComparisonIndex == 0 && actual.Number == 0) return;
    std::lock_guard<std::mutex> lock(g_lookupLock);
    if (g_nameKeyOf.size() > 1024) g_nameKeyOf.clear();
    g_nameKeyOf[text] = NameKey(actual);
}

uint64 LearnedNameKey(const char* text) {
    if (!text || !*text) return 0;
    std::lock_guard<std::mutex> lock(g_lookupLock);
    auto it = g_nameKeyOf.find(text);
    return it == g_nameKeyOf.end() ? 0 : it->second;
}

constexpr uint32 kNegCapSize = 512;

// True means "do not scan: this name was proven absent and nothing has changed".
//
// |growthBypasses| re-allows the scan as soon as the array grew, which is what a
// class/CDO appearing mid-level looks like.  It is OFF for class misses: while a
// level streams in the array grows on almost every frame, so the bypass defeated the
// backoff entirely and a name that never exists (BPSO_EridrimUnlockManager_C) was
// rescanned to the tune of 18.8 s of game thread in one run.  A class that appears
// later is now found within the backoff (<= 8 s) or immediately on the world change
// that resets the negative cache, and the scan itself only walks class objects.
bool NegBlocked(std::unordered_map<std::string, NegRow>& table, const std::string& key,
                uint64 now, bool growthBypasses = true) {
    auto it = table.find(key);
    if (it == table.end()) return false;
    const NegRow& r = it->second;
    if (now >= r.retryAt) return false;                    // backoff elapsed
    if (growthBypasses && g_arr.numElements > r.countAtMiss) return false;  // array grew
    return true;
}

void NegNote(std::unordered_map<std::string, NegRow>& table, const std::string& key,
             uint64 now) {
    if (table.size() > kNegCapSize) table.clear();
    NegRow& r = table[key];
    ++r.strikes;
    uint64 backoff = 2000ull << (r.strikes > 5 ? 5 : (r.strikes - 1));   // 2,4,8,16,32,64 s
    if (backoff > 8000ull) backoff = 8000ull;                            // cap 8 s
    r.retryAt = now + backoff;
    r.countAtMiss = g_arr.numElements;
}

void NegClear(std::unordered_map<std::string, NegRow>& table, const std::string& key) {
    table.erase(key);
}

}  // namespace

// Called from the co-op module on every world change (net::OnWorldChanged).  A map
// unload destroys the level's objects and blueprint classes, so every cached
// UObject*/UClass* -- and the IsChildOf memo keyed on class pointers -- may now
// name something else (UObject addresses are recycled; IsValid cannot see that).
void ResetLookupCaches() {
    {
        std::lock_guard<std::mutex> lock(g_lookupLock);
        g_classCache.clear();
        g_objectCache.clear();
        // A map unload destroys objects BY THE THOUSAND and recycles their slots, so
        // every negative row is suspect too: drop them and let the index rebuild
        // from slot 0 instead of trusting entries that name the old level.
        g_classNeg.clear();
        g_objectNeg.clear();
    }
    {
        std::lock_guard<std::mutex> lock(g_idx.lock);
        IndexResetLocked();
    }
    g_lookupEpoch.fetch_add(1, std::memory_order_relaxed);
}

bool IsValid(UObject* o) {
    if (!PlausiblePtr(o) || !ArrayUsable()) return false;

    int32_t index = -1;
    if (!Read((uint8_t*)o + kOffInternalIndex, index)) return false;
    if (index < 0 || index >= g_arr.numElements) return false;
    if (ObjectAt(index) != o) return false;

    if (ItemFlags(index) & (kIOFGarbage | kIOFPendingKill | kIOFBeginDestroyed | kIOFFinishDestroyed))
        return false;

    uint32_t flags = 0;
    if (!Read((uint8_t*)o + kOffObjectFlags, flags)) return false;
    if (flags & (kRFMirroredGarbage | kRFBeginDestroyed | kRFFinishDestroyed)) return false;
    return true;
}

UClass*  GetClass(UObject* o) { return ClassOf(o); }
UObject* GetOuter(UObject* o) { return OuterOf(o); }

bool IsA(UObject* o, UClass* c) {
    if (!PlausiblePtr(c)) return false;
    return IsChildOf(ClassOf(o), c);
}

std::string GetName(UObject* o) {
    if (!PlausiblePtr(o)) return "<null>";
    return NameToString(NameOf(o));
}

std::string GetClassName(UObject* o) {
    UClass* c = ClassOf(o);
    if (!PlausiblePtr(c)) return "<no class>";
    return NameToString(NameOf((UObject*)c));
}

// The object's path WITHOUT the class prefix: the outer chain joined by dots,
// then the object's own name ("/Script/Engine.Default__KismetSystemLibrary").
// FindObject's full-path form compares against this; GetFullName prefixes the
// class.  Comparing a full path against GetFullName (the old behaviour) could
// never match, which is why every FindObject("/Script/...") call -- console
// commands, the Kismet CDOs, puppet body assets -- returned nullptr.
std::string ObjectPath(UObject* o) {
    ProfScope _prof("ObjectPath", nullptr);
    if (!PlausiblePtr(o)) return std::string();
    const std::string name = NameToString(NameOf(o));
    std::string path;
    UObject* it = OuterOf(o);
    for (int depth = 0; depth < 64 && PlausiblePtr(it); ++depth) {
        const std::string n = NameToString(NameOf(it));
        path = n + (path.empty() ? "" : ".") + path;
        it = OuterOf(it);
    }
    return path.empty() ? name : path + "." + name;
}

std::string GetFullName(UObject* o) {
    ProfScope _prof("GetFullName", nullptr);
    if (!PlausiblePtr(o)) return "<null>";
    return GetClassName(o) + " " + ObjectPath(o);
}

namespace {

std::string LastSegment(const std::string& s) {
    const size_t dot = s.rfind('.');
    return dot == std::string::npos ? s : s.substr(dot + 1);
}

// The segment just before the last one ("A.B.C" -> "B"): a candidate's immediate
// outer must name it, which is a one-read reject before building a full path.
std::string OuterSegment(const std::string& s) {
    const size_t dot = s.rfind('.');
    if (dot == std::string::npos) return std::string();
    const size_t prev = s.rfind('.', dot - 1);
    return prev == std::string::npos ? s.substr(0, dot) : s.substr(prev + 1, dot - prev - 1);
}

}  // namespace

// FindObject: a bare name or an object path ("/Script/Engine.Default__X").
//
// Used to walk the whole array and resolve an FName to a string per object.  Now:
// the leaf name becomes an FName (one engine call), the index hands back only the
// slots that carry that name, and a path compare runs for the few candidates whose
// outer already matches.
UObject* FindObject(const char* fullPathOrName) {
    ProfScope _prof("FindObject", fullPathOrName);
    if (!ArrayUsable() || !fullPathOrName || !*fullPathOrName) return nullptr;
    const std::string want(fullPathOrName);
    const bool fullPath = want.find('/') != std::string::npos;
    const uint64 now = GetTickCount64();
    if (!fullPath) {
        UObject* cached = nullptr;
        std::lock_guard<std::mutex> lock(g_lookupLock);
        if (CachedHit(g_objectCache, want, now, &cached)) return cached;
        if (NegBlocked(g_objectNeg, want, now)) return nullptr;
    }

    const std::string leaf = LastSegment(want);
    const std::string wantOuter = fullPath ? OuterSegment(want) : std::string();

    UObject* result = nullptr;
    // The leaf's FName only from a LEARNED key (see g_nameKeyOf): Conv_StringToName
    // returns an index the object array does not use, and calling it per lookup is a
    // ProcessEvent plus a name added to the engine's pool for nothing.
    const uint64 learned = LearnedNameKey(leaf.c_str());
    if (learned) {
        std::lock_guard<std::mutex> lock(g_idx.lock);
        IndexSyncLocked();
        result = FindByNameLocked(FNameFromKey(learned), fullPath ? want.c_str() : nullptr,
                                  wantOuter);
    }

    // No FName for the leaf (Conv_StringToName is unavailable) or nothing under it:
    // fall back to the one-slot-at-a-time scan, but only after the negative cache
    // says it is worth doing.  That scan is what used to run on every call.
    if (!result && !fullPath) {
        bool scan = false;
        {
            std::lock_guard<std::mutex> lock(g_lookupLock);
            scan = !NegBlocked(g_objectNeg, want, now);
        }
        if (scan) result = SlowScanObject(want, leaf, fullPath);
        // Learn the object-side FName key (see g_nameKeyOf) BEFORE taking the cache
        // lock: LearnNameKey takes it, and std::mutex is not recursive.
        if (result) LearnNameKey(leaf.c_str(), NameOf(result));
        std::lock_guard<std::mutex> lock(g_lookupLock);
        if (result) {
            CacheStore(g_objectCache, want, result, now);
            NegClear(g_objectNeg, want);
        } else {
            NegNote(g_objectNeg, want, now);
        }
        return result;
    }
    if (!result && fullPath) {
        // A full path is never cached, so the one scan per uncached path is the
        // price of the first lookup; the learn below makes the NEXT one an index
        // query (and a path that does not exist costs one scan, then backs off).
        result = SlowScanObject(want, leaf, fullPath);
        if (result) LearnNameKey(leaf.c_str(), NameOf(result));
    }
    return result;
}

// FindClass: the class object with this name ("BP_PlayerCharacter_C"), or the
// "_C"-suffixed one when a blueprint is addressed without the suffix.
UClass* FindClass(const char* name) {
    ProfScope _prof("FindClass", name);
    if (!ArrayUsable() || !name || !*name) return nullptr;
    const std::string want(name);
    const uint64 now = GetTickCount64();
    {
        UObject* cached = nullptr;
        std::lock_guard<std::mutex> lock(g_lookupLock);
        if (CachedHit(g_classCache, want, now, &cached)) return (UClass*)cached;
        if (NegBlocked(g_classNeg, want, now, false)) return nullptr;
    }

    UClass* result = nullptr;
    // A key learned from an earlier scan of this same name (see g_nameKeyOf) --
    // no engine call, no MakeName, straight to the index.  Deliberately NOT calling
    // Conv_StringToName here any more: its FName index does not match the object's
    // (see the comment on g_nameKeyOf), so it never found anything on its own -- it
    // only added a ProcessEvent per lookup, and Conv_StringToName ADDS the name to
    // the engine's pool, which is a real side effect on the game.
    const uint64 learned = LearnedNameKey(want.c_str());
    if (learned) {
        std::lock_guard<std::mutex> lock(g_idx.lock);
        IndexSyncLocked();
        result = FindClassByFNameLocked(FNameFromKey(learned), want.c_str());
    }
    if (!result) {
        bool scan = false;
        {
            std::lock_guard<std::mutex> lock(g_lookupLock);
            scan = !NegBlocked(g_classNeg, want, now, false);
        }
        if (scan) {
            // Walk only the slots that hold a CLASS object (g_idx.classSlots): the
            // string scan of every object in the array is what made a miss cost
            // 90-330 ms.  SlowScanClass is the last resort for the case where the
            // index has not classified anything yet (index empty, i.e. before the
            // first sync).
            size_t classSlots = 0;
            {
                std::lock_guard<std::mutex> lock(g_idx.lock);
                IndexSyncLocked();
                classSlots = g_idx.classSlots.size();
                if (classSlots != 0) result = ScanClassSlotsLocked(want);
            }
            if (!result && classSlots == 0) result = SlowScanClass(want);
        }
        // Say WHY the index could not answer, without calling Conv_StringToName (it
        // adds a name to the engine's pool for every probe, which the game can see).
        static std::atomic<int> diag{0};
        if (diag.fetch_add(1) < 4) {
            const FName found = result ? NameOf((UObject*)result) : FName();
            ms2::Logf("FindClass(\"%s\"): index miss -- learned key=%d, full scan %s%s "
                      "FName %u:%u (classes indexed=%llu, objects=%d)",
                      want.c_str(), learned ? 1 : 0, result ? "FOUND" : "found nothing",
                      result ? ", its" : "", found.ComparisonIndex, found.Number,
                      (unsigned long long)g_idx.classes.size(), (int)g_arr.numElements);
        }
    }
    // Remember the object-side key for this text: it is what makes the NEXT lookup
    // (and the next one after a map load) an index query instead of a scan.
    if (result) LearnNameKey(want.c_str(), NameOf((UObject*)result));

    {
        std::lock_guard<std::mutex> lock(g_lookupLock);
        CacheStore(g_classCache, want, (UObject*)result, now);
        if (result) {
            NegClear(g_classNeg, want);
        } else {
            NegNote(g_classNeg, want, now);
        }
    }
    return result;
}

// FindAllOf: every live, non-CDO instance of a class, INCLUDING subclasses.
//
// The instance list comes from the index: the class's own bucket plus the buckets
// of every indexed class below it (DescendantsOfLocked caches that set).  Cost is
// now proportional to the number of instances, not to the 140k-object array.
std::vector<UObject*> FindAllOf(const char* className) {
    ProfScope _prof("FindAllOf", className);
    std::vector<UObject*> out;
    if (!ArrayUsable() || !className) return out;
    UClass* c = FindClass(className);
    if (!c) return out;

    size_t bucketSlots = 0;
    size_t descCount = 0;
    {
        std::lock_guard<std::mutex> lock(g_idx.lock);
        IndexSyncLocked();
        const std::vector<const void*>& classes = DescendantsOfLocked((const void*)c);
        descCount = classes.size();
        // Gather the candidate slots from every matching class bucket, then sort
        // them: the result must come back in ARRAY ORDER, exactly like the walk it
        // replaces (callers pick the "first" hit and the module's World()/Pawn()
        // decisions depend on which object that is).
        std::vector<int32_t> slots;
        size_t total = 0;
        for (const void* cc : classes) {
            auto it = g_idx.byClass.find(cc);
            if (it == g_idx.byClass.end()) continue;
            total += it->second.size();
        }
        slots.reserve(total);
        for (const void* cc : classes) {
            auto it = g_idx.byClass.find(cc);
            if (it == g_idx.byClass.end()) continue;
            std::vector<int32_t>& v = it->second;
            // Drop entries the slot records say are no longer this class (exact, no
            // engine reads) so a bucket cannot grow without bound as slots are
            // recycled through it.
            LiveSlotsForClassLocked(v, cc);
            slots.insert(slots.end(), v.begin(), v.end());
        }
        bucketSlots = slots.size();
        std::sort(slots.begin(), slots.end());
        // A recycled slot that came back to the same class can be listed twice;
        // duplicates would make the caller see one widget twice.
        slots.erase(std::unique(slots.begin(), slots.end()), slots.end());
        // Validate in order, skipping slots that are dead or recycled.
        int32_t curChunk = -1;
        int32_t chunkFirst = 0;
        const uint8_t* chunkBase = nullptr;
        for (size_t k = 0; k < slots.size(); ++k) {
            const int32_t slot = slots[k];
            const int32_t chunk = slot / (int32_t)kElementsPerChunk;
            if (chunk != curChunk) {
                curChunk = chunk;
                chunkFirst = chunk * (int32_t)kElementsPerChunk;
                chunkBase = (const uint8_t*)ChunkBase(chunk);
            }
            ++tl_profObjs;
            UObject* o = chunkBase ? SlotObject(chunkBase, chunkFirst, slot, nullptr, nullptr,
                                                nullptr)
                                   : nullptr;
            if (!o) continue;
            if (o == (UObject*)c) continue;
            uint32_t flags = 0;
            if (!Read((uint8_t*)o + kOffObjectFlags, flags)) continue;
            if (flags & (kRFClassDefaultObject | kRFArchetypeObject)) continue;
            out.push_back(o);
        }
    }
    (void)bucketSlots;

    // An empty result is normal (the game creates objects when the level streams
    // in) so this only says it a few times per name, with the numbers that make "not
    // there yet" distinguishable from "the index is broken".  No extra walks: a
    // full-array cross-check here cost 800 ms per poll and starved the game thread
    // during boot.  objects=/scanned= is the pair to compare: scanned < objects means
    // the index has not caught up with the array, and a slot below both means the
    // object exists but was never indexed (what a stale slotObj entry looks like).
    static std::atomic<int> emptyLog{0};
    if (out.empty() && emptyLog.fetch_add(1) < 6) {
        ms2::Logf("FindAllOf(\"%s\"): no instances yet (classes=%llu descendants=%llu "
                  "firstBucket=%llu objects=%d scanned=%d)",
                  className, (unsigned long long)g_idx.classes.size(),
                  (unsigned long long)descCount, (unsigned long long)bucketSlots,
                  (int)g_arr.numElements, (int)g_idx.scanned);
    }
    return out;
}

UObject* FindFirstOf(const char* className) {
    ProfScope _prof("FindFirstOf", className);
    // Through FindAllOf, so "first" means the same thing it did when this walked the
    // array: the lowest slot index that matches.
    std::vector<UObject*> all = FindAllOf(className);
    return all.empty() ? nullptr : all.front();
}


