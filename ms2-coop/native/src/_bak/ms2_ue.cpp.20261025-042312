bool ReadMem(const void* src, void* dst, size_t n) { return SafeRead(src, dst, n); }
bool WriteMem(void* dst, const void* src, size_t n) { return SafeWrite(dst, src, n); }

bool PlausiblePtr(const void* p) {
    const uintptr_t v = reinterpret_cast<uintptr_t>(p);
    return v >= 0x10000 && v < 0x00007FFFFFFFFFFFULL && (v & 7) == 0;
}

// ---------------------------------------------------------------------------
// Instrumentation: where a step's time actually goes.
//
// "the frame took 14 s" says nothing about WHICH loop did it, and every suspicion
// in the hand-off (FindAllOf, lookup misses, GetFullName in a loop) is a different
// fix.  So each instrumented entry point records itself only when it is SLOW
// (>= 30 ms), together with the object-array slots it walked and the name
// resolutions it performed: "FindObject 8300 ms, 140329 slots, 140329 names" is a
// nested scan, not a scan.
//
// Records are throttled per entry (2 s) so a step that is slow 30x/s still leaves
// one line, and ue::ProfDump prints the cumulative table so a report can quote
// before/after numbers instead of an impression.
// ---------------------------------------------------------------------------
namespace {

constexpr uint32 kProfSlowUs     = 30000;   // "slow" starts here (the brief's 30 ms)
constexpr uint32 kProfLogEveryMs = 2000;    // per-entry line throttle
constexpr int    kProfRows       = 48;

struct ProfRow {
    const char* what = nullptr;   // a literal: never freed, so a bare pointer is safe
    uint64      calls = 0;
    uint64      totalUs = 0;
    uint64      maxUs = 0;
    uint32      maxObjs = 0;
    uint32      maxNames = 0;
    uint64      lastLogMs = 0;
    uint64      suppressed = 0;
    char        arg[72] = {0};
};

ProfRow           g_profRows[kProfRows];
int               g_profCount = 0;
std::mutex        g_profLock;
std::atomic<bool> g_profOn{true};

// Per-call counters; only meaningful on the thread running a step (the game
// thread).  Plain thread_local integers: one increment per array slot, which is
// nothing next to the guarded read that follows it.
thread_local uint64 tl_profObjs = 0;
thread_local uint64 tl_profNames = 0;

uint64 ProfFreq() {
    static const uint64 f = [] {
        LARGE_INTEGER v;
        QueryPerformanceFrequency(&v);
        return (uint64)(v.QuadPart ? v.QuadPart : 1);
    }();
    return f;
}

uint64 ProfSlowTicks() {
    static const uint64 t = (ProfFreq() * (uint64)kProfSlowUs) / 1000000ull;
    return t ? t : 1;
}

void ProfRecordImpl(const char* what, const char* arg, uint64 ticks, uint32 objs,
                    uint32 names) {
    if (!what) what = "?";
    if (ticks < ProfSlowTicks()) return;        // not slow: not worth a row
    const uint64 us = (ticks * 1000000ull) / ProfFreq();
    char line[320];
    {
        std::lock_guard<std::mutex> lock(g_profLock);
        ProfRow* row = nullptr;
        for (int i = 0; i < g_profCount; ++i)
            if (g_profRows[i].what == what) { row = &g_profRows[i]; break; }
        if (!row && g_profCount < kProfRows) {
            row = &g_profRows[g_profCount++];
            row->what = what;
        }
        if (!row) return;
        ++row->calls;
        row->totalUs += us;
        if (us > row->maxUs) {
            row->maxUs = us;
            row->maxObjs = objs;
            row->maxNames = names;
            if (arg) {
                size_t n = 0;
                for (; arg[n] && n + 1 < sizeof(row->arg); ++n) row->arg[n] = arg[n];
                row->arg[n] = 0;
            } else {
                row->arg[0] = 0;
            }
        }
        const uint64 nowMs = GetTickCount64();
        if (row->lastLogMs != 0 && nowMs - row->lastLogMs < kProfLogEveryMs) {
            ++row->suppressed;
            return;
        }
        const uint64 suppressed = row->suppressed;
        row->lastLogMs = nowMs;
        row->suppressed = 0;
        _snprintf_s(line, sizeof(line), _TRUNCATE,
                    "PROF slow %s%s%s%s took %.1f ms (objs=%u names=%u; %llu calls so far, "
                    "max %.1f ms, %llu suppressed)",
                    what, row->arg[0] ? "(\"" : "", row->arg[0] ? row->arg : "",
                    row->arg[0] ? "\")" : "", (double)us / 1000.0, objs, names,
                    (unsigned long long)row->calls, (double)row->maxUs / 1000.0,
                    (unsigned long long)suppressed);
    }
    ms2::Log(line);
}

// RAII timer for the lookup entry points.  Costs two QueryPerformanceCounter
// calls; records only when the call was slow, so instrumenting a per-frame caller
// does not punish it.
struct ProfScope {
    const char* what;
    const char* arg;
    uint64 t0;
    uint64 objs0;
    uint64 names0;
    ProfScope(const char* w, const char* a)
        : what(w), arg(a), t0(0), objs0(0), names0(0) {
        if (!g_profOn.load(std::memory_order_relaxed)) { what = nullptr; return; }
        t0 = ProfTicks();
        objs0 = tl_profObjs;
        names0 = tl_profNames;
    }
    ~ProfScope() {
        if (!what) return;
        const uint64 dt = ProfTicks() - t0;
        if (dt < ProfSlowTicks()) return;
        ProfRecordImpl(what, arg, dt, (uint32)(tl_profObjs - objs0),
                       (uint32)(tl_profNames - names0));
    }
};

}  // namespace

uint64 ProfTicks() {
    LARGE_INTEGER v;
    QueryPerformanceCounter(&v);
    return (uint64)v.QuadPart;
}

uint64 ProfSlowThresholdTicks() { return ProfSlowTicks(); }

void ProfRecord(const char* what, const char* arg, uint64 ticks, uint32 objs, uint32 names) {
    if (!g_profOn.load(std::memory_order_relaxed)) return;
    ProfRecordImpl(what, arg, ticks, objs, names);
}

uint32 ProfObjs() { return (uint32)tl_profObjs; }
uint32 ProfNames() { return (uint32)tl_profNames; }
void   ProfCountObject() { ++tl_profObjs; }
void   ProfCountName() { ++tl_profNames; }
bool   ProfEnabled() { return g_profOn.load(std::memory_order_relaxed); }

// The table, worst first.  Called from the 30 s heartbeat, so the log carries a
// profile the reader can quote without a debugger.
void ProfDump(const char* when) {
    if (!g_profOn.load(std::memory_order_relaxed)) return;
    ProfRow copy[kProfRows];
    int n = 0;
    {
        std::lock_guard<std::mutex> lock(g_profLock);
        n = g_profCount;
        for (int i = 0; i < n; ++i) copy[i] = g_profRows[i];
    }
    for (int i = 1; i < n; ++i) {   // insertion sort, worst (maxUs desc) first
        ProfRow v = copy[i];
        int j = i - 1;
        while (j >= 0 && copy[j].maxUs < v.maxUs) { copy[j + 1] = copy[j]; --j; }
        copy[j + 1] = v;
    }
    ms2::Logf("PROF table (%s): %d entries, worst first [max | calls | total]",
              when ? when : "?", n);
    for (int i = 0; i < n && i < 14; ++i) {
        const ProfRow& r = copy[i];
        ms2::Logf("PROF   %-26s max %9.1f ms  x%llu  total %9.1f ms  objs=%u names=%u %s%s%s",
                  r.what, (double)r.maxUs / 1000.0, (unsigned long long)r.calls,
                  (double)r.totalUs / 1000.0, r.maxObjs, r.maxNames,
                  r.arg[0] ? "arg=\"" : "", r.arg[0] ? r.arg : "", r.arg[0] ? "\"" : "");
    }
}

