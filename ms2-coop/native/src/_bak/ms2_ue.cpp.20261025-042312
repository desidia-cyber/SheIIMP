// ---------------------------------------------------------------------------
// Guarded access -- the only __try in this file.  POD-only by necessity.
// ---------------------------------------------------------------------------
bool SafeRead(const void* src, void* dst, size_t n) {
    if (!src || !dst || n == 0) return false;
    __try {
        memcpy(dst, src, n);
        return true;
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return false;
    }
}

bool SafeWrite(void* dst, const void* src, size_t n) {
    if (!dst || !src || n == 0) return false;
    __try {
        memcpy(dst, src, n);
        return true;
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return false;
    }
}

template <class T>
bool Read(const void* p, T& out) { return SafeRead(p, &out, sizeof(T)); }

// Call helpers: also POD-only, so they can own the __try.
typedef void (*ProcessEventFn)(UObject* self, UFunction* fn, void* parms);
typedef void (*EngineTickFn)(void* self, float dt, bool idle);

bool CallProcessEventAt(uintptr_t addr, UObject* self, UFunction* fn, void* parms) {
    __try {
        ((ProcessEventFn)addr)(self, fn, parms);
        return true;
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return false;
    }
}

bool CallEngineTickAt(uintptr_t addr, void* self, float dt, bool idle) {
    __try {
        ((EngineTickFn)addr)(self, dt, idle);
        return true;
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return false;
    }
}

bool RunHookFn(HookFn f, UObject* self, UFunction* fn, void* parms) {
    __try {
        f(self, fn, parms);
        return true;
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return false;
    }
}

bool RunTaskFn(std::function<void()>* f) {
    __try {
        (*f)();
        return true;
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return false;
    }
}

bool RunTickFn(std::function<void(float)>* f, float dt) {
    __try {
        (*f)(dt);
        return true;
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return false;
    }
}

