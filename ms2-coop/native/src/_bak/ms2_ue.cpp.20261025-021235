namespace {

std::atomic<int> g_selfTestStage{0};
float            g_selfTestElapsed = 0.0f;

int32_t StructSize(UObject* st) {
    int32_t sz = -1;
    Read((uint8_t*)st + kOffStructSize, sz);
    return sz;
}

void ReportTopFunctions() {
    // Selection sort of the top few, resolving names only for the winners.
    for (int r = 0; r < 6 && r < g_histUsed; ++r) {
        int best = r;
        for (int i = r + 1; i < g_histUsed; ++i)
            if (g_hist[i].count > g_hist[best].count) best = i;
        const HistEntry tmp = g_hist[r];
        g_hist[r] = g_hist[best];
        g_hist[best] = tmp;
        ms2::Logf("  self-test: ProcessEvent #%d  %-46s %u calls", r + 1,
                  NameToString(g_hist[r].name).c_str(), g_hist[r].count);
    }
}

}  // namespace

void NoteSelfTestTick(float dt) {
    const int stage = g_selfTestStage.load(std::memory_order_relaxed);
    if (stage != 1) return;
    g_selfTestElapsed += dt;
    // 10 s of GAME time, not wall clock: it means the game actually ran frames.
    if (g_selfTestElapsed >= 10.0f) {
        g_selfTestStage.store(2);
        SelfTest("+10s of game time");
        g_histOn.store(false);
    }
}

void SelfTest(const char* when) {
    ms2::Logf("---- self-test (%s) ----", when ? when : "manual");

    if (!g_ready.load()) {
        ms2::Logf("  self-test: NOT READY (%s)", g_initReport.c_str());
        return;
    }

    ms2::Logf("  self-test: resolution -> %s", g_initReport.c_str());
    ms2::Logf("  self-test: GUObjectArray at 0x%llX, NumElements=%d NumChunks=%d MaxElements=%d",
              (unsigned long long)g_res.objects, (int)g_arr.numElements, (int)g_arr.numChunks,
              (int)g_arr.maxElements);
    ms2::Logf("  self-test: object count check -- %d objects is %s",
              (int)g_arr.numElements,
              (g_arr.numElements > 1000 && g_arr.numElements < 5000000) ? "plausible" : "SUSPICIOUS");
    DumpArrayRaw("self-test");

    int shown = 0;
    for (int32_t i = 0; i < g_arr.numElements && shown < 5; ++i) {
        UObject* o = ObjectAt(i);
        if (!o || !PlausiblePtr(ClassOf(o))) continue;
        ms2::Logf("  self-test: object[%d] = %s", (int)i, GetFullName(o).c_str());
        ++shown;
    }
    if (shown == 0) ms2::Log("  self-test: FAILED -- no readable objects in the array");

    UClass* actorClass = FindClass("Actor");
    if (actorClass) {
        ms2::Logf("  self-test: FindClass(\"Actor\") OK -> %s, class %s, StructSize=0x%X",
                  GetFullName((UObject*)actorClass).c_str(),
                  GetClassName((UObject*)actorClass).c_str(), StructSize((UObject*)actorClass));
    } else {
        ms2::Log("  self-test: FindClass(\"Actor\") FAILED -- class lookup is broken");
    }

    if (actorClass) {
        UObject* cdo = nullptr;
        Read((uint8_t*)actorClass + kOffClassDefaultObj, cdo);
        if (PlausiblePtr(cdo)) {
            const int32_t root = PropOffset(cdo, "RootComponent");
            const int32_t tick = PropOffset(cdo, "PrimaryActorTick");
            ms2::Logf("  self-test: PropOffset(Actor CDO, \"RootComponent\")    = 0x%X  (SDK 0x1B8) %s",
                      root, root == 0x1B8 ? "MATCH" : "MISMATCH <<<");
            ms2::Logf("  self-test: PropOffset(Actor CDO, \"PrimaryActorTick\") = 0x%X  (SDK 0x28)  %s",
                      tick, tick == 0x28 ? "MATCH" : "MISMATCH <<<");
            if (root != 0x1B8)
                ms2::Logf("  self-test: if BOTH offsets are wrong the ChildProperties walk is broken; "
                          "if only one is, the SDK is stale for this build");
        } else {
            ms2::Log("  self-test: Actor has no readable class-default-object");
        }
    }

    ms2::Logf("  self-test: ProcessEvent hook %s, %llu calls so far, tick hook %s",
              g_peHooked ? "ACTIVE" : "NOT INSTALLED",
              (unsigned long long)g_peCount.load(),
              g_tickHooked ? "ACTIVE" : "not installed");
    ReportTopFunctions();
    ms2::Log("---- end self-test ----");
}

// ---------------------------------------------------------------------------
// Strings: FName -> string, FString -> utf8, FText -> string
// ---------------------------------------------------------------------------
std::string ToString(FName name) { return NameToString(name); }

std::string ToUtf8(const FString& s) {
    if (!s.Data || s.Num <= 0) return std::string();
    int32 n = s.Num;
    if (n > 65536) n = 65536;          // a sane cap: no name or asset path is longer
    std::wstring w((size_t)n, L'\0');
    if (!SafeRead(s.Data, &w[0], (size_t)n * sizeof(wchar_t))) return std::string();
    // The engine always NUL-terminates; trust Num, not a scan.
    while (!w.empty() && w.back() == 0) w.pop_back();
    if (w.empty()) return std::string();
    const int need = WideCharToMultiByte(CP_UTF8, 0, w.c_str(), (int)w.size(), nullptr, 0, nullptr, nullptr);
    if (need <= 0) return std::string();
    std::string out((size_t)need, '\0');
    WideCharToMultiByte(CP_UTF8, 0, w.c_str(), (int)w.size(), &out[0], need, nullptr, nullptr);
    return out;
}

namespace {
// FText is a shared reference (8-byte pointer) plus a flags word: 16 bytes.  It is
// passed BY VALUE in a UFunction's parameter block, and the engine's own thunk does
// the copy-construct -- so all this layer has to do is put the 16 bytes there.
struct FTextBytes {
    uint8_t b[16];
};
constexpr int32 kFTextBytes = 16;

std::atomic<int> g_textConvState{0};    // 0 = untried, 1 = works, 2 = unavailable
}  // namespace

std::string TextToString(void* ftext) {
    if (!ftext) return std::string();
    if (g_textConvState.load(std::memory_order_acquire) == 2) return std::string();

    UClass* lib = FindClass("KismetTextLibrary");
    if (!lib) {
        if (g_textConvState.exchange(2) != 2)
            ms2::Log("TextToString: KismetTextLibrary not found -- FText conversion is unavailable");
        return std::string();
    }
    UObject* cdo = GetCDO(lib);
    if (!cdo) {
        g_textConvState.store(2);
        return std::string();
    }
    UFunction* fn = FindFunction(cdo, "Conv_TextToString");
    if (!fn) {
        if (g_textConvState.exchange(2) != 2)
            ms2::Log("TextToString: KismetTextLibrary.Conv_TextToString not found");
        return std::string();
    }
    if (PropOffsetStruct((UStruct*)fn, "InText") < 0) {
        if (g_textConvState.exchange(2) != 2)
            ms2::Log("TextToString: Conv_TextToString has no InText parameter");
        return std::string();
    }

    FTextBytes box;
    memset(&box, 0, sizeof(box));
    if (!SafeRead(ftext, box.b, sizeof(box.b))) return std::string();

    Params p(fn);
    if (!p.data()) return std::string();
    p.Set<FTextBytes>("InText", box);
    if (!Call(cdo, fn, p.data())) {
        g_textConvState.store(2);
        return std::string();
    }
    // The returned FString is engine-allocated and is deliberately NOT freed
    // (there is no verified Free to pair with this build's allocator).
    const FString ret = p.Get<FString>("ReturnValue");
    g_textConvState.store(1);
    return ToUtf8(ret);
}

// ---------------------------------------------------------------------------
// TMap / TSet iteration
//
// UE5.6's TMap<K,V> is a TSet<TPair<K,V>>, which is:
//
//   TSparseArray<TSparseArrayElementOrFreeListLink<TPair<K,V>>>
//     +0x00 TArray<Element> Data        (ptr, ArrayNum, ArrayMax)
//     +0x10 TBitArray       AllocationFlags (TArray<uint32> ptr,num,max; NumBits)
//     +0x28 int32 FirstFreeIndex, +0x2C NumFreeIndices
//   followed by the hash (int32 HashSize, element ids) which this never touches.
//
// One element = the pair, padded to the array's alignment, followed by HashNextId
// (int32) and HashIndex (int32): stride = Align(sizeof(pair)) + 8.  Key and value
// offsets come from the FMapProperty's FScriptMapLayout / KeyProp / ValueProp; for
// the raw form the caller supplies the two sizes.
//
// THE HARD RULE: an element is only ever touched after its slot is proven live
// (allocation-flag bit) or its key is proven to be a real FName/FString, and every
// read goes through SafeRead.  A wrong stride or a stale map therefore yields
// "fewer rows", never a fault.
// ---------------------------------------------------------------------------
namespace {

constexpr uint32 kOffMapPairNum   = 0x08;
constexpr uint32 kOffMapPairMax   = 0x0C;
constexpr uint32 kOffMapFlagsPtr  = 0x10;
constexpr uint32 kOffMapFlagsNum  = 0x18;
constexpr uint32 kOffMapFlagsBits = 0x20;
constexpr uint32 kOffFieldClass   = 0x08;   // FField::ClassPrivate
constexpr uint32 kOffMapLayoutK   = 0x70;   // FScriptMapLayout::KeyOffset   (int32)
constexpr uint32 kOffMapLayoutV   = 0x74;   // FScriptMapLayout::ValueOffset (int32)
constexpr uint32 kOffMapKeyProp   = 0x78;   // FMapProperty::KeyProp
constexpr uint32 kOffMapValProp   = 0x80;   // FMapProperty::ValueProp

int32 AlignUp(int32 v, int32 a) {
    if (a <= 1) return v;
    return ((v + a - 1) / a) * a;
}

// A "plausible address" WITHOUT the 8-byte alignment requirement ue::PlausiblePtr
// imposes.  It is needed here because a TMap element is only 4-byte aligned once
// the stride is not a multiple of 8 (TPair<FName,int32> is 20 bytes), and a
// TArray<uint32> bit-allocation may be 4-aligned too.  Alignment is not evidence of
// anything for these pointers; the bounds and the SEH calls are.
bool MapAddrOk(const void* p) {
    const uintptr_t v = reinterpret_cast<uintptr_t>(p);
    return v >= 0x10000 && v < 0x00007FFFFFFFFFFFULL;
}

struct MapInfo {
    const uint8_t* elem = nullptr;
    int32 num = 0;
    int32 stride = 0;
    int32 keyOff = 0, keySize = 0;
    int32 valueOff = 0, valueSize = 0;
    const uint32* flags = nullptr;
    int32 flagWords = 0;
    int32 numBits = 0;
};

// The FField class name of a property ("MapProperty", "StructProperty", ...).
// FField::ClassPrivate -> FFieldClass, whose first member is an FName.
std::string FieldClassOf(FProperty* p) {
    if (!PlausiblePtr(p)) return std::string();
    void* cls = nullptr;
    if (!Read((const uint8_t*)p + kOffFieldClass, cls) || !PlausiblePtr(cls)) return std::string();
    FName n;
    if (!Read(cls, n)) return std::string();
    return NameToString(n);
}

// A key is "believable" when it decodes as the type it claims to be.  Used only on
// the fallback path (no usable allocation flags) and when picking a stride.
bool KeyLooksValid(const uint8_t* key, int32 keySize) {
    if (!key) return false;
    if (keySize == 8) {                       // FName
        FName n;
        if (!SafeRead(key, &n, sizeof(n))) return false;
        if (n.ComparisonIndex == 0) return false;
        if (n.ComparisonIndex > 0x08000000u) return false;   // not a plausible name id
        const std::string s = NameToString(n);
        return !s.empty() && s[0] != '<';
    }
    if (keySize == 16) {                      // FString
        FString s;
        if (!SafeRead(key, &s, sizeof(s))) return false;
        if (s.Num < 0 || s.Num > 4096) return false;
        if (s.Max < s.Num) return false;
        if (s.Num > 0 && !PlausiblePtr(s.Data)) return false;
        return true;
    }
    return true;                              // unknown key type: cannot judge
}

bool SlotAllocated(const MapInfo& mi, int32 i) {
    if (mi.flags && mi.numBits == mi.num) {
        const int32 word = i >> 5;
        if (word < 0 || word >= mi.flagWords) return false;
        uint32 w = 0;
        if (!Read(mi.flags + word, w)) return false;
        return (w & (1u << (i & 31))) != 0;
    }
    FName n;
    if (!Read(mi.elem + (size_t)i * mi.stride + mi.keyOff, n)) return false;
    return KeyLooksValid((const uint8_t*)&n, mi.keySize);
}

// Read the sparse-array header.  Returns false (and logs nothing) for anything
// that does not look like a TMap, which is the normal case for a mistyped property.
bool ReadMapInfo(const void* mapAddr, int32 keyOff, int32 keySize, int32 valueOff,
                 int32 valueSize, MapInfo* mi) {
    if (!MapAddrOk(mapAddr) || !mi) return false;
    memset(mi, 0, sizeof(*mi));

    const uint8_t* base = (const uint8_t*)mapAddr;
    int32 num = 0, max = 0;
    if (!Read(base + kOffMapPairNum, num) || !Read(base + kOffMapPairMax, max)) return false;
    if (num < 0 || max < 0 || num > max || max > (1 << 22)) return false;

    const uint8_t* data = nullptr;
    if (!Read(base, data)) return false;
    if (num > 0 && !MapAddrOk(data)) return false;

    // Allocation flags: only trusted when the sparse array's own invariant holds
    // (AllocationFlags.Num() == Data.Num()); otherwise the keys themselves decide.
    const uint32* flags = nullptr;
    int32 flagWords = 0, numBits = 0;
    if (Read(base + kOffMapFlagsPtr, flags) && Read(base + kOffMapFlagsNum, flagWords) &&
        Read(base + kOffMapFlagsBits, numBits)) {
        if (numBits == num && flagWords >= 0 && flagWords == (num + 31) / 32 &&
            flagWords <= (1 << 22) && (flagWords == 0 || MapAddrOk(flags))) {
            mi->flags = flags;
            mi->flagWords = flagWords;
            mi->numBits = numBits;
        }
    }

    mi->elem = data;
    mi->num = num;
    mi->keyOff = keyOff < 0 ? 0 : keyOff;
    mi->keySize = keySize;
    mi->valueOff = valueOff;
    mi->valueSize = valueSize;
    if (mi->keySize <= 0 || mi->keySize > 0x400 || mi->valueSize <= 0 || mi->valueSize > 0x400)
        return false;
    if (mi->valueOff < mi->keyOff) return false;
    if (mi->keyOff + mi->keySize > mi->valueOff) return false;   // overlap: not a pair

    const int32 pairEnd = mi->valueOff + mi->valueSize;
    if (pairEnd > 0x800) return false;

    // Pick the element stride.  Both candidates are the pair padded to 4 or to 8,
    // plus the two int32 the sparse array stores after it; the real one is decided
    // by which of them decodes as real keys.
    const int32 s4 = AlignUp(pairEnd, 4) + 8;
    const int32 s8 = AlignUp(pairEnd, 8) + 8;
    mi->stride = s4;
    if (s8 != s4) {
        MapInfo probe = *mi;
        auto score = [&probe](int32 stride) {
            probe.stride = stride;
            int good = 0, seen = 0;
            for (int32 i = 0; i < probe.num && seen < 8; ++i) {
                if (probe.flags) {   // probe is shallow-copied; SlotAllocated reads it
                    const int32 word = i >> 5;
                    if (word >= probe.flagWords) break;
                    uint32 w = 0;
                    if (!Read(probe.flags + word, w)) break;
                    if (!(w & (1u << (i & 31)))) continue;
                }
                ++seen;
                const uint8_t* key = probe.elem + (size_t)i * stride + probe.keyOff;
                if (KeyLooksValid(key, probe.keySize)) ++good;
            }
            return good;
        };
        const int good4 = score(s4);
        const int good8 = score(s8);
        if (good8 > good4) mi->stride = s8;
    }
    return true;
}

bool IterateMap(MapInfo& mi, const std::function<bool(void*, void*)>& fn) {
    if (!fn || !mi.elem || mi.num <= 0 || mi.stride <= 0) return false;
    for (int32 i = 0; i < mi.num; ++i) {
        if (!SlotAllocated(mi, i)) continue;
        const uint8_t* el = mi.elem + (size_t)i * mi.stride;
        if (!MapAddrOk(el)) break;             // walked off the allocation
        if (!fn((void*)(el + mi.keyOff), (void*)(el + mi.valueOff))) break;
    }
    return true;
}

// Does this property already have the key?  `found` reports the value slot.
bool MapFindKey(UObject* o, const char* prop, const char* key, bool fnameKey, void** valueSlot) {
    if (valueSlot) *valueSlot = nullptr;
    if (!o || !prop || !key) return false;
    UClass* c = GetClass(o);
    FProperty* p = PlausiblePtr(c) ? FindProperty((UStruct*)c, prop) : nullptr;
    if (!PlausiblePtr(p)) return false;

    int32 keyOff = 0, valueOff = 0, keySize = 0, valueSize = 0;
    if (!Read((const uint8_t*)p + kOffMapLayoutK, keyOff)) return false;
    if (!Read((const uint8_t*)p + kOffMapLayoutV, valueOff)) return false;
    FProperty* kp = nullptr;
    FProperty* vp = nullptr;
    if (!Read((const uint8_t*)p + kOffMapKeyProp, kp) || !PlausiblePtr(kp)) return false;
    if (!Read((const uint8_t*)p + kOffMapValProp, vp) || !PlausiblePtr(vp)) return false;
    if (!Read((const uint8_t*)kp + kOffPropElementSize, keySize)) return false;
    if (!Read((const uint8_t*)vp + kOffPropElementSize, valueSize)) return false;

    MapInfo mi;
    if (keyOff < 0 || keyOff > 0x100) keyOff = 0;
    if (valueOff <= keyOff) valueOff = AlignUp(keySize, 8);
    const int32_t mapOff = PropOffset(o, prop);
    if (mapOff < 0) return false;
    if (!ReadMapInfo((const uint8_t*)o + mapOff, keyOff, keySize, valueOff, valueSize, &mi))
        return false;

    bool hit = false;
    IterateMap(mi, [&](void* k, void* v) -> bool {
        if (fnameKey) {
            FName want = MakeName(key);
            FName got;
            if (!want.ComparisonIndex) return false;
            if (!SafeRead(k, &got, sizeof(got))) return false;
            if (got == want) {
                if (valueSlot) *valueSlot = v;
                hit = true;
                return false;
            }
        } else {
            FString got;
            if (!SafeRead(k, &got, sizeof(got))) return true;
            if (ToUtf8(got) == key) {
                if (valueSlot) *valueSlot = v;
                hit = true;
                return false;
            }
        }
        return true;
    });
    return hit;
}

// Two separate rate limiters so a geometry warning cannot silence the "the key is
// not in the map" warning (and the other way round).
std::atomic<int> g_mapGeomWarned{0};
std::atomic<int> g_mapAddWarned{0};

}  // namespace

bool MapForEach(UObject* o, const char* prop, std::function<bool(void* key, void* value)> fn) {
    if (!o || !prop || !fn) return false;

    // Locate the property and decide whether it really is a map.
    FProperty* p = nullptr;
    {
        UClass* c = GetClass(o);
        p = PlausiblePtr(c) ? FindProperty((UStruct*)c, prop) : nullptr;
    }
    if (!PlausiblePtr(p)) return false;

    const std::string cls = FieldClassOf(p);
    if (!cls.empty()) {
        if (cls != "MapProperty") {
            // Every other FProperty subclass is definitely NOT a TMap.  Anything
            // else (an empty or unrecognisable name) falls through to the geometry
            // check below rather than silently disabling the caller's feature.
            static const char* const kNotMap[] = {
                "StructProperty", "ObjectProperty", "WeakObjectProperty", "ClassProperty",
                "InterfaceProperty", "ArrayProperty", "SetProperty", "BoolProperty",
                "IntProperty", "Int8Property", "Int16Property", "Int64Property",
                "UInt16Property", "UInt32Property", "UInt64Property", "FloatProperty",
                "DoubleProperty", "NameProperty", "StrProperty", "TextProperty",
                "ByteProperty", "EnumProperty", "DelegateProperty", "MulticastDelegateProperty",
                "MulticastInlineDelegateProperty", "MulticastSparseDelegateProperty",
                "FieldPathProperty", "SoftObjectProperty", "SoftClassProperty",
                "LazyObjectProperty", "ObjectPtrProperty", "ClassPtrProperty"};
            for (const char* n : kNotMap) {
                if (cls == n) return false;
            }
            if (g_mapGeomWarned.fetch_add(1) < 3) {
                ms2::Logf("MapForEach(\"%s\"): property class is '%s', not MapProperty -- "
                          "trying the KeyProp/ValueProp geometry anyway", prop, cls.c_str());
            }
        }
    } else if (g_mapGeomWarned.fetch_add(1) < 1) {
        ms2::Logf("MapForEach(\"%s\"): the property's FField class did not resolve -- "
                  "falling back to the KeyProp/ValueProp geometry", prop);
    }

    int32 keyOff = 0, valueOff = 0, keySize = 0, valueSize = 0;
    Read((const uint8_t*)p + kOffMapLayoutK, keyOff);
    Read((const uint8_t*)p + kOffMapLayoutV, valueOff);
    FProperty* kp = nullptr;
    FProperty* vp = nullptr;
    if (!Read((const uint8_t*)p + kOffMapKeyProp, kp) || !PlausiblePtr(kp)) return false;
    if (!Read((const uint8_t*)p + kOffMapValProp, vp) || !PlausiblePtr(vp)) return false;
    if (!Read((const uint8_t*)kp + kOffPropElementSize, keySize)) return false;
    if (!Read((const uint8_t*)vp + kOffPropElementSize, valueSize)) return false;

    const int32_t off = PropOffset(o, prop);
    if (off < 0) return false;
    if (keyOff < 0 || keyOff > 0x100) keyOff = 0;
    if (valueOff <= keyOff) valueOff = AlignUp(keySize, 8);

    MapInfo mi;
    if (!ReadMapInfo((const uint8_t*)o + off, keyOff, keySize, valueOff, valueSize, &mi)) return false;
    return IterateMap(mi, fn);
}

bool MapForEachRaw(const void* mapAddr, std::function<bool(void* key, void* value)> fn) {
    // The FName-keyed shape every map reached this way has (FSpartaMapInt/Bool).
    return MapForEachRaw(mapAddr, 8, 4, std::move(fn));
}

bool MapForEachRaw(const void* mapAddr, int32 keySize, int32 valueSize,
                   std::function<bool(void* key, void* value)> fn) {
    if (!fn) return false;
    const int32 keyOff = 0;
    const int32 valueOff = AlignUp(keySize, valueSize >= 8 ? 8 : (valueSize >= 4 ? 4 : 1));
    MapInfo mi;
    if (!ReadMapInfo(mapAddr, keyOff, keySize, valueOff, valueSize, &mi)) return false;
    return IterateMap(mi, fn);
}

bool MapAddNameInt(UObject* o, const char* prop, const char* key, int32 value) {
    void* slot = nullptr;
    if (MapFindKey(o, prop, key, /*fnameKey*/ true, &slot) && slot) {
        return WriteMem(slot, &value, sizeof(value));
    }
    if (g_mapAddWarned.fetch_add(1) < 3) {
        ms2::Logf("MapAddNameInt(%s, \"%s\"): key is not in the map.  Growing a TMap needs the "
                  "game's allocator and a rehash, which this layer cannot do safely -- the write "
                  "is skipped (the value stays at its saved default)", prop ? prop : "?", key ? key : "?");
    }
    return false;
}

bool MapAddStrInt(UObject* o, const char* prop, const char* key, int32 value) {
    void* slot = nullptr;
    if (MapFindKey(o, prop, key, /*fnameKey*/ false, &slot) && slot) {
        return WriteMem(slot, &value, sizeof(value));
    }
    if (g_mapAddWarned.fetch_add(1) < 3) {
        ms2::Logf("MapAddStrInt(%s, \"%s\"): key is not in the map; see MapAddNameInt", prop ? prop : "?",
                  key ? key : "?");
    }
    return false;
}

// ---------------------------------------------------------------------------
// Test-only: run the module's own scanner over a file image.  See ms2_ue_test.h.
//
// This is what makes the AOB patterns checkable without the game: the same
// ParseAob/ScanAob/rel32 arithmetic the DLL uses at run time is pointed at a
// buffer holding the real exe's .text, and the resolved RVA is compared to the
// independently recovered one.
// ---------------------------------------------------------------------------
namespace detail {

namespace {

int CountMatches(const AobPattern& p) {
    if (!g_textLo || !g_textHi || p.len <= 0) return 0;
    int anchor = 0;
    while (anchor < p.len && p.mask[anchor]) ++anchor;
    if (anchor >= p.len) return 0;
    if ((size_t)(g_textHi - g_textLo) <= (size_t)p.len) return 0;

    int n = 0;
    uint8_t* cur = g_textLo;
    uint8_t* end = g_textHi - p.len;
    while (cur <= end) {
        uint8_t* found = (uint8_t*)memchr(cur, p.bytes[anchor], (size_t)(end - cur) + 1);
        if (!found) break;
        uint8_t* start = found - anchor;
        if (start >= g_textLo) {
            int i = 0;
            for (; i < p.len; ++i)
                if (!p.mask[i] && start[i] != p.bytes[i]) break;
            if (i == p.len) ++n;
        }
        cur = found + 1;
    }
    return n;
}

}  // namespace

int RunPatternSelfCheck(const void* imageBase, ScanCheck* out, int max) {
    if (!imageBase || !out || max <= 0) return 0;

    // Save and restore the live module's view of .text: in the test host nothing
    // is initialised, but this must not be able to disturb a real session.
    uint8_t* saveLo = g_textLo;
    uint8_t* saveHi = g_textHi;

    int checked = 0;
    if (FindTextRange((uint8_t*)imageBase, &g_textLo, &g_textHi)) {
        struct Row { const char* name; const char* aob; int disp; };
        const Row rows[] = {
            {"ProcessEvent", kSigProcessEvent, -1},
            {"AppendString", kSigAppendString, -1},
            {"EngineTick",   kSigEngineTick,   -1},
            {"GObjects",     kSigGObjects,      3},
        };
        for (const Row& r : rows) {
            if (checked >= max) break;
            AobPattern p;
            if (!ParseAob(r.aob, p)) continue;
            ScanCheck c;
            c.name = r.name;
            c.matches = CountMatches(p);
            uint8_t* hit = nullptr;
            if (ScanAob(p, &hit)) {
                uintptr_t resolved = (uintptr_t)hit;
                if (r.disp >= 0) {
                    int32_t d = 0;
                    if (SafeRead(hit + r.disp, &d, sizeof(d)))
                        resolved = (uintptr_t)(hit + r.disp + 4 + d);
                }
                c.rva = resolved - (uintptr_t)imageBase;
            }
            out[checked++] = c;
        }
    }

    g_textLo = saveLo;
    g_textHi = saveHi;
    return checked;
}

}  // namespace detail

}  // namespace ue
