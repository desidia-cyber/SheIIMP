namespace uecall {

// UFunction lookup cache: key = "<class name>|<function name>".
struct FuncSlot {
    std::string key;
    ue::UFunction* fn;
};
std::vector<FuncSlot> g_fnCache;

ue::UFunction* Func(ue::UObject* o, const char* name) {
    if (!o || !name) return nullptr;
    const std::string key = ue::GetClassName(o) + "|" + name;
    for (const FuncSlot& s : g_fnCache) {
        if (s.key == key) return s.fn;
    }
    ue::UFunction* fn = ue::FindFunction(o, name);
    FuncSlot slot;
    slot.key = key;
    slot.fn = fn;
    g_fnCache.push_back(slot);   // a null result is cached too: no MISS storms
    return fn;
}

bool HasParam(ue::UFunction* fn, const char* name) {
    if (!fn || !name) return false;
    return ue::FindProperty((ue::UStruct*)fn, name) != nullptr;
}

// The first of `names` that the function actually declares.
const char* PickParam(ue::UFunction* fn, const char* const* names, size_t n) {
    for (size_t i = 0; i < n; ++i) {
        if (HasParam(fn, names[i])) return names[i];
    }
    return nullptr;
}

bool CallVoid(ue::UObject* o, const char* fnName) {
    if (!ue::IsValid(o)) return false;
    ue::UFunction* fn = Func(o, fnName);
    if (!fn) return false;
    ue::Params p(fn);
    return ue::Call(o, fn, p.data());
}

bool CallVec(ue::UObject* o, const char* fnName, ue::FVector* out) {
    if (!ue::IsValid(o) || !out) return false;
    ue::UFunction* fn = Func(o, fnName);
    if (!fn) return false;
    ue::Params p(fn);
    if (!ue::Call(o, fn, p.data())) return false;
    *out = p.Get<ue::FVector>("ReturnValue");
    return true;
}

bool CallRot(ue::UObject* o, const char* fnName, ue::FRotator* out) {
    if (!ue::IsValid(o) || !out) return false;
    ue::UFunction* fn = Func(o, fnName);
    if (!fn) return false;
    ue::Params p(fn);
    if (!ue::Call(o, fn, p.data())) return false;
    *out = p.Get<ue::FRotator>("ReturnValue");
    return true;
}

// Calls o.fn(<one UObject* parameter>) with the parameter named from `names`.
// Never calls the function when no candidate name exists: a null argument in a
// BP function is exactly the kind of input that takes this game down.
bool CallWithObject(ue::UObject* o, const char* fnName, ue::UObject* arg,
                    const char* const* names, size_t n) {
    if (!ue::IsValid(o)) return false;
    ue::UFunction* fn = Func(o, fnName);
    if (!fn) return false;
    const char* pname = PickParam(fn, names, n);
    if (!pname) return false;
    ue::Params p(fn);
    p.Set<ue::UObject*>(pname, arg);
    return ue::Call(o, fn, p.data());
}

// Read a UObject* out of a property, validated.
ue::UObject* PropObj(ue::UObject* o, const char* prop) {
    if (!ue::IsValid(o)) return nullptr;
    ue::UObject* p = nullptr;
    if (!ue::Get<ue::UObject*>(o, prop, p)) return nullptr;
    return ue::IsValid(p) ? p : nullptr;
}

// Read an integer property whose width the reflection knows (enums are 1 byte).
bool PropInt(ue::UObject* o, const char* prop, int64_t* out) {
    if (!ue::IsValid(o) || !out) return false;
    const int32_t sz = ue::PropSize(o, prop);
    if (sz == 1) {
        uint8_t v = 0;
        if (!ue::Get<uint8_t>(o, prop, v)) return false;
        *out = (int64_t)v;
        return true;
    }
    if (sz == 2) {
        int16_t v = 0;
        if (!ue::Get<int16_t>(o, prop, v)) return false;
        *out = (int64_t)v;
        return true;
    }
    if (sz == 4) {
        int32_t v = 0;
        if (!ue::Get<int32_t>(o, prop, v)) return false;
        *out = (int64_t)v;
        return true;
    }
    if (sz == 8) {
        int64_t v = 0;
        if (!ue::Get<int64_t>(o, prop, v)) return false;
        *out = v;
        return true;
    }
    return false;
}

