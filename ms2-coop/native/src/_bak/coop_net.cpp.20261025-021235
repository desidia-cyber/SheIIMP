namespace {

// '"<key>"' -> position just past it.
bool FindKey(const std::string& line, const char* key, size_t* after) {
    if (!key) return false;
    const std::string pat = std::string("\"") + key + "\"";
    const size_t p = line.find(pat);
    if (p == std::string::npos) return false;
    if (after) *after = p + pat.size();
    return true;
}

// skip %s* ':' %s* ; returns the position of the value.
bool SkipToValue(const std::string& line, size_t pos, size_t* value) {
    while (pos < line.size() && (unsigned char)line[pos] <= ' ') ++pos;
    if (pos >= line.size() || line[pos] != ':') return false;
    ++pos;
    while (pos < line.size() && (unsigned char)line[pos] <= ' ') ++pos;
    if (value) *value = pos;
    return true;
}

bool IsNumChar(char c) {
    return (c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E';
}

}  // namespace

bool Section(const std::string& line, const char* key, std::string* out) {
    if (out) out->clear();
    if (!key) return false;
    const std::string pat = std::string("\"") + key + "\":";
    const size_t i = line.find(pat);
    if (i == std::string::npos) return false;
    const size_t start = line.find('[', i);
    if (start == std::string::npos) return false;
    int depth = 0;
    for (size_t j = start; j < line.size(); ++j) {
        const char c = line[j];
        if (c == '[') {
            ++depth;
        } else if (c == ']') {
            --depth;
            if (depth == 0) {
                if (out) *out = line.substr(start, j - start + 1);
                return true;
            }
        }
    }
    return false;
}

bool KvNum(const std::string& line, const char* key, double* out) {
    size_t pos = 0, val = 0;
    if (!FindKey(line, key, &pos) || !SkipToValue(line, pos, &val)) return false;
    size_t end = val;
    while (end < line.size() && IsNumChar(line[end])) ++end;
    if (end == val) return false;                 // `"x":` with no number
    const std::string num = line.substr(val, end - val);
    char* stop = nullptr;
    const double v = strtod(num.c_str(), &stop);
    if (stop == num.c_str()) return false;        // tonumber() -> nil (e.g. a lone "-")
    if (out) *out = v;
    return true;
}

bool KvInt(const std::string& line, const char* key, int64_t* out) {
    double v = 0.0;
    if (!KvNum(line, key, &v)) return false;
    if (out) *out = (int64_t)v;
    return true;
}

bool KvStr(const std::string& line, const char* key, std::string* out) {
    if (out) out->clear();
    size_t pos = 0, val = 0;
    if (!FindKey(line, key, &pos) || !SkipToValue(line, pos, &val)) return false;
    if (val >= line.size() || line[val] != '"') return false;
    const size_t close = line.find('"', val + 1);
    if (close == std::string::npos) return false;
    if (out) *out = line.substr(val + 1, close - val - 1);
    return true;
}

bool KvHas(const std::string& line, const char* key) {
    size_t pos = 0, val = 0;
    return FindKey(line, key, &pos) && SkipToValue(line, pos, &val);
}

