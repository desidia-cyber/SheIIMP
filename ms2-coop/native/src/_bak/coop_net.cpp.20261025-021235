// ---------------------------------------------------------------------------
// Publish -- main.lua:1566-1606 sendOwn
//
// Frozen order (coop_state.h rule 2, docs/NATIVE-PORT.md 2.3):
//   base fields, then npc, pd, nhp, dead, [ws, wb, wq, wd, wl, wc].
// ---------------------------------------------------------------------------

void Publish() {
    LocalState& L = state().local;

    // local::Capture() owns the ONE increment of "sq" per publish (main.lua:1567 /
    // 1583 both bump SEND_SEQ exactly once, whichever branch they take).  It returns
    // false only for the not-ready shape; a ready-but-unusable pawn returns true with
    // the hot fields untouched, and the line below is then byte-identical with an
    // unchanged "sq" -- what the peer observes when the Lua writes nothing.
    const bool ready = local::Capture();

    // main.lua:1567-1571 -- not ready: the peer hides our body, still at 15 Hz.
    if (!ready) {
        const std::string text =
            Fmt("{\"t\":\"p\",\"id\":\"%s\",\"sq\":%lld,\"rdy\":0}\n", L.me.c_str(),
                (long long)L.seq);
        WriteFile("out_" + L.me + ".txt", text);
        return;
    }

    // "wpns" carries the brackets on the wire.  LocalState documents the body
    // without them; accept either form so a module convention slip cannot
    // corrupt the packet (CONTRACT-REQUEST 8).
    std::string wpns = L.wpns;
    if (wpns.empty()) {
        wpns = "[]";
    } else if (!(wpns.front() == '[' && wpns.back() == ']')) {
        wpns = "[" + wpns + "]";
    }

    const bool hasMontage = !L.montage.path.empty();
    const double mpos = hasMontage ? L.montage.pos : 0.0;
    const double mrate = hasMontage ? L.montage.rate : 1.0;
    const int mid = hasMontage ? L.montage.id : 0;

    std::string line;
    line.reserve(4096);
    AppendFmt(&line,
              "{\"t\":\"p\",\"id\":\"%s\",\"sq\":%lld,"
              "\"x\":%.2f,\"y\":%.2f,\"z\":%.2f,"
              "\"vx\":%.1f,\"vy\":%.1f,\"vz\":%.1f,"
              "\"yaw\":%.1f,\"pitch\":%.1f,"
              "\"anim\":\"%s\",\"spd\":%.1f,"
              "\"mseq\":\"%s\",\"mpos\":%.3f,\"mrate\":%.3f,\"mid\":%d,"
              "\"body\":\"%s\",\"apart\":\"%s\",\"wpn\":\"%s\",\"wsock\":\"%s\","
              "\"wpns\":%s,\"lk\":\"%s\"",
              L.me.c_str(), (long long)L.seq, L.pos.X, L.pos.Y, L.pos.Z, L.vel.X, L.vel.Y,
              L.vel.Z, L.rot.Yaw, L.rot.Pitch, L.anim.c_str(), L.speed,
              L.montage.path.c_str(), mpos, mrate, mid, L.body.c_str(), L.apart.c_str(),
              L.wpn.c_str(), L.wsock.c_str(), wpns.c_str(), appear::Mine().c_str());

    // Frozen writer order.  Each writer appends its own `,"key":...` or nothing.
    combat::SerializeNpc(&line);
    combat::SerializePd(&line);
    combat::SerializeNhp(&line);
    combat::SerializeDead(&line);

    // The whole world block disappears when WS_OFF.txt is present
    // (main.lua:1604).
    if (toggles().wsEnabled) {
        world::SerializeWs(&line);
        progress::Serialize(&line);   // wb, then wq, then wd
        world::SerializeLift(&line);
        world::SerializeChest(&line);
    }

    line += "}";
    line += "\n";
    WriteFile("out_" + L.me + ".txt", line);
}

