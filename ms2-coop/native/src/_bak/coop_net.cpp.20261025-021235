ue::UObject* Find(const std::string& path, bool requestLoad) {
    if (path.size() < 4) return nullptr;   // main.lua:280 (#path < 4)

    // Positive cache: a /Game/ path is a full-name compare, and ue::FindObject
    // only caches *bare* names, so without this every look/weapon apply would
    // walk GObjects.  A miss is never cached -- the game may load it later, and
    // that is exactly what the Lua retried for.
    static std::vector<NamedActor> hits;
    for (const NamedActor& n : hits) {
        if (n.tail == path) {
            if (n.obj && ue::IsValid(n.obj)) return n.obj;
            break;                          // died (map unload): fall through
        }
    }

    const char* p = path.c_str();
    ue::UObject* o = ue::FindObject(p);
    if (o && ue::IsValid(o)) {
        NamedActor entry;
        entry.tail = path;
        entry.obj = o;
        hits.push_back(entry);
        return o;
    }

    if (g_missingAssets.Add(path)) Log("asset not loaded yet: %s", p);

    if (requestLoad) {
        if (!toggles().loadOn) return nullptr;      // default: no loader (Lua)
        if (!g_loadUnavailableWarned) {
            g_loadUnavailableWarned = true;
            // CONTRACT-REQUEST 4: puppet::RequestGameLoad(path)
            Log("LOAD_ON.txt is set but the native build has no asset loader; "
                "assets are found only after the game loads them itself");
        }
    }
    return nullptr;
}

// main.lua:673-679: StaticFindObject("/Script/Engine." .. name), cached.
ue::UObject* EngineClass(const char* shortName) {
    if (!shortName || !*shortName) return nullptr;
    static std::vector<NamedActor> cache;
    for (const NamedActor& n : cache) {
        if (n.tail == shortName) return n.obj;
    }
    const std::string full = std::string("/Script/Engine.") + shortName;
    ue::UObject* o = ue::FindObject(full.c_str());
    if (!o) o = (ue::UObject*)ue::FindClass(shortName);
    NamedActor entry;
    entry.tail = shortName;
    entry.obj = o;
    cache.push_back(entry);
    return o;
}

// main.lua:176-182 -- ExecuteConsoleCommand(world, text, pc) on the Kismet CDO.
// This is the ONLY way the puppet gets summoned (docs/DESIGN.md); never
// replaced by SpawnActor.
void Console(const std::string& text) {
    ue::UObject* world = World();
    ue::UObject* pc = PC();
    if (!world && !pc) return;

    ue::UObject* ksl = KismetSystemLibrary();
    if (!ksl) {
        Log("console [%s]: KismetSystemLibrary not found", text.c_str());
        return;
    }
    ue::UFunction* fn = uecall::Func(ksl, "ExecuteConsoleCommand");
    if (!fn) {
        Log("console [%s]: ExecuteConsoleCommand not found", text.c_str());
        return;
    }
    static const char* kWorldParams[] = {"WorldContextObject", "WorldContext"};
    const char* wp = uecall::PickParam(fn, kWorldParams, 2);
    if (!wp || !uecall::HasParam(fn, "Command")) {
        Log("console [%s]: ExecuteConsoleCommand parameters unknown", text.c_str());
        return;
    }

    ue::Params params(fn);
    params.Set<ue::UObject*>(wp, world ? world : pc);
    // FString is TArray<TCHAR>: a view over our buffer is enough, the parameter
    // is const ref and the engine copies out of it.
    std::wstring wide = Widen(text);
    if (wide.empty()) wide = L" ";
    ue::FString fstr;
    fstr.Data = &wide[0];
    fstr.Num = (int32_t)wide.size() + 1;
    fstr.Max = (int32_t)wide.size() + 1;
    params.Set<ue::FString>("Command", fstr);
    if (uecall::HasParam(fn, "SpecificPlayer")) params.Set<ue::UObject*>("SpecificPlayer", pc);

    if (!ue::Call(ksl, fn, params.data())) {
        Log("console [%s]: ExecuteConsoleCommand failed", text.c_str());
        return;
    }
    Log("console [%s]", text.c_str());
}

