// ApplyPeer -- main.lua:1936-1983
// ---------------------------------------------------------------------------

void ApplyPeer() {
    PeerState& P = state().peer;
    const std::string file = "peer_" + state().local.peer + ".txt";

    std::string line;
    if (!ReadLine(file, &line)) return;
    if (line.empty()) return;

    // main.lua:1942 -- the peer is in the menu / loading / not in control.
    if (HasRdy0(line)) {
        if (P.present) P.live = false;
        P.ready = false;
        return;
    }

    // main.lua:1947 -- no "x" means the packet is useless: nothing else updates.
    double x = 0.0;
    if (!KvNum(line, "x", &x)) return;

    double num = 0.0;
    if (KvNum(line, "spd", &num)) P.speed = num;   // `peerSpeed = m.spd or peerSpeed`

    std::string str;
    if (KvStr(line, "body", &str) && str.size() > 4) P.body = str;
    if (KvStr(line, "wpn", &str) && str.size() > 4) P.wpn = str;
    if (KvStr(line, "wsock", &str) && !str.empty()) P.wsock = str;
    if (Section(line, "wpns", &str)) P.weapons = str;   // raw, brackets included
    if (KvStr(line, "lk", &str) && str.size() > 3) P.look = str;

    // main.lua:1960 -- damage the peer's world dealt to our body.  Cumulative.
    if (KvNum(line, "pd", &num)) {
        P.pd = num;
        P.hasPd = true;
    }

    // main.lua:1961-1968 -- only a *fresh* sq moves the clock the extrapolation
    // and the montage play head run from (docs/NATIVE-PORT.md 4, item 10).
    int64_t sq = 0;
    const bool sqValid = KvInt(line, "sq", &sq);
    const bool fresh = !P.present || !sqValid || sq != P.sq;
    const double at = (fresh || !P.present) ? Now() : P.at;
    const bool live = P.present ? (P.live || (fresh && sqValid)) : false;

    double y = 0.0, z = 0.0;
    KvNum(line, "y", &y);
    KvNum(line, "z", &z);
    double yaw = 0.0, pitch = 0.0;
    KvNum(line, "yaw", &yaw);
    KvNum(line, "pitch", &pitch);
    double vx = 0.0, vy = 0.0, vz = 0.0;
    KvNum(line, "vx", &vx);
    KvNum(line, "vy", &vy);
    KvNum(line, "vz", &vz);

    P.pos.X = x;
    P.pos.Y = y;
    P.pos.Z = z;
    P.vel.X = vx;
    P.vel.Y = vy;
    P.vel.Z = vz;
    P.rot.Yaw = yaw;
    P.rot.Pitch = pitch;
    if (sqValid) P.sq = sq;
    P.at = at;
    P.live = live;
    P.hasX = true;
    P.present = true;
    P.ready = true;
    P.wallAt = Wall();

    // main.lua:1969-1976 -- a non-empty mseq (>4 chars) sets the montage only on
    // a fresh packet (or when there is none yet); an empty one clears it.
    if (KvStr(line, "mseq", &str) && str.size() > 4) {
        if (fresh || !P.hasMontage) {
            P.montage.path = str;
            P.montage.pos = 0.0;
            P.montage.rate = 1.0;
            P.montage.id = 0;
            if (KvNum(line, "mpos", &num)) P.montage.pos = num;
            if (KvNum(line, "mrate", &num)) P.montage.rate = num;
            int64_t mid = 0;
            if (KvInt(line, "mid", &mid)) P.montage.id = (int)mid;
            P.hasMontage = true;
            // CONTRACT-REQUEST 6: the packet clock the play head runs from is
            // P.at (the Lua's PEER_MONTAGE.at was the same value).
        }
    } else {
        P.hasMontage = false;
        P.montage = MontageSig();
    }

    g_lastPeerFile = file;

    // main.lua:1979-1982.  Frozen dispatch order (coop_state.h rule 3):
    // combat (npc/nhp/dead/pd) -> progress (wb/wq/wd) -> world (ws/wl/wc).
    Step("applyNPCs", Guard::None, [&line]() { combat::OnPeerLine(line); });
    if (toggles().wsEnabled) {
        Step("wpReadPeer", Guard::None, [&line]() { progress::OnPeerLine(line); });
        Step("wsReadPeer", Guard::None, [&line]() { world::OnPeerLine(line); });
    }
}

