// main.lua:76-81:
//   local t = fn:match("([%w_]+_C_%d+)$"); if t then return t end
//   t = fn:match("([^%.%:]+)$");            return t or fn
std::string Tail(ue::UObject* o) {
    const std::string fn = FullName(o);

    // Lua's %w is [A-Za-z0-9]; the pattern is anchored at the end, and the
    // greedy prefix means the smallest start wins.  So: the run of word
    // characters that reaches the end, if it ends with "_C_<digits>".
    size_t start = 0;
    for (size_t i = 0; i < fn.size(); ++i) {
        const char c = fn[i];
        const bool wordChar = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') ||
                              (c >= 'A' && c <= 'Z') || c == '_';
        if (!wordChar) start = i + 1;
    }
    if (start < fn.size()) {
        const std::string run = fn.substr(start);
        const size_t at = run.rfind("_C_");
        if (at != std::string::npos && at > 0 && at + 3 < run.size()) {
            bool digits = true;
            for (size_t i = at + 3; i < run.size(); ++i) {
                if (run[i] < '0' || run[i] > '9') { digits = false; break; }
            }
            if (digits) return run;
        }
    }

    const size_t sep = fn.find_last_of(".:");
    if (sep != std::string::npos && sep + 1 < fn.size()) return fn.substr(sep + 1);
    return fn;
}

// main.lua:697-700: fullname(o):match("(/Game/[^%s]+)")
std::string AssetPath(ue::UObject* o) {
    const std::string fn = FullName(o);
    const size_t p = fn.find("/Game/");
    if (p == std::string::npos) return std::string();
    size_t e = p;
    while (e < fn.size() && (unsigned char)fn[e] > ' ') ++e;
    return fn.substr(p, e - p);
}

