void Tick::Every(double hz, const char* label, Fn fn) {
    if (hz <= 0.0) return;
    Slot s;
    s.hz = hz;
    s.acc = 0.0;
    s.label = label;
    s.fn = std::move(fn);
    slots_.push_back(std::move(s));
}

void Tick::Frame(double dt) {
    if (!(dt > 0.0)) dt = 0.0;                     // NaN-safe
    if (dt > 1.0) dt = 1.0;                        // a load hitch must not replay 30 steps
    for (size_t i = 0; i < slots_.size(); ++i) {
        Slot& s = slots_[i];
        const double interval = 1.0 / s.hz;
        s.acc += dt;
        int steps = 0;
        while (s.acc >= interval && steps < 4) {
            s.acc -= interval;
            ++steps;
            const Fn fn = s.fn;                    // a slot must not invalidate the vector
            net::Step(s.label ? s.label : "tick", Guard::None, [&fn, dt]() { fn(dt); });
        }
        if (s.acc >= interval) s.acc = 0.0;        // drop the backlog (never spiral)
    }
}

void Tick::Reset() {
    for (Slot& s : slots_) s.acc = 0.0;
}

