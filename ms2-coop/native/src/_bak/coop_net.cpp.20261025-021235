// ---------------------------------------------------------------------------
// cmd.txt -- main.lua:2080-2196
//
// A deliberately reduced nearest-enemy picker (CONTRACT-REQUEST 2): nearest
// first, within NPC_RADIUS of this player or of the peer, player characters
// excluded, classes with "Enemy"/"Turret" preferred for npctp.
// ---------------------------------------------------------------------------

namespace {

struct NpcPick {
    ue::UObject* actor = nullptr;
    std::string tail;
    std::string cls;
    double d = 0.0;
};

// Distinct player characters + anything else that must never be treated as an
// enemy (main.lua:1276).
bool IsPlayerCharacter(ue::UObject* a) {
    // ue::UClass is its own forward-declared type in ms2_ue.h, so the cast is
    // explicit; GetFullName only wants the object.
    ue::UClass* cls = ue::GetClass(a);
    if (!cls) return false;
    const std::string cfn = ue::GetFullName((ue::UObject*)cls);
    return Contains(cfn, "BP_PlayerCharacter") || Contains(cfn, "BP_MainMenuCharacter");
}

std::vector<NpcPick> CollectNpcsNear() {
    std::vector<NpcPick> out;
    ue::UObject* pawn = Pawn();
    if (!pawn) return out;
    const Vec3 me = Loc(pawn);
    if (!Valid(pawn)) return out;

    ue::UObject* puppetActor = puppet::Actor();
    double px = 0.0, py = 0.0, pz = 0.0;
    bool hasPeer = false;
    if (state().peer.hasX) {
        px = state().peer.pos.X;
        py = state().peer.pos.Y;
        pz = state().peer.pos.Z;
        hasPeer = true;
    }
    const bool hasPuppet = Valid(puppetActor);

    for (ue::UObject* a : ue::FindAllOf("Character")) {
        if (!a || a == pawn || a == puppetActor) continue;
        if (!ue::IsValid(a)) continue;
        if (IsPlayerCharacter(a)) continue;
        const Vec3 loc = Loc(a);
        const double dx = loc.X - me.X, dy = loc.Y - me.Y, dz = loc.Z - me.Z;
        const double d = std::sqrt(dx * dx + dy * dy + dz * dz);
        double dp = 1.0e30;
        if (hasPeer) {
            const double ex = loc.X - px, ey = loc.Y - py, ez = loc.Z - pz;
            dp = std::sqrt(ex * ex + ey * ey + ez * ez);
        } else if (hasPuppet) {
            const Vec3 pl = Loc(puppetActor);
            const double ex = loc.X - pl.X, ey = loc.Y - pl.Y, ez = loc.Z - pl.Z;
            dp = std::sqrt(ex * ex + ey * ey + ez * ez);
        }
        if (d > kNpcRadius && dp > kNpcRadius) continue;
        NpcPick p;
        p.actor = a;
        p.tail = Tail(a);
        ue::UClass* cls = ue::GetClass(a);
        p.cls = cls ? ue::GetFullName((ue::UObject*)cls) : std::string();
        p.d = std::min(d, dp);
        out.push_back(p);
    }
    std::sort(out.begin(), out.end(),
              [](const NpcPick& a, const NpcPick& b) { return a.d < b.d; });
    if (out.size() > (size_t)kMaxNpc) out.resize((size_t)kMaxNpc);
    return out;
}

// Copies of the "x y z" triple, exactly as Lua's match returns them (the log
// lines print the matched text, not a reformatted number).
struct CmdXYZ {
    bool ok = false;
    std::string x, y, z;
    double nx = 0.0, ny = 0.0, nz = 0.0;
};

bool IsNumTextChar(char c) {
    return (c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E';
}

bool NextNumberText(const std::string& s, size_t* pos, std::string* out) {
    size_t i = *pos;
    while (i < s.size() && !IsNumTextChar(s[i])) ++i;
    const size_t start = i;
    while (i < s.size() && IsNumTextChar(s[i])) ++i;
    if (i == start) return false;
    if (out) *out = s.substr(start, i - start);
    *pos = i;
    return true;
}

CmdXYZ ParseXYZ(const std::string& rest) {
    CmdXYZ v;
    size_t pos = 0;
    if (!NextNumberText(rest, &pos, &v.x)) return v;
    if (!NextNumberText(rest, &pos, &v.y)) return v;
    if (!NextNumberText(rest, &pos, &v.z)) return v;
    v.nx = strtod(v.x.c_str(), nullptr);
    v.ny = strtod(v.y.c_str(), nullptr);
    v.nz = strtod(v.z.c_str(), nullptr);
    v.ok = true;
    return v;
}

// tonumber(rest) or def -- one number and nothing else matters.
double ParseOptNumber(const std::string& text, double def) {
    const std::string t = Trim(text);
    if (t.empty()) return def;
    char* stop = nullptr;
    const double v = strtod(t.c_str(), &stop);
    if (stop == t.c_str()) return def;    // tonumber() -> nil
    return v;
}

bool ContainsText(const std::string& hay, const char* needle) {
    return hay.find(needle) != std::string::npos;
}

// --- the individual commands ----------------------------------------------

void CmdTp(const std::string& rest) {
    const CmdXYZ xyz = ParseXYZ(rest);
    ue::UObject* pawn = Pawn();
    if (!xyz.ok || !pawn) return;

    // main.lua:2091-2096.  The command's own body lives in coop_puppet (which owns
    // PuppetState): teleport, hover, TP_HOLD.  Its "tp -> x y z" log line stays here
    // because this function is the one that has the raw argument text.
    puppet::StartTp(pawn, xyz.nx, xyz.ny, xyz.nz);
    state().combat.enemyTrace = 0;
    Log("tp -> %s %s %s", xyz.x.c_str(), xyz.y.c_str(), xyz.z.c_str());
}

void CmdTravel(const std::string& rest) {
    const CmdXYZ xyz = ParseXYZ(rest);
    ue::UObject* pawn = Pawn();
    if (!xyz.ok || !pawn) return;

    double secs = 60.0;
    {
        // `rest:match("...%s*([%d%.]*)")` -- the 4th number, defaulting to 60
        size_t pos = 0;
        std::string a, b, c, d;
        if (NextNumberText(rest, &pos, &a) && NextNumberText(rest, &pos, &b) &&
            NextNumberText(rest, &pos, &c) && NextNumberText(rest, &pos, &d)) {
            char* stop = nullptr;
            const double v = strtod(d.c_str(), &stop);
            if (stop != d.c_str()) secs = v;
        }
    }

    // main.lua:2148-2152.  coop_puppet owns TRAVEL (and logs the same
    // "travel %.0f uu over %.0fs" line, so it is not repeated here).
    puppet::StartTravel(pawn, xyz.nx, xyz.ny, xyz.nz, secs);
}

void CmdInfo() {
    const std::string peerFile = g_lastPeerFile.empty() ? std::string("-") : g_lastPeerFile;
    Log("phase=%s puppet=%s peer=%s drive(input=%d,teleport=%d) dead=%d",
        PhaseName(state().puppet.phase), FullName(puppet::Actor()).c_str(), peerFile.c_str(),
        state().puppet.driveInputs, state().puppet.driveTeleports,
        (int)state().combat.deadTails.Size());
    // The line above is the Lua's.  These two are the native build's answer to
    // "why is the phase stuck": they name the world, the local pawn and the menu
    // widget the boot step is looking for, so one `info` command replaces a run.
    Log("info: world=%s pawn=%s chars=%d menu=%d",
        FullName(World()).c_str(), FullName(Pawn()).c_str(),
        (int)ue::FindAllOf("BP_PlayerCharacter_C").size(),
        (int)ue::FindAllOf("WBP_MainMenu_C").size());
}

void CmdKill() {
    const std::vector<NpcPick> list = CollectNpcsNear();
    if (list.empty()) return;   // main.lua:2121: `if list[1] then killTail(...) end`
    const NpcPick& e = list.front();
    // main.lua:1397-1408 killTail(tail, "cmd")
    if (state().combat.deadTails.Has(e.tail)) return;
    state().combat.deadTails.Add(e.tail);
    const bool ok = combat::StartDeath(e.actor);
    Log("killTail %s (cmd): startDeath ok=%s %s", e.tail.c_str(), ok ? "true" : "false",
        ok ? "" : "failed");
}

void CmdHurt(const std::string& rest) {
    const double frac = ParseOptNumber(rest, 0.5);
    const std::vector<NpcPick> list = CollectNpcsNear();
    if (list.empty()) {
        Log("hurt: no npc nearby");
        return;
    }
    const NpcPick& e = list.front();
    const bool ok = combat::SetHealthNorm(e.actor, frac);
    bool dead = false;
    const double hp = combat::HealthNorm(e.actor, &dead);
    Log("hurt %s -> %.2f (ok=%s, now %.3f)", e.tail.c_str(), frac, ok ? "true" : "false", hp);
}

void CmdHp() {
    const std::vector<NpcPick> list = CollectNpcsNear();
    const size_t n = std::min<size_t>(list.size(), 6);
    for (size_t i = 0; i < n; ++i) {
        bool dead = false;
        const double hp = combat::HealthNorm(list[i].actor, &dead);
        const std::string hps = hp < 0.0 ? std::string("nil") : Fmt("%.3f", hp);
        Log("hp %s = %s dead=%s d=%.0f", list[i].tail.c_str(), hps.c_str(),
            dead ? "true" : "false", list[i].d);
    }
}

void CmdNpcTp(const std::string& rest) {
    const CmdXYZ xyz = ParseXYZ(rest);
    const std::vector<NpcPick> list = CollectNpcsNear();
    const NpcPick* pick = nullptr;
    for (const NpcPick& e : list) {
        if (ContainsText(e.cls, "Enemy") || ContainsText(e.cls, "Turret")) {
            pick = &e;
            break;
        }
    }
    if (!pick && !list.empty()) pick = &list.front();
    if (!xyz.ok || !pick) {
        Log("npctp: no npc nearby");
        return;
    }
    ue::UObject* a = pick->actor;
    if (!Valid(a)) {
        Log("npctp: no npc nearby");
        return;
    }
    ue::UFunction* fn = uecall::Func(a, "K2_SetActorLocation");
    bool ok = false;
    if (fn && uecall::HasParam(fn, "NewLocation")) {
        ue::Params p(fn);
        ue::FVector dest;
        dest.X = xyz.nx;
        dest.Y = xyz.ny;
        dest.Z = xyz.nz;
        p.Set<ue::FVector>("NewLocation", dest);
        if (uecall::HasParam(fn, "bSweep")) p.Set<bool>("bSweep", false);
        if (uecall::HasParam(fn, "bTeleport")) p.Set<bool>("bTeleport", true);
        ok = ue::Call(a, fn, p.data());
    }
    if (!ok) Log("ERR npctp: K2_SetActorLocation failed");
    // The harness greps `npctp -> (\S+)` and then looks for the host's
    // "mirroring peer-owned enemy <tail>" (run-two.ps1:374-377).
    Log("npctp -> %s at %s %s %s", pick->tail.c_str(), xyz.x.c_str(), xyz.y.c_str(),
        xyz.z.c_str());
}

void CmdAiTest() {
    const std::vector<NpcPick> list = CollectNpcsNear();
    if (list.empty()) {
        Log("aitest: no enemy controller / puppet");
        return;
    }
    const NpcPick& e = list.front();
    ue::UObject* puppetActor = puppet::Actor();
    if (!Valid(puppetActor)) {
        Log("aitest: no enemy controller / puppet");
        return;
    }
    ue::UObject* ctrl = uecall::PropObj(e.actor, "Controller");
    ue::UObject* tsc = ctrl ? uecall::PropObj(ctrl, "TargetSelectionComponent") : nullptr;
    if (!tsc) {
        Log("aitest: no enemy controller / puppet");
        return;
    }
    ue::UFunction* fn = uecall::Func(tsc, "SetTargetOverride");
    if (fn) {
        static const char* kTargetParams[] = {"NewTarget", "Target", "InTarget", "Actor"};
        const char* tp = uecall::PickParam(fn, kTargetParams, 4);
        if (tp) {
            ue::Params p(fn);
            p.Set<ue::UObject*>(tp, puppetActor);
            static const char* kSecsParams[] = {"Duration", "Seconds", "InDuration", "OverrideTime"};
            const char* sp = uecall::PickParam(fn, kSecsParams, 4);
            if (sp) p.Set<float>(sp, 10.0f);
            if (!ue::Call(tsc, fn, p.data())) Log("ERR ai override: SetTargetOverride failed");
        }
    }
    const std::string curName = uecall::PropObj(tsc, "CurrentTarget")
                                    ? FullName(uecall::PropObj(tsc, "CurrentTarget"))
                                    : std::string("none");
    const bool targetsPuppet =
        uecall::PropObj(tsc, "CurrentTarget") == puppetActor;
    Log("aitest: %s target override -> puppet; current target now %s", e.tail.c_str(),
        curName.c_str());
    WriteFile("result_ai.txt",
              Fmt("%s enemy %s targets the peer's body after SetTargetOverride (current %s)\n",
                  targetsPuppet ? "PASS" : "FAIL", e.tail.c_str(), curName.c_str()));
}

// main.lua:2061-2078 -- queued by `lookadd`, run at 2 Hz until it lands.
// CONTRACT-REQUEST 3: appear::QueueLookAdd(path) would replace this.
std::vector<std::string> ClassInstances(const std::string& className) {
    std::vector<std::string> out;
    if (className.empty()) return out;
    for (ue::UObject* o : ue::FindAllOf(className.c_str())) {
        if (ue::IsValid(o)) out.push_back(ue::GetFullName(o));
    }
    return out;
}

bool HasName(const std::vector<std::string>& list, const std::string& name) {
    for (const std::string& s : list) {
        if (s == name) return true;
    }
    return false;
}

void LookTestTick() {
    if (!g_lookAdd.active) return;
    if (Wall() - g_lookAdd.at > 40) {
        Log("lookadd gave up: %s", g_lookAdd.path.c_str());
        g_lookAdd = LookAddJob();
        return;
    }
    ue::UObject* cls = Find(g_lookAdd.path, true);
    if (!cls) return;

    ue::UObject* pawn = Pawn();
    ue::UObject* bpc = pawn ? uecall::PropObj(pawn, "BPC_AttachableItems") : nullptr;
    if (!Valid(bpc)) return;

    // The Lua snapshots LOOK.attachablesOf(pawn); the class we were asked to add
    // is the one that appears, so its own instances are the exact diff and no
    // class list has to be duplicated here.
    const std::string clsName = ue::GetName(cls);
    const std::vector<std::string> before = ClassInstances(clsName);

    // main.lua:2072 -- `bpc:AddItem(cls)` with the class as the single argument.
    // The parameter is called ActorClass on this build (the port's candidate list
    // did not include that name, so PickParam returned null and the call was
    // refused without ever reaching the engine -- the LOOK verdict's "AddItem
    // ok=false").  Names first, then argument 0 as a fallback.
    bool ok = false;
    ue::UFunction* addFn = uecall::Func(bpc, "AddItem");
    if (!addFn) {
        Log("lookadd: %s has no AddItem UFunction", ue::GetClassName(bpc).c_str());
    } else {
        static const char* kAddItemParams[] = {"ActorClass", "Class", "ItemClass", "Item",
                                               "AttachableClass"};
        const char* pn = uecall::PickParam(addFn, kAddItemParams, 5);
        ue::Params ap(addFn);
        if (pn) {
            ap.Set<ue::UObject*>(pn, cls);
        } else {
            ue::WriteMem(ap.data(), &cls, sizeof(cls));
            Log("lookadd: AddItem has no known parameter name; wrote argument 0");
        }
        ok = ue::Call(bpc, addFn, ap.data());
        Log("lookadd AddItem(%s) param=%s size=%d ok=%s %s", g_lookAdd.path.c_str(),
            pn ? pn : "(arg0)", (int)ap.size(), ok ? "true" : "false",
            ok ? "" : "call failed");
    }

    const std::vector<std::string> after = ClassInstances(clsName);
    for (const std::string& name : after) {
        if (!HasName(before, name)) {
            appear::SetLookAdded(name);
            Log("lookadd spawned %s", name.c_str());
        }
    }
    g_lookAdd = LookAddJob();
}

}  // namespace

void RunCommands() {
    // Read every line, then delete the file (main.lua:2081-2085).
    std::string all;
    if (!ReadWholeText(state().local.dir + "cmd.txt", &all)) return;
    RemoveFile("cmd.txt");

    // f:lines() semantics: LF separated, CR stripped, a trailing LF makes no empty line.
    std::vector<std::string> lines;
    size_t start = 0;
    while (start < all.size()) {
        const size_t nl = all.find('\n', start);
        if (nl == std::string::npos) {
            lines.push_back(all.substr(start));
            break;
        }
        std::string l = all.substr(start, nl - start);
        if (!l.empty() && l.back() == '\r') l.pop_back();
        lines.push_back(l);
        start = nl + 1;
    }

    for (const std::string& line : lines) {
        // main.lua:2087 -- "^(%S+)%s*(.-)$"
        size_t sp = 0;
        while (sp < line.size() && (unsigned char)line[sp] <= ' ') ++sp;
        size_t e = sp;
        while (e < line.size() && (unsigned char)line[e] > ' ') ++e;
        const std::string cmd = line.substr(sp, e - sp);
        size_t rs = e;
        while (rs < line.size() && (unsigned char)line[rs] <= ' ') ++rs;
        const std::string rest = line.substr(rs);
        if (cmd.empty()) continue;

        if (cmd == "tp") {
            CmdTp(rest);
        } else if (cmd == "lookadd") {
            g_lookAdd.active = true;
            g_lookAdd.path = rest;
            g_lookAdd.at = Wall();
            Log("lookadd queued: %s", rest.c_str());
        } else if (cmd == "lookdel") {
            appear::LookDel();
            Log("lookdel");
        } else if (cmd == "info") {
            CmdInfo();
        } else if (cmd == "console") {
            Console(rest);
        } else if (cmd == "kill") {
            CmdKill();
        } else if (cmd == "hurt") {
            CmdHurt(rest);
        } else if (cmd == "patrol") {
            puppet::StartPatrol(ParseOptNumber(rest, 10.0));   // `tonumber(seconds) or 10`
        } else if (cmd == "wstest") {
            world::TestWs();
        } else if (cmd == "wptest") {
            progress::TestWp();
        } else if (cmd == "qstest") {
            progress::TestQs();
        } else if (cmd == "qs2test") {
            progress::TestQs2();
        } else if (cmd == "lifttest") {
            world::TestLift();
        } else if (cmd == "cstest") {
            world::TestChest();
        } else if (cmd == "travel") {
            CmdTravel(rest);
        } else if (cmd == "pdtest") {
            ue::UObject* puppetActor = puppet::Actor();
            const bool ok = Valid(puppetActor) && combat::SetHealthNorm(puppetActor, 0.9);
            Log("pdtest: peer body health -> 0.9 (ok=%s)", ok ? "true" : "false");
        } else if (cmd == "aitest") {
            CmdAiTest();
        } else if (cmd == "hp") {
            CmdHp();
        } else if (cmd == "npctp") {
            CmdNpcTp(rest);
        }

        Log("cmd handled: %s", line.c_str());
    }
}

// ---------------------------------------------------------------------------
// Frame / loops
//
// Lua registered four LoopAsync timers on UE4SS's async thread.  The native
// module has one game-thread tick (ue::OnTick -> net::Frame) and a fixed-rate
// router.  Every callback is wrapped in Step(label) exactly where the Lua's
// runLoop(key) wrapped it, so a throw logs "ERR <key> loop: ..." and the other
// loops keep running.
// ---------------------------------------------------------------------------

namespace {

bool InSync() {
    return state().puppet.phase == Phase::Sync;
}

// 30 Hz -- main.lua:4062-4067: patrolTick, driveTick, travelTick.
// (All three are in HOLD_SKIP and SETTLE_SKIP.)
void Loop30(double dt) {
    ++g_t30;
    RunGuardStep("puppet", true, true, [dt]() { puppet::Tick30(dt); });
}

// 15 Hz -- main.lua:4070-4079.
void Loop15(double /*dt*/) {
    ++g_t15;
    if (!InSync()) return;

    // refreshChars + capture transform/montage + judge + peerWatchdog + anim.
    // refreshChars, judge and animInstrument are in both skip tables; capture is
    // not, and Publish() re-reads the live pawn below, so the body keeps moving.
    RunGuardStep("local", true, true, []() { local::Tick15(); });

    // sendOwn -- SETTLE_SKIP only: it is what tells the peer to hide our body
    // while our own world reloads (docs/NATIVE-PORT.md 4, item 42).
    RunGuardStep("sendOwn", true, false, []() { Publish(); });

    // applyPeer -- both tables.
    RunGuardStep("applyPeer", true, true, []() { ApplyPeer(); });
}

// 2 Hz -- main.lua:4082-4127.
void Loop2(double /*dt*/) {
    ++g_t2;

    RunGuardStep("commands", false, false, []() { RunCommands(); });

    // bootTick (the summon state machine) + ensureBody/syncBody + streamTick.
    // In Lua only the body/stream half is guarded; boot only runs before Sync,
    // where a hold/settle window cannot be open (readyTick only runs in Sync).
    RunGuardStep("boot", true, true, []() { puppet::Tick2(); });

    if (!InSync()) return;

    // readyTick + computeMyBody + localWeaponInfo.  readyTick must run *while*
    // held -- it is what ends the hold -- so this step is unguarded.
    RunGuardStep("ready", false, false, []() { local::Tick2(); });

    RunGuardStep("appear", true, true, []() { appear::Tick2(); });
    RunGuardStep("lookTest", true, true, []() { LookTestTick(); });
    RunGuardStep("combat", true, true, []() { combat::Tick2(); });
    RunGuardStep("worldState", true, true, []() { world::Tick2(); });
    RunGuardStep("wp", true, true, []() { progress::Tick2(); });

    // writeSyncStatus: not in either skip table (main.lua:4125).
    RunGuardStep("status", false, false, []() { WriteSyncStatus(); });
}

// 1 Hz -- main.lua:4023-4028.
void Loop1(double /*dt*/) {
    ++g_hb;
    Heartbeat();
}

}  // namespace

void Frame(double dt) {
    // A hold is expressed in wall seconds and a settle window in game seconds:
    // both expire on their own.  The Lua did the settle bookkeeping inside
    // step() -- the first step after the window ran refreshChars + fillHealthCache
    // (main.lua:4009-4012).
    if (state().worldSettleUntil != 0.0 && Now() >= state().worldSettleUntil) {
        state().worldSettleUntil = 0.0;
        Step("refreshChars", Guard::None, []() { combat::RefreshChars(); });
        Step("healthCache", Guard::None, []() { combat::FillHealthCache(); });
    }

    // The world object is replaced on every map load and on the death reload.
    // Every cached UObject* is dropped before anything runs against the new one
    // (coop_state.h rule 5, docs/HANDOFF.md 18).
    ue::UObject* world = World();
    if (world != g_lastWorld) {
        const bool first = !g_worldSeen;
        g_lastWorld = world;
        g_worldSeen = true;
        if (!first) {
            Log("world changed: dropping every cached object");
            OnWorldChanged();
        }
    }

    ticks().Frame(dt);
}

void OnWorldChanged() {
    // The engine layer's lookup caches and class-chain memo hold pointers into the
    // world that is going away; drop them before anything reads a class again.
    ue::ResetLookupCaches();
    ResetAll();
}

// ---------------------------------------------------------------------------
// Start -- main.lua:4129-4133 and the boot-time setup of 24-153
// ---------------------------------------------------------------------------

namespace {

// main.lua:41-54.  Module dir first (the DLL sits next to the exe), then the
// three legacy relative probes, then "coop/".
std::string ResolveCoopDir() {
    std::vector<std::string> probes;
    const std::string mdir = ModuleDir();
    const std::string edir = ExeDir();
    if (!mdir.empty()) probes.push_back(mdir + "/coop_dir.txt");
    if (!edir.empty() && edir != mdir) probes.push_back(edir + "/coop_dir.txt");
    probes.push_back("coop_dir.txt");
    probes.push_back("MortalShell2/Binaries/Win64/coop_dir.txt");
    probes.push_back("./MortalShell2/Binaries/Win64/coop_dir.txt");

    for (const std::string& p : probes) {
        std::string line;
        if (!ReadFirstLinePath(p, &line)) continue;
        if (line.size() <= 1) continue;                  // `#p > 1`
        for (char& c : line) {
            if (c == '\\') c = '/';
        }
        if (line.back() != '/') line += '/';
        return line;
    }
    return "coop/";   // main.lua:54
}

}  // namespace

void Start() {
    static bool started = false;
    if (started) return;
    started = true;

    LocalState& L = state().local;

    L.dir = ResolveCoopDir();

    // playerid.txt / role.txt (main.lua:56-67).  Normalise a BOM or CRLF the
    // harness may have written; run-two.ps1 writes neither.
    std::string line;
    if (ReadFirstLinePath(L.dir + "playerid.txt", &line)) {
        std::string v = Trim(line);
        if (v.size() >= 3 && (unsigned char)v[0] == 0xEF && (unsigned char)v[1] == 0xBB &&
            (unsigned char)v[2] == 0xBF) {
            v = v.substr(3);
        }
        if (!v.empty()) L.me = v;
    }
    if (L.me.empty()) L.me = "A";

    L.role = "host";
    if (ReadFirstLinePath(L.dir + "role.txt", &line)) {
        const std::string v = StripAllSpace(line);
        if (!v.empty()) L.role = v;
    }

    // exactly two players for now (main.lua:1421): A <-> B.
    L.peer = (L.me == "A") ? "B" : "A";

    // Kill switches, read once (main.lua:255, 383, ... 4041).
    state().toggles.Load();
    if (toggles().loadOn) {
        Log("LOAD_ON.txt present: the native build has no asset loader (see Find)");
    }
    if (toggles().gameThread) {
        // main.lua:4036-4043: GAME_THREAD.txt crashed both clients.  The native
        // loops always run on the game thread, so this switch is informational.
        Log("GAME_THREAD.txt present: the native module always runs on the game thread");
    }

    // Stale state from an earlier session must never draw a body
    // (main.lua:4129-4131).
    RemoveFile("out_" + L.me + ".txt");
    RemoveFile("peer_" + L.peer + ".txt");

    Log("=== CoopMod start (me=%s dir=%s role=%s) ===", L.me.c_str(), L.dir.c_str(),
        L.role.c_str());
    WriteFile("result.txt", "RUNNING\n");

    // main.lua's phase clock is running from load time.  EnterPhase() is only
    // called on a TRANSITION, so without this stamp PhaseSeconds() stays 0 until
    // the first one, and every boot timeout in puppet::Boot() ("menu timeout",
    // "waiting for menu (20s)") is dead code -- the first real launch sat in the
    // menu phase silently for the whole session.
    if (state().puppet.phaseEntered == 0) state().puppet.phaseEntered = Wall();

    // Register the four loops.  Order matches the Lua's LoopAsync registration
    // (1 Hz heartbeat first, then 30/15/2).
    ticks().Every(1.0, "hb loop", &Loop1);
    ticks().Every(30.0, "t30 loop", &Loop30);
    ticks().Every(15.0, "t15 loop", &Loop15);
    ticks().Every(2.0, "t2 loop", &Loop2);
}

