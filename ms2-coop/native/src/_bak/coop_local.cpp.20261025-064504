// ---------------------------------------------------------------------------
// string helpers (the Lua patterns this file used)
// ---------------------------------------------------------------------------

bool IsAlphaByte(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

// s:find(needle, 1, true) ~= nil
bool HasSub(const std::string& s, const char* needle) {
    if (!needle || !*needle) return true;
    return s.find(needle) != std::string::npos;
}

// Lua: s:match("^%a*" .. suffix) -- any number of letters, then `suffix`.
// `%a*` is greedy, so every occurrence has to be tried; only "^" anchors it.
bool LeadAlphaThen(const std::string& s, const char* suffix) {
    if (!suffix || !*suffix) return false;
    for (std::size_t p = s.find(suffix); p != std::string::npos; p = s.find(suffix, p + 1)) {
        bool ok = true;
        for (std::size_t i = 0; i < p; ++i) {
            if (!IsAlphaByte(s[i])) { ok = false; break; }
        }
        if (ok) return true;
        if (p + 1 >= s.size()) break;
    }
    return false;
}

// Lua: s:match("([^%.]+)$") or "?"
std::string AfterLastDot(const std::string& s) {
    const std::size_t p = s.rfind('.');
    if (p == std::string::npos) return s.empty() ? std::string("?") : s;
    return (p + 1 < s.size()) ? s.substr(p + 1) : std::string("?");
}

// Lua: s:match("^(%S+)") or "?"
std::string FirstToken(const std::string& s) {
    std::size_t e = 0;
    while (e < s.size() && s[e] != ' ' && s[e] != '\t' && s[e] != '\n' && s[e] != '\r') ++e;
    if (e == 0) return "?";
    return s.substr(0, e);
}

// Lua tostring(bool)
const char* BoolStr(bool v) { return v ? "true" : "false"; }

// ---------------------------------------------------------------------------
// ue:: call helpers. Every one is failure tolerant: a missing property or
// function returns false, and the caller takes the same path the Lua took after
// a `safe()`/pcall failure (nil).
// ---------------------------------------------------------------------------

UFunction* Fn(UObject* o, const char* name) {
    if (!o || !name) return nullptr;
    UClass* cls = ue::GetClass(o);
    if (!cls) return nullptr;
    for (const FnRow& r : g_fns) {
        if (r.cls == cls && r.name == name) return r.fn;
    }
    FnRow row;
    row.cls = cls;
    row.name = name;
    row.fn = ue::FindFunction(o, name);
    g_fns.push_back(row);
    return row.fn;
}

bool ReadPropRaw(UObject* o, const char* prop, void* dst, std::size_t n) {
    if (!o || !prop || !dst || n == 0) return false;
    const int32_t off = ue::PropOffset(o, prop);
    if (off < 0) return false;
    return ue::ReadMem(reinterpret_cast<const uint8_t*>(o) + off, dst, n);
}

bool ReadObjProp(UObject* o, const char* prop, UObject** out) {
    if (out) *out = nullptr;
    UObject* p = nullptr;
    if (!ReadPropRaw(o, prop, &p, sizeof(p))) return false;
    if (out) *out = p;
    return true;
}

// TArray<T> layout: { Data, Num, Max } -- 16 bytes for every element type.
struct RawArray {
    void* Data = nullptr;
    int32_t Num = 0;
    int32_t Max = 0;
};

bool ReadArrayProp(UObject* o, const char* prop, RawArray* out) {
    if (out) *out = RawArray();
    return ReadPropRaw(o, prop, out, sizeof(RawArray));
}

// Copies a TArray<UObject*> into a vector, guarded element by element.
bool ReadObjArray(const RawArray& arr, std::vector<UObject*>* out, int32_t cap) {
    if (!out) return false;
    out->clear();
    if (!arr.Data || arr.Num <= 0) return true;
    if (arr.Num > cap) return false;                  // bogus Num: refuse, do not fault
    out->reserve(static_cast<std::size_t>(arr.Num));
    for (int32_t i = 0; i < arr.Num; ++i) {
        UObject* e = nullptr;
        if (!ue::ReadMem(reinterpret_cast<const uint8_t*>(arr.Data) +
                             static_cast<std::size_t>(i) * sizeof(UObject*),
                         &e, sizeof(e))) {
            return false;
        }
        out->push_back(e);
    }
    return true;
}

bool ReadObjArrayProp(UObject* o, const char* prop, std::vector<UObject*>* out, int32_t cap) {
    RawArray arr;
    if (!ReadArrayProp(o, prop, &arr)) {
        if (out) out->clear();
        return false;
    }
    return ReadObjArray(arr, out, cap);
}

bool CallBool(UObject* o, const char* name, bool* out) {
    if (out) *out = false;
    UFunction* fn = Fn(o, name);
    if (!fn) return false;
    ue::Params p(fn);
    if (!ue::Call(o, fn, p.data())) return false;
    if (out) *out = p.Get<bool>("ReturnValue");
    return true;
}

bool CallI32(UObject* o, const char* name, int32_t* out) {
    if (out) *out = 0;
    UFunction* fn = Fn(o, name);
    if (!fn) return false;
    ue::Params p(fn);
    if (!ue::Call(o, fn, p.data())) return false;
    if (out) *out = p.Get<int32_t>("ReturnValue");
    return true;
}

bool CallFloat(UObject* o, const char* name, double* out) {
    if (out) *out = 0.0;
    UFunction* fn = Fn(o, name);
    if (!fn) return false;
    ue::Params p(fn);
    if (!ue::Call(o, fn, p.data())) return false;
    if (out) *out = static_cast<double>(p.Get<float>("ReturnValue"));
    return true;
}

