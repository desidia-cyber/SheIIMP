// obj:Montage_GetPosition(montage) / obj:Montage_GetPlayRate(montage)
bool CallFloatArg(UObject* o, const char* name, const char* arg, UObject* value, double* out) {
    if (out) *out = 0.0;
    UFunction* fn = Fn(o, name);
    if (!fn) return false;
    ue::Params p(fn);
    p.Set(arg, value);
    if (!ue::Call(o, fn, p.data())) return false;
    if (out) *out = static_cast<double>(p.Get<float>("ReturnValue"));
    return true;
}

// obj:K2_GetComponentsByClass(cls) -> TArray<UActorComponent*>
// ("/Script/Engine.Actor.K2_GetComponentsByClass(ComponentClass)")
// `value` is a UClass*; net::EngineClass hands those back as ue::UObject*, which
// is why it is typed that way here.
bool CallObjArrayArg(UObject* o, const char* name, const char* arg, UObject* value,
                     std::vector<UObject*>* out) {
    if (out) out->clear();
    UFunction* fn = Fn(o, name);
    if (!fn) return false;
    ue::Params p(fn);
    p.Set(arg, value);
    if (!ue::Call(o, fn, p.data())) return false;
    const RawArray arr = p.Get<RawArray>("ReturnValue");
    return ReadObjArray(arr, out, kMaxComponents);
}

