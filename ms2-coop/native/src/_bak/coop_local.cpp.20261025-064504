void Tick15() {
    // main.lua:4072  if S.phase ~= "sync" then return end
    if (state().puppet.phase != Phase::Sync) return;

    StepSkipBoth("refreshChars", [] { RefreshCharsImpl(); });
    StepSkipBoth("judge", [] { Judge(); });
    net::Step("peerWatchdog", Guard::None, [] { PeerWatchdog(); });
    StepSkipBoth("anim", [] { AnimInstrument(); });
}

void Tick2() {
    // main.lua:4089-4100  everything here is inside `if S.phase == "sync"`
    if (state().puppet.phase != Phase::Sync) return;

    // step("ready", readyTick) -- in neither skip list
    net::Step("ready", Guard::None, [] { Ready(); });

    // computeMyBody is pcall'd directly: no step label, no skip list
    net::Step("myBody", Guard::None, [] { ComputeBody(); });

    // step("myWeapon", ...) -- in both skip lists
    StepSkipBoth("myWeapon", [] {
        std::string w, s, all;
        LocalWeaponInfo(&w, &s, &all);
        LocalState& L = state().local;
        L.wpn = w;
        L.wsock = s;
        L.wpns = all;
    });
}

void Reset() {
    LocalState& L = state().local;

    // drop every cached engine pointer (docs/HANDOFF.md 18 -- the crash defence)
    L.tickChars.clear();
    L.tickTails.clear();
    g_fns.clear();

    // strings only, but they were derived from objects a map load frees; the Lua
    // kept them, a re-read is cheap and an asset path is the same next map.
    g_montageSegs.clear();
    g_montageWarned.Clear();
    g_wpnLogged.Clear();
    g_ownM = OwnMontage();

    // deliberately NOT reset: L.ready / readySince / readyWhy (PLAY_READY is a Lua
    // global that only readyTick's hard signals clear), L.seq (SEND_SEQ),
    // L.hasSentPos/sentPos (sentPos), L.goodTicks/totalTicks/verdictWritten, the
    // anim telemetry, and body/apart/wpn/wsock/wpns (refreshed at 2 Hz).
}

