// main.lua:706-785 localWeaponInfo
//
// One mesh of one weapon -> its "wpns" element. False mirrors the Lua `break` of
// the repeat/until block (skip this mesh, keep going with the next weapon).
// ---------------------------------------------------------------------------
bool WeaponMeshPart(UObject* c, UObject* root, const std::string& sock,
                    std::string* pathOut, std::string* partOut) {
    if (pathOut) pathOut->clear();
    if (partOut) partOut->clear();

    const std::string name = net::FullName(c);

    char kind = 0;
    if (LeadAlphaThen(name, "SkeletalMeshComponent")) kind = 'K';
    else if (LeadAlphaThen(name, "StaticMeshComponent")) kind = 'S';

    if (!kind) return false;

    // Lua: `if vis == false or hid == true then break end`.
    // bHiddenInGame is a bitfield, so a raw byte read is wrong (CONTRACT-REQUEST
    // 2); USceneComponent::IsVisible() already folds it in (`bVisible && !bHidden`),
    // so the filter above is preserved by the IsVisible() test alone.
    bool vis = true;
    const bool okVis = CallBool(c, "IsVisible", &vis);
    if (okVis && !vis) return false;

    std::string path;
    if (kind == 'K') {
        // the four accessors the Lua probes, in the same order
        if (path.empty()) {
            UObject* a = nullptr;
            if (ReadObjProp(c, "SkinnedAsset", &a)) path = AssetPathOf(a);
        }
        if (path.empty()) {
            UObject* a = nullptr;
            if (CallObj(c, "GetSkeletalMeshAsset", &a)) path = AssetPathOf(a);
        }
        if (path.empty()) {
            UObject* a = nullptr;
            if (ReadObjProp(c, "SkeletalMeshAsset", &a)) path = AssetPathOf(a);
        }
        if (path.empty()) {
            UObject* a = nullptr;
            if (ReadObjProp(c, "SkeletalMesh", &a)) path = AssetPathOf(a);
        }
    } else {
        UObject* a = nullptr;
        if (ReadObjProp(c, "StaticMesh", &a)) path = AssetPathOf(a);
    }

    if (path.empty()) {
        const std::string key = "noasset:" + name;
        if (g_wpnLogged.Add(key)) net::Log("weapon mesh without asset path: %s", name.c_str());
        return false;
    }

    ue::FVector l;
    ue::FRotator r;
    if (c != root) {
        if (!ReadPropRaw(c, "RelativeLocation", &l, sizeof(l))) l = ue::FVector();
        if (!ReadPropRaw(c, "RelativeRotation", &r, sizeof(r))) r = ue::FRotator();
    }

    if (pathOut) *pathOut = path;
    if (partOut) {
        *partOut = net::Fmt("[\"%s\",\"%c\",\"%s\",%.2f,%.2f,%.2f,%.2f,%.2f,%.2f]",
                            path.c_str(), kind, sock.c_str(),
                            l.X, l.Y, l.Z, r.Pitch, r.Yaw, r.Roll);
    }
    return true;
}

// main.lua:726-742 the one-time per-weapon survey (two log lines).
void WeaponSurvey(UObject* w, const std::string& sock, const std::vector<UObject*>& list) {
    const std::string wn = net::FullName(w);
    if (!g_wpnLogged.Add(wn)) return;

    // comps=[<class>:<name>,...] over K2_GetComponentsByClass(SceneComponent)
    std::string all;
    UObject* sceneCls = EngineClass("SceneComponent");
    if (sceneCls) {
        std::vector<UObject*> comps;
        if (CallObjArrayArg(w, "K2_GetComponentsByClass", "ComponentClass", sceneCls, &comps)) {
            for (UObject* c : comps) {
                const std::string fnm = net::FullName(c);
                if (!all.empty()) all += ",";
                all += FirstToken(fnm);
                all += ":";
                all += AfterLastDot(fnm);
            }
        }
    }

    std::string wc;
    std::vector<UObject*> wcomps;
    if (ReadObjArrayProp(w, "WeaponComponents", &wcomps, kMaxComponents)) {
        for (UObject* c : wcomps) {
            if (!wc.empty()) wc += ",";
            wc += net::FullName(c);
        }
    }

    UObject* add = nullptr;
    ReadObjProp(w, "AdditionalWeapon", &add);

    net::Log("weapon survey %s: comps=[%s] WeaponComponents=[%s] additional=%s",
             AfterLastDot(wn).c_str(), all.c_str(), wc.c_str(), net::FullName(add).c_str());

    std::string names;
    for (UObject* c : list) {
        const std::string fnm = net::FullName(c);
        bool vis = false;
        const bool okVis = CallBool(c, "IsVisible", &vis);
        uint8_t hidByte = 0;
        const bool okHid = ReadPropRaw(c, "bHiddenInGame", &hidByte, sizeof(hidByte));
        if (!names.empty()) names += ",";
        names += FirstToken(fnm);
        names += ":";
        names += AfterLastDot(fnm);
        names += ":vis=";
        names += okVis ? BoolStr(vis) : "nil";
        names += ":hid=";
        // approximate: the raw flag byte, not the bit (CONTRACT-REQUEST 2)
        names += okHid ? BoolStr(hidByte != 0) : "nil";
    }
    net::Log("own weapon %s socket=%s meshes=%s", AfterLastDot(wn).c_str(), sock.c_str(),
             names.c_str());
}

void LocalWeaponInfo(std::string* wpn, std::string* wsock, std::string* wpns) {
    if (wpn) wpn->clear();
    if (wsock) wsock->clear();
    if (wpns) *wpns = "[]";

    UObject* pawn = net::Pawn();
    if (!pawn) return;

    UObject* meshCls = EngineClass("MeshComponent");

    std::string firstPath, firstSock;
    std::vector<std::string> parts;

    int32_t scanned = 0;
    for (UObject* w : ue::FindAllOf("SpartaWeapon")) {
        if (++scanned > kMaxWeapons) break;
        if (!net::Valid(w)) continue;                        // isLive(w)

        UObject* holder = nullptr;
        ReadObjProp(w, "HoldingCharacter", &holder);
        UObject* parent = nullptr;
        CallObj(w, "GetAttachParentActor", &parent);
        if (!((holder && holder == pawn) || (parent && parent == pawn))) continue;

        std::string sock;
        {
            UFunction* fn = Fn(w, "GetAttachParentSocketName");
            if (fn) {
                ue::Params p(fn);
                if (ue::Call(w, fn, p.data())) {
                    sock = ue::ToString(p.Get<ue::FName>("ReturnValue"));
                }
            }
        }

        UObject* root = nullptr;
        CallObj(w, "K2_GetRootComponent", &root);

        std::vector<UObject*> list;
        auto add = [&list](UObject* c) {
            if (!c || !net::Valid(c)) return;
            for (UObject* e : list) {
                if (e == c) return;                          // Lua: `seen`
            }
            list.push_back(c);
        };
        {
            UObject* wm = nullptr;
            if (ReadObjProp(w, "WeaponMesh", &wm)) add(wm);
        }
        if (meshCls) {
            std::vector<UObject*> comps;
            if (CallObjArrayArg(w, "K2_GetComponentsByClass", "ComponentClass", meshCls, &comps)) {
                for (UObject* c : comps) add(c);
            }
        }

        WeaponSurvey(w, sock, list);

        for (UObject* c : list) {
            std::string path, part;
            // main.lua:755-760: the Lua's `break` leaves a `repeat ... until true`
            // (i.e. it SKIPS this component).  Translating it to a C++ break ended
            // the whole component list at the first mesh without an asset path --
            // every weapon's skeletal WeaponMesh is such a component on this build,
            // so `wpn` stayed empty and the WEAPON verdict failed.
            if (!WeaponMeshPart(c, root, sock, &path, &part)) continue;
            parts.push_back(part);
            if (firstPath.empty()) {
                firstPath = path;
                firstSock = sock;
            }
        }
    }

    std::sort(parts.begin(), parts.end());

    std::string joined;
    for (std::size_t i = 0; i < parts.size(); ++i) {
        if (i) joined += ",";
        joined += parts[i];
    }

    if (wpn) *wpn = firstPath;
    if (wsock) *wsock = firstSock;
    if (wpns) *wpns = "[" + joined + "]";
}

