// main.lua:636-650 refreshChars -- moved out of the anonymous namespace below
// because coop_state.h declares local::RefreshChars(): this module owns
// local.tickChars / local.tickTails, and combat::RefreshChars() forwards here.
// ---------------------------------------------------------------------------
void SetTail(std::vector<NamedActor>* list, const std::string& tail, UObject* obj) {
    for (NamedActor& a : *list) {
        if (a.tail == tail) { a.obj = obj; return; }   // Lua: table[key] = actor
    }
    NamedActor row;
    row.tail = tail;
    row.obj = obj;
    list->push_back(row);
}

bool RefreshCharsImpl() {
    LocalState& L = state().local;
    UObject* puppetActor = puppet::Actor();

    L.tickChars = ue::FindAllOf("Character");

    std::vector<NamedActor> tails;
    tails.reserve(L.tickChars.size());
    for (UObject* a : L.tickChars) {
        if (!a) continue;
        if (a == puppetActor) continue;                 // Lua: if a ~= puppet
        SetTail(&tails, net::Tail(a), a);
    }

    // for et,key in pairs(SPN_ALIAS) do tickTails[key] = tickTails[et] end
    // (main.lua:646-649; the map is combat's, one entry per spawned enemy)
    for (const StrStr& alias : state().combat.spawnAlias.Items()) {
        UObject* a = nullptr;
        for (const NamedActor& row : tails) {
            if (row.tail == alias.key) { a = row.obj; break; }
        }
        if (!a) continue;
        SetTail(&tails, alias.value, a);
    }

    L.tickTails.swap(tails);
    return true;
}

// ---------------------------------------------------------------------------
// main.lua:1458-1482 segmentsOf
//
// Layouts are from the Dumper-7 SDK dumped out of THIS build
// (research\raw\Dumper7\SDK\Engine_structs.hpp):
//   FSlotAnimationTrack : FName SlotName @0x00, FAnimTrack AnimTrack @0x08, size 0x18
//   FAnimTrack          : TArray<FAnimSegment> AnimSegments @0x00,            size 0x10
//   FAnimSegment        : UAnimSequenceBase* AnimReference @0x00,
//                         float StartPos @0x08, AnimStartTime @0x0C,
//                         AnimEndTime @0x10, AnimPlayRate @0x14,
//                         int32 LoopingCount @0x18,                        size 0x20
// SlotAnimTracks itself is read through reflection (ue::PropOffset), never an
// offset, so only the two struct strides are pinned here.
// ---------------------------------------------------------------------------
constexpr std::size_t kSlotTrackSize      = 0x18;
constexpr std::size_t kSlotTrackTrackOff  = 0x08;
constexpr std::size_t kAnimSegmentSize    = 0x20;

struct AnimSegmentRaw {
    void* AnimReference = nullptr;
    float StartPos = 0.0f;
    float AnimStartTime = 0.0f;
    float AnimEndTime = 0.0f;
    float AnimPlayRate = 1.0f;
    int32_t LoopingCount = 1;
    int32_t Pad = 0;
};

// Returns by value on purpose: the cache row is a vector member of a growing
// vector, and a reference into it would dangle after the next insertion.
std::vector<MontageSeg> SegmentsOf(UObject* m) {
    const std::string key = net::FullName(m);
    for (const SegCacheRow& row : g_montageSegs) {
        if (row.key == key) return row.segs;
    }

    std::vector<MontageSeg> segs;

    RawArray tracks;
    if (ReadArrayProp(m, "SlotAnimTracks", &tracks) && tracks.Data && tracks.Num > 0 &&
        tracks.Num <= kMaxMontageTracks) {
        const uint8_t* tbase = reinterpret_cast<const uint8_t*>(tracks.Data);
        for (int32_t t = 0; t < tracks.Num; ++t) {
            if (!segs.empty()) break;               // Lua: `if #segs > 0 then return end`
            RawArray animSegs;
            if (!ue::ReadMem(tbase + static_cast<std::size_t>(t) * kSlotTrackSize + kSlotTrackTrackOff,
                             &animSegs, sizeof(animSegs))) {
                break;
            }
            if (!animSegs.Data || animSegs.Num <= 0) continue;
            if (animSegs.Num > kMaxAnimSegments) continue;
            const uint8_t* sbase = reinterpret_cast<const uint8_t*>(animSegs.Data);
            for (int32_t s = 0; s < animSegs.Num; ++s) {
                AnimSegmentRaw raw;
                if (!ue::ReadMem(sbase + static_cast<std::size_t>(s) * kAnimSegmentSize, &raw,
                                 sizeof(raw))) {
                    break;
                }
                UObject* ref = reinterpret_cast<UObject*>(raw.AnimReference);
                if (!ref) continue;
                const std::string p = AssetPathOf(ref);
                if (p.empty()) continue;
                MontageSeg seg;
                seg.path = p;
                seg.start = static_cast<double>(raw.StartPos);
                seg.a0 = static_cast<double>(raw.AnimStartTime);
                seg.a1 = static_cast<double>(raw.AnimEndTime);
                seg.rate = static_cast<double>(raw.AnimPlayRate);
                seg.loops = static_cast<int>(raw.LoopingCount);
                segs.push_back(seg);
            }
        }
    }

    if (segs.empty() && g_montageWarned.Add(key)) {
        net::Log("montage without readable segments: %s", key.c_str());
    }

    SegCacheRow row;
    row.key = key;
    row.segs = segs;
    g_montageSegs.push_back(row);
    return segs;
}

// main.lua:1485-1505 ownMontage. False == "no montage under the play head".
bool OwnMontageOf(UObject* pawn, MontageSig* out) {
    if (out) *out = MontageSig();
    if (!net::Valid(pawn)) {
        g_ownM.obj = nullptr;
        return false;
    }

    UObject* m = nullptr;
    if (!CallObj(pawn, "GetCurrentMontage", &m)) m = nullptr;
    if (!net::Valid(m)) {
        g_ownM.obj = nullptr;
        return false;
    }

    UObject* mesh = nullptr;
    ReadObjProp(pawn, "Mesh", &mesh);
    UObject* inst = nullptr;
    if (!net::Valid(mesh) || !CallObj(mesh, "GetAnimInstance", &inst) || !inst) return false;

    double pos = 0.0, mrate = 1.0;
    if (!CallFloatArg(inst, "Montage_GetPosition", "Montage", m, &pos)) pos = 0.0;
    if (!CallFloatArg(inst, "Montage_GetPlayRate", "Montage", m, &mrate)) mrate = 1.0;

    // a new montage, or the play head went backwards -> a new mid
    if (g_ownM.obj != m || pos < g_ownM.pos - 0.05) g_ownM.id += 1;
    g_ownM.obj = m;
    g_ownM.pos = pos;

    for (const MontageSeg& s : SegmentsOf(m)) {
        const double r = (std::fabs(s.rate) > 0.001) ? std::fabs(s.rate) : 1.0;
        const double len = (s.a1 - s.a0 > 0.001) ? (s.a1 - s.a0) : 0.001;
        const double span = len / r * (s.loops > 1 ? s.loops : 1);
        if (pos >= s.start && pos < s.start + span) {
            double localT = std::fmod((pos - s.start) * r, len);
            if (localT < 0.0) localT += len;               // Lua's % is never negative
            if (s.rate < 0.0) localT = len - localT;
            if (out) {
                out->path = s.path;
                out->pos = s.a0 + localT;
                out->rate = r * mrate;
                out->id = g_ownM.id;
            }
            return true;
        }
    }
    return false;
}

