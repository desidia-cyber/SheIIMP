// main.lua:611 computeMyBody -- own shell mesh path + own AnimBP path.
void ComputeBody() {
    LocalState& L = state().local;
    L.body.clear();
    L.apart.clear();

    UObject* pawn = net::Pawn();
    if (!pawn) return;

    UObject* mesh = nullptr;
    for (UObject* m : SkinnedMeshesOf(pawn)) {
        int32_t bones = 0;
        if (CallI32(m, "GetNumBones", &bones) && bones > 0) { mesh = m; break; }
    }
    if (!mesh) return;

    UObject* asset = nullptr;
    CallObj(mesh, "GetSkeletalMeshAsset", &asset);
    UObject* animClass = nullptr;
    CallObj(mesh, "GetAnimClass", &animClass);

    L.body = AssetPathOf(asset);
    L.apart = AssetPathOf(animClass);
}

// main.lua:706 every rendered weapon mesh -> first path, its socket, the "wpns"
// array body. Also refreshes state().local.wpn/wsock/wpns (what Publish reads).
void WeaponInfo(std::string* wpn, std::string* wsock, std::string* wpns) {
    std::string w, s, all;
    LocalWeaponInfo(&w, &s, &all);
    LocalState& L = state().local;
    L.wpn = w;
    L.wsock = s;
    L.wpns = all;
    if (wpn) *wpn = w;
    if (wsock) *wsock = s;
    if (wpns) *wpns = all;
}

// main.lua:1526-1564 readyTick -- the PLAY_READY gate.
bool Ready() {
    LocalState& L = state().local;

    UObject* pc = net::PC();
    UObject* pawn = net::Pawn();

    const char* hard = nullptr;
    if (!pawn || pawn == puppet::Actor() ||
        !HasSub(net::FullName(pawn), "BP_PlayerCharacter_C")) {
        hard = "no player pawn";
    } else if (HasSub(net::FullName(pc), "MainMenu")) {
        hard = "main menu controller";
    } else if (HasSub(net::FullName(net::World()), "L_MainMenu")) {
        hard = "main menu map";
    } else if (WidgetOnScreen("WBP_LoadingScreen_C") || WidgetOnScreen("WBP_LoadingScreenBase_C")) {
        hard = "loading screen";
    }

    const char* soft = hard;
    if (!soft) {
        UObject* ctrl = nullptr;
        ReadObjProp(pawn, "Controller", &ctrl);
        if (!(ctrl && net::Valid(ctrl) && net::FullName(ctrl) == net::FullName(pc))) {
            soft = "pawn not possessed";
        } else {
            bool ignored = false;
            const bool okIgn = CallBool(pc, "IsMoveInputIgnored", &ignored);
            if (okIgn && ignored) {
                soft = "move input blocked";
            } else if (WidgetOnScreen("WBP_LoadingScreen_FadeToBlack_C")) {
                soft = "fading in";
            } else {
                // the pawn exists a few seconds before the loading screen goes up:
                // wait until our own streaming sources report the area loaded
                for (const StreamSource& e : StreamSources(pawn)) {
                    bool done = false;
                    const bool okDone = CallBool(e.comp, "IsStreamingCompleted", &done);
                    if (okDone && !done) { soft = "world streaming"; break; }
                }
            }
        }
    }

    const bool was = L.ready;

    // our own world is being torn down / rebuilt (death reload, map travel):
    // cached actors, the puppet included, are freed under us (main.lua:1551)
    if (hard) net::SetLocalHold(kLocalHoldSecs);

    if (hard) {
        L.ready = false;
        L.readySince = 0;
    } else if (!L.ready) {
        if (soft) {
            L.readySince = 0;
        } else {
            // os.time: the world clock restarts with every map load
            if (L.readySince == 0) L.readySince = net::Wall();
            if (net::Wall() - L.readySince >= static_cast<int64_t>(kReadyHold)) L.ready = true;
        }
    }

    const char* why = L.ready ? "ready" : (hard ? hard : (soft ? soft : "settling"));
    if (was != L.ready || (!L.ready && L.readyWhy != why)) {
        net::Log("play ready=%s (%s)", BoolStr(L.ready), why);
    }
    L.readyWhy = why;
    return L.ready;
}

// main.lua:1484-1505 the montage under the play head, resolved to a segment of
// its slot track. False == no montage (the Lua returned nil, and the wire then
// carries mseq:"", mpos:0, mrate:1, mid:0).
bool CaptureMontage(MontageSig* out) {
    if (out) *out = MontageSig();
    UObject* pawn = net::Pawn();
    if (!pawn) {
        g_ownM.obj = nullptr;
        return false;
    }
    return OwnMontageOf(pawn, out);
}

// main.lua:1566-1606 sendOwn, up to (not including) the wire write.
// False ONLY for the not-ready shape (net then writes {"rdy":0} with this sq).
bool Capture() {
    LocalState& L = state().local;

    if (!L.ready) {
        L.seq += 1;
        return false;
    }

    UObject* pawn = net::Pawn();
    // ready but no usable pawn: Lua wrote NOTHING this tick (main.lua:1572-1577).
    // Return true with every hot field untouched, so net rewrites a byte-identical
    // line and "sq" does not advance -- what the receiver sees in Lua.
    if (!pawn) return true;
    if (!HasSub(net::FullName(pawn), "BP_PlayerCharacter_C")) return true;
    if (pawn == puppet::Actor()) return true;

    Vec3 loc;
    if (!LocOf(pawn, &loc)) return true;

    ue::FRotator rot;
    const bool haveRot = CallRot(pawn, "K2_GetActorRotation", &rot);

    ue::FVector v;
    double vx = 0.0, vy = 0.0, vz = 0.0;
    if (CallVec(pawn, "GetVelocity", &v)) {
        vx = v.X;
        vy = v.Y;
        vz = v.Z;
    }

    // a teleported / scripted move (patrol, cutscene) has no engine velocity
    if (L.hasSentPos && std::fabs(vx) + std::fabs(vy) < 1.0) {
        const double dx = (loc.X - L.sentPos.X) * 15.0;
        const double dy = (loc.Y - L.sentPos.Y) * 15.0;
        const double d2 = dx * dx + dy * dy;
        if (d2 > 900.0 && d2 < 4e6) {
            vx = dx;
            vy = dy;
            vz = (loc.Z - L.sentPos.Z) * 15.0;
        }
    }
    L.sentPos = loc;
    L.hasSentPos = true;

    const double speed = std::sqrt(vx * vx + vy * vy);
    L.seq += 1;

    const char* anim = "idle";
    if (speed > 250.0) anim = "run";
    else if (speed > 30.0) anim = "walk";

    MontageSig msig;
    const bool hasMontage = OwnMontageOf(pawn, &msig);
    if (hasMontage) anim = "action";

    L.pos = loc;
    if (haveRot) {
        L.rot.Pitch = rot.Pitch;
        L.rot.Yaw = rot.Yaw;
        L.rot.Roll = rot.Roll;
    } else {
        L.rot = Rot();
    }
    L.vel.X = vx;
    L.vel.Y = vy;
    L.vel.Z = vz;
    L.speed = speed;
    L.anim = anim;
    if (hasMontage) {
        L.montage = msig;
    } else {
        L.montage = MontageSig();      // mpath or "", mpos or 0, mrate or 1, mid or 0
        L.montage.rate = 1.0;
    }
    return true;
}

