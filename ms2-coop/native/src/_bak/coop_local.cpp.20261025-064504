// main.lua:1514 widgetOnScreen(cls)
bool WidgetOnScreen(const char* cls) {
    for (UObject* w : ue::FindAllOf(cls)) {
        if (!net::Valid(w)) continue;
        bool inv = false, vis = false;
        const bool okInv = CallBool(w, "IsInViewport", &inv);
        const bool okVis = CallBool(w, "IsVisible", &vis);
        if (okInv && okVis && inv && vis) return true;
    }
    return false;
}

// main.lua:516 streamSources(actor) -- readyTick's "world streaming" soft check.
struct StreamSource {
    UObject* comp = nullptr;
    bool blocking = false;
};

std::vector<StreamSource> StreamSources(UObject* actor) {
    std::vector<StreamSource> out;
    if (!net::Valid(actor)) return out;
    UObject* cls = net::EngineClass("WorldPartitionStreamingSourceComponent");
    if (!cls || !net::Valid(cls)) return out;
    std::vector<UObject*> comps;
    if (!CallObjArrayArg(actor, "K2_GetComponentsByClass", "ComponentClass", cls, &comps)) {
        return out;
    }
    for (UObject* c : comps) {
        if (!net::Valid(c)) continue;
        StreamSource s;
        s.comp = c;
        s.blocking = !HasSub(net::FullName(c), "Non Blocking");
        out.push_back(s);
    }
    return out;
}

