// The labels that appear in BOTH SETTLE_SKIP and HOLD_SKIP (main.lua:3995-4003).
bool StepSkipBoth(const char* label, const std::function<void()>& fn) {
    if (net::WorldSettle()) return false;          // SETTLE_SKIP
    return net::Step(label, Guard::Hold, fn);      // HOLD_SKIP (+ "ERR <label>")
}

// main.lua:2023-2041 judge
void Judge() {
    LocalState& L = state().local;
    if (L.verdictWritten) return;

    UObject* puppetActor = puppet::Actor();
    const PeerState& P = state().peer;
    if (!puppetActor || !P.present) return;
    if (net::Wall() - P.wallAt > 3) return;

    Vec3 loc;
    if (!LocOf(puppetActor, &loc)) return;
    const double d = Dist(loc, P.pos);

    L.totalTicks += 1;
    if (d < 120.0) L.goodTicks += 1;

    if (L.totalTicks >= 30) {
        L.verdictWritten = true;
        const PuppetState& S = state().puppet;
        const std::string verdict = net::Fmt(
            "%s puppet tracks peer (dist %.1f, %d/30 good; moves %d, snaps %d)",
            (L.goodTicks >= 25) ? "PASS" : "FAIL", d, L.goodTicks, S.driveInputs, S.driveTeleports);
        net::WriteFile("result.txt", verdict + "\n");
        net::Log("%s", verdict.c_str());
    }
}

// main.lua:2046-2054 peerWatchdog
void PeerWatchdog() {
    LocalState& L = state().local;
    if (state().peer.present) return;
    const int64_t now = net::Wall();
    if (static_cast<double>(now) - L.lastPeerWarnAt < 10.0) return;
    L.lastPeerWarnAt = static_cast<double>(now);

    const std::string name = "peer_" + L.peer + ".txt";
    const char* exists = net::FileExists(name) ? "exists" : "missing";
    net::Log("waiting for peer state (%s): %s", exists, name.c_str());
}

// main.lua:1998-2017 animInstrument
void AnimInstrument() {
    LocalState& L = state().local;
    if (L.animVerdictWritten) return;
    if (!puppet::Mesh()) return;
    if (!state().puppet.bodyReady) return;

    const std::string& kind = state().puppet.animKind;
    const bool moving = state().puppet.puppetSpeed > 45.0;   // main.lua:4078
    const bool hasState = !kind.empty();

    if (hasState) {
        if (kind == "idle") L.animIdle += 1;
        else if (kind == "walk") L.animWalk += 1;
        else if (kind == "sprint") L.animSprint += 1;
        else if (kind == "montage") L.animMontage += 1;
    }

    if (moving && hasState && kind != "idle") L.animMoveTicks += 1;
    else L.animStillTicks += 1;

    // Throttled gate evidence for the next run: `walk>=10 && moves>=20` is the
    // whole verdict condition, and in the 2026-10-25 run both stayed 0 while the
    // host patrolled, because `patrol` aborted on its first tick (see the clock
    // note in coop_puppet.cpp) and the peer therefore never published a velocity.
    {
        static int64_t lastNote = 0;
        const int64_t nowW = net::Wall();
        if (nowW - lastNote >= 5) {
            lastNote = nowW;
            net::Log("anim instrument: kind=%s moving=%d speed=%.0f idle=%d walk=%d sprint=%d moves=%d"
                     " (need walk>=10 moves>=20)",
                     kind.empty() ? "-" : kind.c_str(), moving ? 1 : 0,
                     state().puppet.puppetSpeed, L.animIdle, L.animWalk, L.animSprint,
                     L.animMoveTicks);
        }
    }

    // moving with the locomotion sequence active is the evidence: the body is not
    // standing still while it travels
    if (L.animWalk >= 10 && L.animMoveTicks >= 20 && !L.animVerdictWritten) {
        L.animVerdictWritten = true;
        const std::string text = net::Fmt(
            "PASS puppet locomotion: sequence states idle=%d walk=%d sprint=%d, "
            "moving-while-animated=%d ticks\n",
            L.animIdle, L.animWalk, L.animSprint, L.animMoveTicks);
        net::WriteFile("result_anim.txt", text);
        std::string oneLine = text;
        const std::size_t nl = oneLine.find('\n');
        if (nl != std::string::npos) oneLine.erase(nl);
        net::Log("%s", oneLine.c_str());
    }
}

