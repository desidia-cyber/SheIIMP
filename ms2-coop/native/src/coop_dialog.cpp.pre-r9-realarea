// pdreset -- put the stand-in body's health back to full after the DIALOG/CINE blocks
// used `pdtest`.  Without it the 0.1 that `pdtest` left behind is charged to the peer
// as real damage as soon as the lock ends, and the PEERHP check (which wants the peer's
// freshly-set 0.37) sees the leftover instead.
void CmdPdReset(const std::string&) {
    ue::UObject* pup = puppet::Actor();
    const bool ok = Valid(pup) && combat::SetHealthNorm(pup, 1.0);
    net::Log("pdreset: puppet body health -> 1.0 (ok=%d)", ok ? 1 : 0);
}

// holdclear -- drop the local hold a cutscene end may have armed (the restore does it
// too, but the harness needs a way to say "now" after a whole block of test verbs).
void CmdHoldClear(const std::string&) {
    const bool was = net::LocalHold();
    if (was) net::SetLocalHold(-1.0);
    net::Log("holdclear: local hold %s", was ? "released" : "was not set");
}

void CmdChoice(const std::string& rest) {
    std::string tag = rest;
    while (!tag.empty() && (unsigned char)tag.front() <= ' ') tag.erase(tag.begin());
    while (!tag.empty() && (unsigned char)tag.back() <= ' ') tag.pop_back();
    if (tag.empty()) {
        std::string cur;
        ReadChoice(&cur);
        net::Log("dlgchoice: current PlayerChoice=%s (usage: dlgchoice <tag>)",
                 cur.empty() ? "-" : cur.c_str());
        return;
    }
    const std::string before = D().choice;
    const bool ok = WriteChoice(tag);
    std::string back;
    const bool rb = ReadChoice(&back);
    if (ok && rb && back == tag) {
        D().choice = back;
        ++D().outSeq;
        net::Log("dlgchoice: PlayerChoice %s -> %s (published on \"ct\")",
                 before.empty() ? "-" : before.c_str(), back.c_str());
    } else {
        net::Log("dlgchoice: write failed (ok=%d readback=%s)", ok ? 1 : 0,
                 back.empty() ? "-" : back.c_str());
    }
}

// dlgselftest -- the wire CODEC, no engine call (the one place a parser bug hides).
void CmdSelfTest(const std::string&) {
    int checks = 0, failed = 0;
    auto want = [&](const char* what, bool ok) {
        ++checks;
        if (!ok) {
            ++failed;
            net::Log("dlgselftest FAIL: %s", what);
        }
    };
    std::vector<std::string> t = Tokens("[1,7,3,2,\"Dlg_Cultist_HUB\",\"/Game/Sparta/Dialogue/Quest/Dlg_X.Dlg_X\"]");
    want("dl token count", t.size() == 6);
    want("dl active", t.size() > 0 && ToInt(t[0], -1) == 1);
    want("dl seq", t.size() > 1 && ToInt(t[1], -1) == 7);
    want("dl node/opts", t.size() > 3 && ToInt(t[2], -1) == 3 && ToInt(t[3], -1) == 2);
    want("dl name", t.size() > 4 && t[4] == "Dlg_Cultist_HUB");
    want("dl path", t.size() > 5 && t[5] == "/Game/Sparta/Dialogue/Quest/Dlg_X.Dlg_X");
    t = Tokens("[0,8,0,0,\"\",\"\"]");
    want("end token count", t.size() == 6);
    want("end active", t.size() > 0 && ToInt(t[0], 1) == 0);
    want("end empty name", t.size() > 4 && t[4].empty());
    t = Tokens("[1,3,900,\"LS_Cinematic Hexapod Intro\"]");
    want("ci token count", t.size() == 4);
    want("ci active", t.size() > 0 && ToInt(t[0], 0) == 1);
    want("ci elapsed", t.size() > 2 && ToInt(t[2], -1) == 900);
    want("ci name", t.size() > 3 && t[3] == "LS_Cinematic Hexapod Intro");
    t = Tokens("[2,3,1,\"B\"]");
    want("dv tokens", t.size() == 4 && ToInt(t[2], -1) == 1);
    t = Tokens("[4,\"Quest.R7.Side\"]");
    want("ct tokens", t.size() == 2 && t[1] == "Quest.R7.Side");
    want("clean quote", Clean("a\"b\\c|d").find('"') == std::string::npos);
    want("clean pipe", Clean("a|b").find('|') == std::string::npos);
    want("clean length", Clean(std::string(200, 'x')).size() == 60);
    want("clean long keeps path", Clean(std::string(200, 'x'), 190).size() == 190);

    std::string before;
    const bool have = ReadChoice(&before);
    if (have) {
        const std::string probe = "Quest.R7.SelfTest";
        const bool wrote = WriteChoice(probe);
        std::string back;
        const bool read = ReadChoice(&back);
        want("PlayerChoice round trip", wrote && read && back == probe);
        if (!before.empty()) {
            const bool restored = WriteChoice(before);
            std::string now;
            want("PlayerChoice restore", restored && ReadChoice(&now) && now == before);
        }
    } else {
        net::Log("dlgselftest: PlayerChoice not readable yet (no quest log in this world)");
    }
    const std::string text = net::Fmt("%s dialog wire codec: %d checks, %d failed\n",
                                      failed == 0 ? "PASS" : "FAIL", checks, failed);
    net::WriteFile("result_dialogselftest.txt", text);
    std::string flat = text;
    while (!flat.empty() && (flat.back() == '\n' || flat.back() == '\r')) flat.pop_back();
    net::Log("dlgselftest: %s", flat.c_str());
}

std::string Status() {
    const dialog::State& s = D();
    std::string out;
    out += net::Fmt(
        "dlg=me:%d peer:%d kind:%d name:%s node:%d opts:%d seq:%d idle:%d pd:%d ai:%d ep:%d "
        "mine:%d listen:%d lines:%d vote:%d/%d out:%d/%s\n",
        s.mine.active, s.peer.active, PeerKind(), s.peer.name.empty() ? "-" : s.peer.name.c_str(),
        s.peer.node, s.peer.opts, s.peer.seq, s.idleForced, s.pdSkips, s.aiSkips, s.episodes,
        s.localEpisodes, g_listenNodes, g_linesReal, g_votesSent, g_votesApplied, s.applies,
        s.choice.empty() ? "-" : s.choice.c_str());
    out += net::Fmt("cine=me:%d peer:%d name:%s ep:%d replay:%d/%d/%d on:%d\n",
                    s.mine.active && s.mine.kind == 2, s.peer.active && s.peer.kind == 2,
                    s.peer.kind == 2 && !s.peer.name.empty() ? s.peer.name.c_str() : "-",
                    s.episodes, g_replayStarts, g_replayJumps, g_replayStops,
                    TG().cineEnabled ? 1 : 0);
    out += net::Fmt("cinesync=lag:%lldms n:%d meStop:%lld\n", (long long)g_lastEndLagMs,
                    g_endLags, (long long)(g_mineStopAtMs % 100000000));
    out += net::Fmt("vote=sim:%d/%d mine:%d:%d res:%d:%d nice:%d on:%d\n", g_voteSimChecks,
                    g_voteSimFailed, g_myVoteNode, g_myVoteOpt, g_resNode, g_resWinner,
                    g_resolutionsSeen, TG().dlgEnabled ? 1 : 0);
    return out;
}

