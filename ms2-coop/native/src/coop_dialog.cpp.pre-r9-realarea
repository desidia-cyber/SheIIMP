int VoteTimeoutSeconds() {
    static int cached = -1;
    if (cached >= 0) return cached;
    cached = (int)kVoteWindow;
    std::string text;
    if (net::ReadText("MS2Coop.ini", &text)) {
        std::size_t p = text.find("dialog_vote_timeout");
        if (p != std::string::npos) {
            p = text.find('=', p);
            if (p != std::string::npos) {
                const double v = strtod(text.c_str() + p + 1, nullptr);
                if (v >= 3.0 && v <= 300.0) cached = (int)v;
            }
        }
    }
    return cached;
}

// The ONE resolution rule, pure so the shipped code is what `dlgvotesim` checks:
//   most votes wins; a tie between different options is broken by the HOST's vote;
//   with no vote from the host among the tied options the LOWEST tied index wins;
//   with no votes at all the game's default (option 0) is used.
int ResolveVotes(const std::vector<std::pair<std::string, int>>& votes, int nOpts,
                 const std::string& hostId) {
    const int n = nOpts > 0 ? nOpts : 1;
    std::vector<int> counts((std::size_t)n, 0);
    for (const auto& v : votes) {
        if (v.second >= 0 && v.second < n) counts[(std::size_t)v.second] += 1;
    }
    int best = 0;
    for (int i = 1; i < n; ++i) {
        if (counts[(std::size_t)i] > counts[(std::size_t)best]) best = i;
    }
    if (counts[(std::size_t)best] == 0) return 0;
    bool tie = false;
    for (int i = 0; i < n; ++i) {
        if (i != best && counts[(std::size_t)i] == counts[(std::size_t)best]) tie = true;
    }
    if (tie) {
        for (const auto& v : votes) {
            if (v.first == hostId && v.second >= 0 && v.second < n &&
                counts[(std::size_t)v.second] == counts[(std::size_t)best]) {
                return v.second;
            }
        }
    }
    return best;
}

std::string TallyText(const std::vector<std::pair<std::string, int>>& votes) {
    std::string s;
    for (const auto& v : votes) {
        if (!s.empty()) s += '|';
        s += v.first + ":" + net::Fmt("%d", v.second);
    }
    return Clean(s, 80);
}

