bool StartCinematicReplay(ue::UObject* actor, int elapsedMs) {
    if (!Valid(actor)) return false;
    // The world effect (GlobalEvent / quest consequences) arrives through the
    // EXISTING sync, so the replay copy must not fire it again.
    ue::SetBool(actor, "BroadcastEventAfterCinematic", false);
    Fn play(actor, "PlayCutscene");
    if (!play.ok()) {
        net::Log("cine: %s has no PlayCutscene", net::NameOf(actor).c_str());
        return false;
    }
    if (!play.run()) return false;
    if (elapsedMs > 1500) {
        ue::UObject* cut = nullptr;
        ue::UObject* seqPlayer = nullptr;
        if (ue::Get<ue::UObject*>(actor, "CutsceneActor", cut) && Valid(cut)) {
            if (!ue::Get<ue::UObject*>(cut, "SequencePlayer", seqPlayer) || !Valid(seqPlayer)) {
                Fn get(cut, "GetSequencePlayer");
                if (get.ok() && get.run()) seqPlayer = get.get<ue::UObject*>("ReturnValue");
            }
        }
        if (Valid(seqPlayer)) {
            Fn jump(seqPlayer, "SetPlaybackPosition");
            if (jump.ok()) {
                PlaybackParamsRaw pp;
                const float secs = (float)elapsedMs / 1000.0f;
                std::memcpy(pp.b + 0x08, &secs, sizeof(secs));   // float Time
                pp.b[0x38] = 1;                                  // PositionType::Time
                pp.b[0x39] = 2;                                  // UpdateMethod::Jump
                jump.set<PlaybackParamsRaw>("PlaybackParams", pp);
                const bool jok = jump.run();
                if (jok) ++g_replayJumps;
                net::Log("cine: late join -> seek to %.2fs on the replay player (ok=%d)", secs,
                         jok ? 1 : 0);
            }
        }
    }
    ++g_replayStarts;
    if (g_replayLogs < 8) {
        ++g_replayLogs;
        net::Log("cine: REPLAY started on %s (elapsed=%dms) -- world event suppressed on this "
                 "copy", net::NameOf(actor).c_str(), elapsedMs);
    }
    return true;
}

// Put the player back the way the game does at a normal cutscene end.
//
// WHY: after `ForceStopCinematic` both clients stayed in cinematic presentation --
// the pawn hidden, the HUD gone, and the ORIGINATOR's view stuck on the leftover
// sequence camera (r7-final measured pToBody=4006 vs 226 until a death/respawn).
// `ForceStopCinematic` only kills the sequence player; the blueprint's restore
// (UnhidePlayerAndWeapons / ResetPlayerMovement / ShowHUD / RemoveCutsceneState /
// camera fade) is the END path, so this runs those, then the camera.
//
// NEVER SetVisibility/SetHiddenInGame with bPropagateToChildren=true on the mesh:
// that reveals the weapon debug shapes (owner-measured) -- every call here passes
// false.
void RestoreCinematicPresentation(const char* why) {
    static double lastAt = -1.0e9;
    if (Now() - lastAt < 0.5) return;
    lastAt = Now();

    ue::UObject* actor = Valid(g_cineActor) ? g_cineActor : FindCinematicActor(g_cineHoldName);
    int ran = 0;
    if (Valid(actor)) {
        const char* fns[] = {"RemoveSkipInput", "UnhidePlayerAndWeapons", "ResetPlayerMovement",
                             "ClearAnyCameraFade", "HandleEndCameraFade", "ShowHUD",
                             "RemoveCutsceneState"};
        for (const char* n : fns) {
            Fn f(actor, n);
            if (f.ok() && f.run()) ++ran;
        }
    }
    ue::UObject* pawn = net::Pawn();
    ue::UObject* pc = net::PC();
    int unhid = 0;
    if (Valid(pawn)) {
        Fn hide(pawn, "SetActorHiddenInGame");
        if (hide.ok()) {
            hide.set<bool>("bNewHidden", false);
            if (hide.run()) ++unhid;
        }
        ue::SetBool(pawn, "bHidden", false);
        ue::UObject* mesh = nullptr;
        if (ue::Get<ue::UObject*>(pawn, "Mesh", mesh) && Valid(mesh)) {
            Fn vis(mesh, "SetVisibility");
            if (vis.ok()) {
                vis.set<bool>("bNewVisibility", true);
                vis.set<bool>("bPropagateToChildren", false);
                if (vis.run()) ++unhid;
            }
        }
    }
    int cam = 0;
    if (Valid(pc)) {
        // the sequence leaves its own camera state on the CameraStateFramework stack;
        // take it off, retarget what remains at the pawn, then blend the view back.
        ue::UObject* mgr = nullptr;
        ue::UObject* stackOwner = nullptr;
        if (ue::Get<ue::UObject*>(pc, "PlayerCameraManager", mgr) && Valid(mgr)) {
            ue::TArray<ue::UObject*> arr{};
            if (ue::Get(mgr, "CameraStack", arr) && arr.Num > 0 && arr.Num <= 64) {
                for (std::int32_t i = 0; i < arr.Num; ++i) {
                    ue::UObject* st = nullptr;
                    if (!ue::ReadMem(arr.Data + i, &st, sizeof(st)) || !Valid(st)) continue;
                    if (ue::GetClassName(st).find("Cinematic") != std::string::npos) {
                        Fn rf(mgr, "RemoveCameraState");
                        if (rf.ok()) {
                            rf.set<ue::UObject*>("CameraState", st);
                            if (rf.run()) {
                                ++cam;
                                net::Log("cine: removed %s from the camera stack",
                                         ue::GetClassName(st).c_str());
                            }
                        }
                        continue;
                    }
                }
                stackOwner = mgr;
            }
        }
        (void)stackOwner;
        if (Valid(pawn)) {
            Fn svt(pc, "SetViewTargetWithBlend");
            if (svt.ok()) {
                svt.set<ue::UObject*>("NewViewTarget", pawn);
                svt.set<float>("BlendTime", 0.2f);
                svt.set<std::uint8_t>("BlendFunc", 0);
                svt.set<bool>("bLockOutgoing", false);
                if (svt.run()) ++cam;
            }
        }
        Fn mv(pc, "SetIgnoreMoveInput");
        if (mv.ok()) {
            mv.set<bool>("bNewMoveInput", false);
            mv.run();
        }
        Fn lk(pc, "SetIgnoreLookInput");
        if (lk.ok()) {
            lk.set<bool>("bNewLookInput", false);
            lk.run();
        }
    }
    // The cutscene's own hide/unhide makes Ready() go hard-false for a moment, and that
    // sets the LOCAL HOLD -- which skips ApplyPeer.  Measured in the 7d regression: A's
    // "bh" went 3.6 s stale right after a cutscene and the PEERHP verdict (3 s window)
    // failed.  The presentation is back, so the hold has to be released here.
    if (net::LocalHold()) {
        net::SetLocalHold(-1.0);
        net::Log("cine: released the local hold the cutscene end had set");
    }
    if (g_subLogs < 12) {
        ++g_subLogs;
        net::Log("cine: RESTORED presentation (%s): blueprint fns=%d, unhide=%d, camera=%d",
                 why, ran, unhid, cam);
    }
}

bool StopCinematicReplay(ue::UObject* actor) {
    if (!Valid(actor)) return false;
    Fn stop(actor, "ForceStopCinematic");
    if (!stop.ok()) return false;
    const bool ok = stop.run();
    if (ok) ++g_replayStops;
    net::Log("cine: replay stop on %s ok=%d", net::NameOf(actor).c_str(), ok ? 1 : 0);
    RestoreCinematicPresentation("sequence stop");
    return ok;
}

