// cineplay [name] -- start a REAL local level sequence through the game's own
// BP_CinematicPlayer_C::PlayCutscene.  This is how the CINE verdict gets a genuine
// cutscene (the hub has three cinematic players and no trigger we can press).
void CmdCinePlay(const std::string& rest) {
    std::string name = rest;
    while (!name.empty() && (unsigned char)name.front() <= ' ') name.erase(name.begin());
    while (!name.empty() && (unsigned char)name.back() <= ' ') name.pop_back();
    ue::UObject* actor = FindCinematicActor(name);
    if (!Valid(actor)) {
        net::Log("cineplay: no BP_CinematicPlayer_C with LevelSequenceToPlay=%s",
                 name.empty() ? "(any)" : name.c_str());
        return;
    }
    ue::UObject* asset = nullptr;
    ue::Get<ue::UObject*>(actor, "LevelSequenceToPlay", asset);
    const bool ok = StartCinematicReplay(actor, 0);
    g_cineActor = actor;
    g_cineInitiator = true;   // we are the side that plays it; the peer replays
    net::Log("cineplay: PlayCutscene on %s (sequence=%s) -> %s", net::NameOf(actor).c_str(),
             Valid(asset) ? net::NameOf(asset).c_str() : "-", ok ? "started" : "FAILED");
}

// cinehold <seconds> [name] -- play a sequence and keep it running (test hold)
void CmdCineHold(const std::string& rest) {
    std::string arg = rest;
    while (!arg.empty() && (unsigned char)arg.front() <= ' ') arg.erase(arg.begin());
    const double secs = strtod(arg.c_str(), nullptr);
    std::string name;
    const std::size_t sp = arg.find(' ');
    if (sp != std::string::npos) {
        name = arg.substr(sp + 1);
        while (!name.empty() && (unsigned char)name.front() <= ' ') name.erase(name.begin());
    }
    g_cineHoldUntil = Now() + (secs > 0.0 ? std::min(secs, 120.0) : 20.0);
    g_cineHoldName = name;
    ue::UObject* a = FindCinematicActor(g_cineHoldName);
    if (!Valid(a)) {
        net::Log("cinehold: no cinematic player for '%s'", g_cineHoldName.c_str());
        g_cineHoldUntil = 0.0;
        return;
    }
    const bool ok = StartCinematicReplay(a, 0);
    g_cineActor = a;
    g_cineInitiator = true;
    net::Log("cinehold: %.1fs hold on %s -> %s", secs, net::NameOf(a).c_str(),
             ok ? "started" : "FAILED");
}

// cinestop -- the game's own abort, so the harness can end a cutscene it started
void CmdCineStop(const std::string&) {
    ue::UObject* actor = Valid(g_cineActor) ? g_cineActor : FindCinematicActor("");
    if (!Valid(actor)) {
        net::Log("cinestop: nothing to stop");
        return;
    }
    const bool ok = StopCinematicReplay(actor);
    g_cineActor = nullptr;
    if (ok && g_mine.active && g_mine.kind == 2) NoteLocalCinematicEnd("cinestop verb");
    net::Log("cinestop: ForceStopCinematic ok=%d", ok ? 1 : 0);
}
