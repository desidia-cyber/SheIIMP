ue::UObject* DialogueSubsystem() {
    if (!Valid(g_dlgSub)) {
        g_dlgSub = ue::FindFirstOf("DialogueSubsystem");
        g_dlgArrOff = kActiveDialogues;
        if (Valid(g_dlgSub)) {
            const i32 off = ue::PropOffset(g_dlgSub, "ActiveDialogues");
            if (off >= 0) g_dlgArrOff = off;
            net::Log("dlg: DialogueSubsystem=%s ActiveDialogues@0x%x", net::NameOf(g_dlgSub).c_str(),
                     (unsigned)g_dlgArrOff);
        }
    }
    return Valid(g_dlgSub) ? g_dlgSub : nullptr;
}

bool ActiveDialogue(ue::UObject** ctxOut, ue::UObject** assetOut, ue::UObject** instOut,
                    std::string* ownerPath) {
    if (ctxOut) *ctxOut = nullptr;
    if (assetOut) *assetOut = nullptr;
    if (instOut) *instOut = nullptr;
    ue::UObject* sub = DialogueSubsystem();
    if (!sub) return false;
    ObjArr arr;
    if (!ReadArr(sub, "ActiveDialogues", g_dlgArrOff, &arr)) return false;
    if (arr.num <= 0) return false;
    if (arr.num > kDlgElemMax) arr.num = kDlgElemMax;

    const i32 esize = ue::PropSize(sub, "ActiveDialogues");
    if (esize != kDlgElemSize && g_dlgElemLogged == 0) {
        g_dlgElemLogged = 1;
        net::Log("dlg: FActiveDialogue element size is 0x%x, the dump says 0x%x -- field offsets "
                 "(instigator 0x0, context 0x8, asset 0x10) are the dump's",
                 (unsigned)esize, (unsigned)kDlgElemSize);
    }

    const std::uint8_t* base = reinterpret_cast<const std::uint8_t*>(arr.data);
    ue::UObject* ctx = nullptr;
    ue::UObject* asset = nullptr;
    ue::UObject* inst = nullptr;
    if (!ue::ReadMem(base + kDlgContext, &ctx, sizeof(ctx))) return false;
    ue::ReadMem(base + kDlgAsset, &asset, sizeof(asset));
    ue::ReadMem(base + kDlgInstigator, &inst, sizeof(inst));
    if (ctxOut) *ctxOut = Valid(ctx) ? ctx : nullptr;
    if (assetOut) *assetOut = Valid(asset) ? asset : nullptr;
    if (instOut) *instOut = Valid(inst) ? inst : nullptr;
    if (ownerPath != nullptr && Valid(inst)) {
        ue::UObject* owner = nullptr;
        if (!ue::Get<ue::UObject*>(inst, "Owner", owner) || !Valid(owner)) {
            Fn get(inst, "GetOwner");
            if (get.ok() && get.run()) owner = get.get<ue::UObject*>("ReturnValue");
        }
        if (Valid(owner)) *ownerPath = net::AssetPath(owner);
    }
    return true;
}

