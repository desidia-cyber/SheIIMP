bool LocalLocked() {
    if (TG().dlgEnabled && g_mine.active && g_mine.kind == 1) return true;
    if (TG().cineEnabled && g_mine.active && g_mine.kind == 2) return true;
    return false;
}
bool PeerLocked() {
    if (!D().peer.active) return false;
    if (D().peer.kind == 1 && !TG().dlgEnabled) return false;
    if (D().peer.kind == 2 && !TG().cineEnabled) return false;
    return PeerLockedFresh();
}
bool PeerLockedFresh() { return Now() - g_peerSeenAt <= kDlgPeerStale; }
double PeerAge() { return Now() - g_peerSeenAt; }
int PeerKind() { return D().peer.active ? D().peer.kind : 0; }

// A local hold (a teleport, a world settle, a respawn) SKIPS ApplyPeer -- and round-7c
// measured a 1170 ms cinematic-end lag that way: the stop was in the peer's file the
// whole time but the apply step was held.  This runs on a never-skipped 15 Hz step and
// parses the peer line only when ApplyPeer has not run recently, so a cutscene end
// can never wait for a hold to expire.
void PeerKeepAlive() {
    if (Now() - g_lastApplyAt < 0.15) return;
    std::string line;
    if (!net::ReadLine("peer_" + state().local.peer + ".txt", &line) || line.empty()) return;
    if (net::HasRdy0(line)) return;
    OnPeerLine(line);
    // The FRIEND'S BODY STATE is the other thing a hold may starve: after a cutscene end
    // both clients arm a 5 s local hold (Ready() sees the unhide as "not ready"), and the
    // r7e regression measured A's `bh` 3.1 s stale -- the PEERHP window is 3 s, so it
    // failed.  Only when the sample really IS stale (>1.5 s), so the healthy path (and
    // the `pd` ordering PEERHIT depends on) is untouched.
    if (body::PeerAge() > 1.5) {
        static double lastBodyRepair = -1.0e9;
        if (Now() - lastBodyRepair > 0.5) {
            lastBodyRepair = Now();
            body::OnPeerLine(line);
            net::Log("dlg: applied a stale \"bh\" from the keep-alive (age was %.1fs)",
                     body::PeerAge());
        }
    }
    g_lastApplyAt = Now();
}
void NoteSkip(int what) {
    if (what == 0) {
        ++D().aiSkips;
    } else {
        ++D().pdSkips;
    }
}

void NoteApplyAt() { g_lastApplyAt = Now(); }

void Start() {
    D() = dialog::State();
    g_mine = dialog::LockState();
    g_real = dialog::LockState();
    g_dlgSub = nullptr;
    g_subShown = false;
    g_subText.clear();
    g_cineActor = nullptr;
    g_cineSeq = -1;
    g_votes.clear();
    net::Log("dialog: start (DIALOG_OFF=%d CINE_OFF=%d) -- dialogue state, the PlayerChoice "
             "outcome, cinematics and the dialogue vote travel on "
             "\"dl\"/\"ct\"/\"ci\"/\"dv\"/\"dr\"",
             TG().dlgEnabled ? 0 : 1, TG().cineEnabled ? 0 : 1);
}

void Reset() {
    g_dlgSub = nullptr;
    g_cineActor = nullptr;
    g_cineSeq = -1;
    g_subShown = false;
    g_subText.clear();
}

