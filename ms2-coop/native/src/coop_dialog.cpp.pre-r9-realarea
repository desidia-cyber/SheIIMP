ue::UObject* FindCinematicActor(const std::string& seqName) {
    std::vector<ue::UObject*> list = ue::FindAllOf("BP_CinematicPlayer_C");
    ue::UObject* first = nullptr;
    for (ue::UObject* a : list) {
        if (!Valid(a)) continue;
        ue::UObject* asset = nullptr;
        if (!ue::Get<ue::UObject*>(a, "LevelSequenceToPlay", asset) || !Valid(asset)) continue;
        if (first == nullptr) first = a;
