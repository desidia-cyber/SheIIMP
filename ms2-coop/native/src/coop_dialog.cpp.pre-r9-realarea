void Tick2() {
    net::Step("dlgSample", Guard::None, [] { SampleLocal(); });
    net::Step("dlgHook", Guard::None, [] { InstallChoiceHook(); });
    net::Step("dlgCine", Guard::None, [] { CinematicReplayTick(); });
    net::Step("dlgStart", Guard::None, [] { DialogueStartTick(); });
    net::Step("dlgStart2", Guard::None, [] { PendingStartTick(); });
    net::Step("dlgListen", Guard::None, [] { ListenerTick(); });
    net::Step("dlgVoteOpen", Guard::None, [] { OpenVoteWindowIfNeeded(); });
    net::Step("dlgVoteResolve", Guard::None, [] { ResolveVotesIfDue(); });
    net::Step("dlgOutcome", Guard::None, [] { ApplyOutcome(); });
    net::Step("dlgJudge", Guard::None, [] { JudgePeer(); });
}

// ===========================================================================
// wire in
// ===========================================================================
void OnPeerLine(const std::string& line) {
    dialog::State& s = D();
    std::string sec;

    const bool hasDl = TG().dlgEnabled && net::Section(line, "dl", &sec);
    if (hasDl) {
        const std::vector<std::string> t = Tokens(sec);
        if (t.size() >= 2) {
            const int active = ToInt(t[0], 1);
            s.peer.active = active ? 1 : 0;
            s.peer.kind = active ? 1 : 0;
            s.peer.seq = ToInt(t[1], s.peer.seq);
            s.peer.at = Now();
            if (!s.peer.active) s.peer.name.clear();
            if (t.size() >= 5 && s.peer.active) s.peer.name = Clean(t[4]);
            if (t.size() >= 3) s.peer.node = ToInt(t[2], 0);
            if (t.size() >= 4) s.peer.opts = ToInt(t[3], 0);
            if (t.size() >= 6 && s.peer.active) s.peerPath = Clean(t[5], 190);
            if (t.size() >= 9 && s.peer.active) {
                s.peerSpeaker = Clean(t[6], 40);
                s.peerLine = Clean(t[7], 200);
                s.peerVoice = Clean(t[8], 150);
            }
            s.peerKnown = true;
            if (s.peer.active) g_peerSeenAt = Now();
        }
    }

    if (TG().cineEnabled && net::Section(line, "ci", &sec)) {
        const std::vector<std::string> t = Tokens(sec);
        if (t.size() >= 2) {
            const int active = ToInt(t[0], 0);
            const int seq = ToInt(t[1], s.peer.seq);
            if (active != 0) {
                const bool wasCine = s.peer.active && s.peer.kind == 2;
                s.peer.active = 1;
                s.peer.kind = 2;
                s.peer.seq = seq;
                s.peer.at = Now();
                s.peer.name = t.size() >= 4 ? Clean(t[3]) : std::string();
                s.peer.elapsedMs = t.size() >= 3 ? ToInt(t[2], 0) : 0;
                s.peerKnown = true;
                g_peerSeenAt = Now();
                // start the replay on the next tick (engine work belongs in Tick2)
                if (!wasCine || g_cineSeq != seq) {
                    g_cinePendingName = s.peer.name;
                    g_cinePendingElapsed = s.peer.elapsedMs;
                    g_cinePending = true;
                }
            } else if (!hasDl || s.peer.kind == 2) {
                const bool wasCine = s.peer.active && s.peer.kind == 2;
                s.peer.active = 0;
                s.peer.kind = 0;
                s.peer.seq = seq;
                s.peer.at = Now();
                s.peer.name.clear();
                if (wasCine) {
                    g_cineStopPending = true;
                    // A replay is NOT this client's own cinematic: when the initiator's
                    // sequence ends, this side's "busy" state must end with it, or the
                    // listener half stays blocked (measured: B stuck at `me:1` for the
                    // rest of the run and never entered the listening state).
                    if (!g_cineInitiator && g_mine.active && g_mine.kind == 2) {
                        g_mine.active = 0;
                        g_mine.kind = 0;
                        g_mine.seq += 1;
                        g_mineEndedAt = Now();
                        g_mineLastKind = 2;
                        D().mine = g_mine;
                    }
                    // Apply it HERE (this runs on the game thread inside the 15 Hz
                    // apply step): deferring to the 2 Hz tick cost up to 500 ms, and
                    // the round-7b capture caught exactly that -- A out of the
                    // cutscene, B still in it.
                    if (Valid(g_cineActor)) {
                        StopCinematicReplay(g_cineActor);
                        g_cineActor = nullptr;
                        g_cineSeq = -1;
                        g_cineStopPending = false;
                    }
                    const int stamp = t.size() >= 3 ? ToInt(t[2], -1) : -1;
                    if (stamp > 0) {
                        const int64_t nowMs = WallMs() % 100000000;
                        int64_t lag = nowMs - (int64_t)stamp;
                        if (lag < 0) lag += 100000000;   // the mod-1e8 wrap
                        g_lastEndLagMs = lag;
                        net::Log("cine: END applied %lldms after the peer stopped it "
                                 "(stop stamp %d)", (long long)lag, stamp);
                    }
                }
            }
        }
    }

    if (TG().dlgEnabled && net::Section(line, "ct", &sec)) {
        const std::vector<std::string> t = Tokens(sec);
        if (t.size() >= 2) {
            s.peerOutSeq = ToInt(t[0], -1);
            s.peerChoice = Clean(t[1]);
        }
    }

    // a vote from the peer (only meaningful on the OWNER side)
    if (TG().dlgEnabled && net::Section(line, "dv", &sec)) {
        const std::vector<std::string> t = Tokens(sec);
        if (t.size() >= 4) {
            const int dseq = ToInt(t[0], -1);
            const int node = ToInt(t[1], -1);
            const int opt = ToInt(t[2], -1);
            const std::string id = Clean(t[3], 8);
            const bool owner = g_mine.active && g_mine.kind == 1 && dseq == g_dseq;
            if (owner && node >= 0 && opt >= 0) {
                VoteTally& vt = g_votes[VoteKey(dseq, node)];
                if (vt.openedAt == 0.0) {
                    vt.openedAt = Now();
                    vt.opts = g_opts;
                    vt.assetPath = g_dlgPath;
                }
                const auto prev = vt.byPlayer.find(id);
                if (prev == vt.byPlayer.end() || prev->second != opt) {
                    vt.byPlayer[id] = opt;
                    net::Log("dlg: vote from %s node=%d option=%d", id.c_str(), node, opt + 1);
                }
            }
        }
    }

    // the owner's resolution
    if (TG().dlgEnabled && net::Section(line, "dr", &sec)) {
        const std::vector<std::string> t = Tokens(sec);
        if (t.size() >= 4) {
            const int dseq = ToInt(t[0], -1);
            const int node = ToInt(t[1], -1);
            const int winner = ToInt(t[2], -1);
            const std::string detail = Clean(t[3], 80);
            if (dseq != g_resSeq || node != g_resNode || winner != g_resWinner) {
                ++g_resolutionsSeen;
                g_resSeq = dseq;
                g_resNode = node;
                g_resWinner = winner;
                g_resDetail = detail;
                g_resAt = Now();
                net::Log("dlg: peer resolved node=%d -> option %d (%s)", node, winner + 1,
                         detail.c_str());
                if (!(g_mine.active && g_mine.kind == 1)) {
                    // show the outcome on this listener's screen before the next line
                    std::string text = g_subText;
                    if (!text.empty()) {
                        text += net::Fmt("  ==> A picked %d", winner + 1);
                        ShowSubtitle(text);
                    }
                }
            }
        }
    }
}

// ===========================================================================
// wire out
// ===========================================================================
void Serialize(std::string* out) {
    if (out == nullptr) return;
    dialog::State& s = D();
    // 15 Hz end detection: the stop must leave in THIS packet, not the next 2 Hz one
    FastCinematicEndPoll();

    if (TG().dlgEnabled) {
        const bool dlg = s.mine.active && s.mine.kind == 1;
        const bool fresh = dlg || (Now() - g_mineEndedAt <= kLinger && g_mineLastKind == 1);
        if (fresh) {
            net::AppendFmt(out,
                           ",\"dl\":[%d,%d,%d,%d,\"%s\",\"%s\",\"%s\",\"%s\",\"%s\"]",
                           dlg ? 1 : 0, s.mine.seq, s.mine.node, s.mine.opts,
                           dlg ? s.mine.name.c_str() : "",
                           dlg ? (g_fakeDlg ? g_fakeDlgPath.c_str() : g_dlgPath.c_str()) : "",
                           dlg ? g_lineSpeaker.c_str() : "", dlg ? g_lineText.c_str() : "",
                           dlg ? g_lineVoice.c_str() : "");
        }
        static double lastChoiceAt = -1.0e9;
        static int lastChoiceSeq = -1;
        if (s.outSeq != lastChoiceSeq) {
            lastChoiceSeq = s.outSeq;
            lastChoiceAt = Now();
        }
        if (lastChoiceSeq > 0 && Now() - lastChoiceAt <= kLinger) {
            net::AppendFmt(out, ",\"ct\":[%d,\"%s\"]", s.outSeq, s.choice.c_str());
        }
        SerializeVote(out);
        if (g_resWinner >= 0 && Now() - g_resAt <= 6.0) {
            net::AppendFmt(out, ",\"dr\":[%d,%d,%d,\"%s\"]", g_resSeq, g_resNode, g_resWinner,
                           g_resDetail.c_str());
        }
    }

    if (TG().cineEnabled) {
        const bool cine = s.mine.active && s.mine.kind == 2;
        const bool fresh = cine || (Now() - g_mineEndedAt <= kLinger && g_mineLastKind == 2);
        if (fresh) {
            int elapsed = 0;
            if (cine && g_cineStartLocal > 0.0) {
                elapsed = (int)((Now() - g_cineStartLocal) * 1000.0);
                if (elapsed < 0) elapsed = 0;
            }
            const int stamp = cine ? elapsed : (int)(g_mineStopAtMs % 100000000);
            net::AppendFmt(out, ",\"ci\":[%d,%d,%d,\"%s\"]", cine ? 1 : 0, s.mine.seq, stamp,
                           cine ? s.mine.name.c_str() : "");
        }
    }
}

