};

// FText is a shared-ref struct.  This module never builds one from a string it
// made up by hand-allocating engine memory: it either COPIES the FText an asset
// already holds, or goes FName -> UKismetStringLibrary::Conv_NameToString ->
// UKismetTextLibrary::Conv_StringToText (both engine-allocated).
struct FTextRaw {
    std::uint64_t w[2] = {0, 0};
};
struct PlaybackParamsRaw {
    std::uint8_t b[0x40] = {0};
};

bool ReadFTextBytes(const void* addr, FTextRaw* out) {
    if (out) *out = FTextRaw();
    if (addr == nullptr) return false;
    FTextRaw t;
    if (!ue::ReadMem(addr, &t, sizeof(t))) return false;
    if (t.w[0] == 0 || !ue::PlausiblePtr(reinterpret_cast<const void*>(t.w[0]))) return false;
    if (out) *out = t;
    return true;
}

std::string TextAt(const void* addr) {
    if (addr == nullptr) return std::string();
    return ue::TextToString(const_cast<void*>(addr));
}

