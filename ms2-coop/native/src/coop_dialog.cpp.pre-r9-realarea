ue::UObject* QuestLogComponent() {
    ue::UObject* q = ue::FindFirstOf("BPC_QuestLogComponent_C");
    if (!Valid(q)) q = ue::FindFirstOf("BPSO_QuestLogComponent_C");
    return Valid(q) ? q : nullptr;
}

bool ReadChoice(std::string* out) {
    if (out) out->clear();
    ue::UObject* q = QuestLogComponent();
    if (!q) return false;
    i32 off = ue::PropOffset(q, "PlayerChoice");
    if (off < 0) off = kPlayerChoice;
    ue::FName n{};
    if (!ue::ReadMem(reinterpret_cast<const std::uint8_t*>(q) + off, &n, sizeof(n))) return false;
    const std::string s = ue::ToString(n);
    if (s.empty() || s == "None") return false;
    if (out) *out = s;
    return true;
}

bool WriteChoice(const std::string& tag) {
    ue::UObject* q = QuestLogComponent();
    if (!q || tag.empty()) return false;
    i32 off = ue::PropOffset(q, "PlayerChoice");
    if (off < 0) off = kPlayerChoice;
    const ue::FName n = ue::MakeName(tag.c_str());
    if (ue::ToString(n) == "None") return false;
    return ue::WriteMem(reinterpret_cast<std::uint8_t*>(q) + off, &n, sizeof(n));
}

// Apply the peer's dialogue outcome when it is news (the listener never applies
// anything else from a conversation: the game's own sync carries tags and quests).
void ApplyOutcome() {
    dialog::State& s = D();
    if (s.peerOutSeq < 0 || !TG().dlgEnabled) return;
    if (s.peerOutSeq == s.outSeq) return;
    if (s.peerChoice.empty()) return;
    if (!std::isalnum((unsigned char)s.peerChoice[0])) return;
    std::string mine;
    ReadChoice(&mine);
    if (mine == s.peerChoice) {
        s.outSeq = s.peerOutSeq;
        return;
    }
    if (WriteChoice(s.peerChoice)) {
        ++s.applies;
        s.outSeq = s.peerOutSeq;
        net::Log("dlg: applied the peer's dialogue outcome PlayerChoice=%s (was %s)",
                 s.peerChoice.c_str(), mine.empty() ? "-" : mine.c_str());
    } else if (s.fail < 5) {
        ++s.fail;
        net::Log("dlg: could NOT write PlayerChoice=%s (quest log present=%d)",
                 s.peerChoice.c_str(), QuestLogComponent() ? 1 : 0);
    }
}

ue::UObject* AssetNode(ue::UObject* asset, int nodeIndex) {
    if (!Valid(asset) || nodeIndex < 0) return nullptr;
    ObjArr nodes;
    if (!ReadArr(asset, "Nodes", kDlgNodes, &nodes)) return nullptr;
    if (nodes.num <= 0 || nodes.num > 8192 || nodeIndex >= nodes.num) return nullptr;
    ue::UObject* n = nullptr;
    if (!ue::ReadMem(reinterpret_cast<const std::uint8_t*>(nodes.data) +
                         (std::size_t)nodeIndex * sizeof(void*),
                     &n, sizeof(n)))
        return nullptr;
    return Valid(n) ? n : nullptr;
}

std::vector<std::string> NodeOptions(ue::UObject* asset, int nodeIndex) {
    std::vector<std::string> out;
    ue::UObject* n = AssetNode(asset, nodeIndex);
    if (!n) return out;
    ObjArr edges;
    if (!ReadArr(n, "Children", kNodeChildren, &edges)) return out;
    const i32 esize = ue::PropSize(n, "Children");
    const i32 step = (esize >= kEdgeText + 16 && esize <= 0x200) ? esize : kEdgeSize;
    const int cnt = std::min((int)edges.num, (int)kMaxEdges);
    for (int i = 0; i < cnt; ++i) {
        const std::uint8_t* e =
            reinterpret_cast<const std::uint8_t*>(edges.data) + (std::size_t)i * step;
        out.push_back(TextAt(e + kEdgeText));
    }
    return out;
}

// Child node objects of a node (the option/selector edges' targets).
std::vector<ue::UObject*> NodeChildren(ue::UObject* n) {
    std::vector<ue::UObject*> out;
    ObjArr edges;
    if (!Valid(n) || !ReadArr(n, "Children", kNodeChildren, &edges)) return out;
    const i32 esize = ue::PropSize(n, "Children");
    const i32 step = (esize >= 0x38 && esize <= 0x200) ? esize : kEdgeSize;
    const int cnt = std::min((int)edges.num, (int)kMaxEdges);
    for (int i = 0; i < cnt; ++i) {
        const std::uint8_t* e =
            reinterpret_cast<const std::uint8_t*>(edges.data) + (std::size_t)i * step;
        i32 target = -1;
        if (ue::ReadMem(e, &target, sizeof(target)) && target >= 0) {
            if (ue::UObject* c = AssetNode(g_dlgAssetForChildren, target)) out.push_back(c);
        }
    }
    return out;
}

// The node that actually SPEAKS: DLG_HubCultist02_Greeting's node 0 is a
// DlgNode_Selector with two children and no text at all (measured: "line=- voice=-"),
// so a listener has to follow the edges to the first node that carries a line.
ue::UObject* SpeechNodeFor(ue::UObject* asset, int nodeIndex, int depth = 0) {
    ue::UObject* n = AssetNode(asset, nodeIndex);
    if (!Valid(n) || depth > 4) return n;
    const std::string line = TextAt(reinterpret_cast<std::uint8_t*>(n) + kSpeechText);
    ue::UObject* snd = nullptr;
    ue::Get<ue::UObject*>(n, "SoundWave", snd);
    if (!line.empty() || Valid(snd)) return n;
    g_dlgAssetForChildren = asset;
    for (ue::UObject* c : NodeChildren(n)) {
        if (!Valid(c)) continue;
        ue::UObject* deeper = SpeechNodeFor(asset, -1, depth);   // placeholder, unused
        (void)deeper;
        const std::string cl = TextAt(reinterpret_cast<std::uint8_t*>(c) + kSpeechText);
        ue::UObject* cs = nullptr;
        ue::Get<ue::UObject*>(c, "SoundWave", cs);
        if (!cl.empty() || Valid(cs)) return c;
        // one more level (a selector inside a selector)
        for (ue::UObject* cc : NodeChildren(c)) {
            if (!Valid(cc)) continue;
            const std::string ccl = TextAt(reinterpret_cast<std::uint8_t*>(cc) + kSpeechText);
            ue::UObject* ccs = nullptr;
            ue::Get<ue::UObject*>(cc, "SoundWave", ccs);
            if (!ccl.empty() || Valid(ccs)) return cc;
        }
    }
    return n;
}

// The line a node speaks: subtitle text + voice asset path (both read from the
// asset, so owner and listener use identical content).
bool NodeLine(ue::UObject* asset, int nodeIndex, std::string* speaker, std::string* line,
              std::string* voice) {
    if (speaker) speaker->clear();
    if (line) line->clear();
    if (voice) voice->clear();
    ue::UObject* n = SpeechNodeFor(asset, nodeIndex);
    if (!n) return false;
    if (line) *line = Clean(TextAt(reinterpret_cast<std::uint8_t*>(n) + kSpeechText), 220);
    if (speaker) {
        const i32 off = ue::PropOffset(n, "SubtitleSpeakerName");
        if (off >= 0) {
            ue::FName fn{};
            if (ue::ReadMem(reinterpret_cast<const std::uint8_t*>(n) + off, &fn, sizeof(fn))) {
                const std::string s = ue::ToString(fn);
                if (!s.empty() && s != "None") *speaker = Clean(s, 40);
            }
        }
        if (speaker->empty()) *speaker = Clean(net::NameOf(n), 40);
    }
    if (voice) {
        ue::UObject* snd = nullptr;
        if (ue::Get<ue::UObject*>(n, "SoundWave", snd) && Valid(snd)) {
            *voice = Clean(net::AssetPath(snd), 190);
        } else {
            ue::UObject* ev = nullptr;
            if (ue::Get<ue::UObject*>(n, "AudioEvent", ev) && Valid(ev)) {
                *voice = Clean(net::AssetPath(ev), 190);
            }
        }
    }
    return !line->empty() || !voice->empty();
}

