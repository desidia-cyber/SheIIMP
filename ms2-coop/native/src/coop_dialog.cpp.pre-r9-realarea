void SampleLocal() {
    dialog::LockState next;
    dialog::LockState real;
    std::string owner;

    ue::UObject* ctx = nullptr;
    ue::UObject* asset = nullptr;
    ue::UObject* inst = nullptr;
    if (TG().dlgEnabled && ActiveDialogue(&ctx, &asset, &inst, &owner)) {
        real.active = 1;
        real.kind = 1;
        real.at = Now();
        if (Valid(asset)) {
            real.name = Clean(net::NameOf(asset));
            g_dlgPath = Clean(net::AssetPath(asset), 190);
        }
        if (Valid(ctx)) {
            Fn node(ctx, "GetActiveNodeIndex");
            if (node.ok() && node.run()) real.node = (int)node.get<i32>("ReturnValue");
            Fn opts(ctx, "GetOptionsNum");
            if (opts.ok() && opts.run()) real.opts = (int)opts.get<i32>("ReturnValue");
        }
        if (g_dlgLogs < 12) {
            ++g_dlgLogs;
            net::Log("dlg: DIALOGUE ACTIVE name=%s node=%d options=%d%s%s", real.name.c_str(),
                     real.node, real.opts, owner.empty() ? "" : " instigatorOwner=", owner.c_str());
        }
    } else if (TG().dlgEnabled) {
        g_dlgPath.clear();
    }

    if (TG().cineEnabled && !real.active) {
        std::vector<ue::UObject*> list = ue::FindAllOf("BP_CinematicPlayer_C");
        int playing = 0;
        std::string seqName;
        for (ue::UObject* a : list) {
            if (!Valid(a)) continue;
            ue::UObject* cut = nullptr;
            if (!ue::Get<ue::UObject*>(a, "CutsceneActor", cut) || !Valid(cut)) continue;
            // CutsceneActor stays set after ForceStopCinematic, so the real question
            // is whether the sequence PLAYER is still running (draw: the round-7b run
            // left `me:1` for 20 s after a successful ForceStopCinematic).
            ue::UObject* sp = nullptr;
            if (!ue::Get<ue::UObject*>(cut, "SequencePlayer", sp) || !Valid(sp)) {
                Fn get(cut, "GetSequencePlayer");
                if (get.ok() && get.run()) sp = get.get<ue::UObject*>("ReturnValue");
            }
            if (Valid(sp)) {
                Fn isp(sp, "IsPlaying");
                if (isp.ok() && isp.run() && !isp.get<bool>("ReturnValue")) continue;
            }
            ++playing;
            if (seqName.empty()) {
                ue::UObject* seqAsset = nullptr;
                if (ue::Get<ue::UObject*>(a, "LevelSequenceToPlay", seqAsset) && Valid(seqAsset)) {
                    seqName = Clean(net::NameOf(seqAsset));
                }
                if (seqName.empty()) seqName = Clean(net::NameOf(cut));
            }
        }
        if (playing > 0) {
            real.active = 1;
            real.kind = 2;
            real.at = Now();
            real.name = seqName;
            if (g_cineStartLocal == 0.0) g_cineStartLocal = Now();
            if (g_cineLogs < 8) {
                ++g_cineLogs;
                net::Log("cine: sequence PLAYING (%d cinematic player(s), %d with a cutscene actor) "
                         "name=%s", (int)list.size(), playing, seqName.c_str());
            }
        } else {
            g_cineStartLocal = 0.0;
            if ((int)list.size() > 0 && g_cineLogs < 8) {
                ++g_cineLogs;
                net::Log("cine: %d cinematic player(s) present, none playing", (int)list.size());
            }
        }
    }

    if (!real.active && TG().dlgEnabled) {
        std::string choice;
        if (ReadChoice(&choice) && choice != D().choice) {
            net::Log("dlg: PlayerChoice %s -> %s (dialogue outcome)",
                     D().choice.empty() ? "-" : D().choice.c_str(), choice.c_str());
            D().choice = choice;
            ++D().outSeq;
        }
    }

    if (g_fakeDlg && TG().dlgEnabled) {
        next.active = 1;
        next.kind = 1;
        next.name = g_fakeDlgName;
        g_dlgPath = g_fakeDlgPath;   // a real asset path, so the listener replays real lines
        next.node = real.node;
        next.opts = real.opts;
    } else if (g_fakeCine && TG().cineEnabled) {
        next.active = 1;
        next.kind = 2;
        next.name = g_fakeCineName;
    } else {
        next = real;
    }
    next.at = Now();

    const bool was = g_mine.active != 0;
    if (next.active != g_mine.active || next.kind != g_mine.kind || next.name != g_mine.name ||
        next.node != g_mine.node) {
        next.seq = g_mine.seq + 1;
    } else {
        next.seq = g_mine.seq;
    }
    if (next.active) g_mineLastKind = next.kind;
    g_real = real;
    const bool started = next.active && !was;
    const bool ended = !next.active && was;
    const int prevKind = g_mine.kind;
    const double prevAt = g_mine.at;
    g_mine = next;

    if (started) {
        ++D().localEpisodes;
        if (next.kind == 1) {
            ++g_dseq;
            g_node = next.node;
            g_opts = next.opts;
            // a new conversation: its votes start from scratch
            g_myVoteSeq = -1;
            g_myVoteNode = -1;
            g_myVoteOpt = -1;
        }
        net::Log("dialog: LOCAL BUSY (%s) name=%s -- publishing it in \"%s\"",
                 next.kind == 1 ? "dialogue" : "cinematic", next.name.c_str(),
                 next.kind == 1 ? "dl" : "ci");
    } else if (ended) {
        net::Log("dialog: local busy ENDED (%s) after %.1fs",
                 prevKind == 1 ? "dialogue" : "cinematic", prevAt > 0.0 ? next.at - prevAt : 0.0);
        g_mineEndedAt = Now();
        if (prevKind == 1) HideSubtitle();
    }
    if (next.active && next.kind == 1) {
        g_node = next.node;
        g_opts = next.opts;
        // the line for THIS node, resolved here (the owner has the asset loaded)
        ue::UObject* asset = nullptr;
        if (!g_dlgPath.empty()) asset = net::Find(g_dlgPath, true);
        std::string sp, ln, vo;
        if (Valid(asset)) {
            NodeLine(asset, next.node, &sp, &ln, &vo);
        }
        if (ln.empty() && sp.empty() && vo.empty()) {
            // the fake trigger, or an asset that cannot be resolved: publish a line
            // anyway so the listener half is testable from cold
            sp = "Disciple";
            ln = "Welcome back, High Sester.";
            vo = "AE_VO_HubCultist_GreetGenessa_10_11";
        }
        if (sp != g_lineSpeaker || ln != g_lineText || vo != g_lineVoice) {
            if (g_dlgLogs < 20) {
                ++g_dlgLogs;
                net::Log("dlg: line node=%d speaker=%s line=%s voice=%s (published in \"dl\")",
                         next.node, sp.c_str(), ln.substr(0, 40).c_str(), vo.c_str());
            }
        }
        g_lineSpeaker = sp;
        g_lineText = ln;
        g_lineVoice = vo;
    } else if (!next.active) {
        g_lineText.clear();
        g_lineSpeaker.clear();
        g_lineVoice.clear();
    }
    D().mine = next;
}

// ===========================================================================
// CINEMA REPLAY: the peer's "ci" asked for a sequence; start/stop it here.
// All engine work is done on the 2 Hz tick, never in the peer-line parse.
// ===========================================================================
// Start the conversation on `comp` through the game's own entry point.  Two
// attempts, both the game's:
//   1. BPC_DialogueInstigator_C::StartDialogue with SkipParticipantsCheck, because
//      a lab start is not an interaction (the NPC's authored participant list is
//      only filled by its own interaction path; the check refused otherwise).
//   2. UDialogueSubsystem::SpartaStartDialogue with THIS pawn as the only
//      participant and no instigator, which is the subsystem's own public entry.
// Diagnose + drive the game's own start.  Order of attempts:
//  0. AddParticipant(pawn)   -- BPC_DialogueInstigator_C::AddParticipant is how the
//     NPC's interaction path fills its participant list; without it CheckParticipants
//     has nothing to accept (that is the likely reason Success=0 in round 7b).
//  1. StartDialogue with the three empty tag containers.
//  2. the NPC's BPC_InteractionHandler_C (the component the player's Use button goes
//     through): HandleInteractEvent / SendInteractionGameplayEvent.
//  3. UDialogueSubsystem::SpartaStartDialogue with [pawn] (and then [npc,pawn] with
//     the instigator).
bool StartConversation(ue::UObject* comp, ue::UObject* asset) {
    ue::UObject* pawn = net::Pawn();
    // --- pre-flight: what the NPC's own gating wants ------------------------------
    // LogDlgGates showed CheckNarrativeTag=1 and Tag to Check=Dialogue.Ruk.FirstTimeTop:
    // the hub cultist refuses to talk until that narrative tag is in the quest log.
    // A real player earns it by meeting Ruk; the lab has to add it the way the game
    // does (`BPC_QuestLogComponent_C::AddNarrativeTag`).
    if (Valid(g_pendingNpc)) {
        ue::SetBool(g_pendingNpc, "bInteractable", true);
        ue::SetBool(g_pendingNpc, "IsTriggerable", true);
        ue::FName tag{};
        ue::Get<ue::FName>(g_pendingNpc, "Tag to Check", tag);
        const std::string tagName = ue::ToString(tag);
        if (!tagName.empty() && tagName != "None") {
            ue::UObject* q = QuestLogComponent();
            if (Valid(q)) {
                Fn add(q, "AddNarrativeTag");
                if (add.ok()) {
                    add.set<ue::FName>("Tag", ue::MakeName(tagName.c_str()));
                    add.set<bool>("SaveToDisk", false);
                    const bool ok = add.run();
                    net::Log("dlgstart: AddNarrativeTag(%s) ok=%d (the NPC's CheckNarrativeTag "
                             "gate)", tagName.c_str(), ok ? 1 : 0);
                }
            }
        }
    }
    // --- attempt 0: the participant list ---------------------------------------
    struct Arr {
        ue::UObject** data;
        i32 num;
        i32 max;
    };
    auto countParticipants = [&]() -> int {
        Fn get(comp, "GetParticipants");
        if (!get.ok() || !get.run()) return -1;
        Arr a = get.get<Arr>("NewParam");
        if (a.num < 0 || a.num > 64) return -1;
        return a.num;
    };
    const int partsBefore = countParticipants();
    if (Valid(pawn)) {
        Fn add(comp, "AddParticipant");
        if (add.ok()) {
            add.set<ue::UObject*>("NewParticipant", pawn);
            const bool aok = add.run();
            net::Log("dlgstart: AddParticipant(pawn) ok=%d ; participants %d -> %d", aok ? 1 : 0,
                     partsBefore, countParticipants());
        } else {
            net::Log("dlgstart: AddParticipant not found (participants %d)", partsBefore);
        }
    }
    // --- what the check says, before and after --------------------------------
    Fn chk(comp, "CheckParticipants");
    if (chk.ok() && chk.run()) {
        net::Log("dlgstart: CheckParticipants -> Success=%d (participants=%d)",
                 chk.get<bool>("Success") ? 1 : 0, countParticipants());
    }
    // --- the instigator's own state, then ActivateDialogue (the BP gate) --------
    net::Log("dlgstart: instigator flags before ActivateDialogue: WasTriggered=%d "
             "WaitForParticipants=%d bDisablePlayerInput=%d CanBeRepeated=%d "
             "SkipParticipantsCheck=%d",
             ue::GetBool(comp, "WasTriggered") ? 1 : 0,
             ue::GetBool(comp, "WaitForParticipants") ? 1 : 0,
             ue::GetBool(comp, "bDisablePlayerInput") ? 1 : 0,
             ue::GetBool(comp, "CanBeRepeated") ? 1 : 0,
             ue::GetBool(comp, "SkipParticipantsCheck") ? 1 : 0);
    {
        Fn act(comp, "ActivateDialogue");
        if (act.ok()) {
            act.set<TagContainerZero>("AdditionalTags", TagContainerZero());
            act.set<TagContainerZero>("AdditionalInterruptTags", TagContainerZero());
            act.set<TagContainerZero>("AdditionalBlockingTags", TagContainerZero());
            const bool ran = act.run();
            net::Log("dlgstart: ActivateDialogue ran=%d Success=%d", ran ? 1 : 0,
                     act.get<bool>("Success") ? 1 : 0);
            LogDialogueState("after ActivateDialogue");
            ue::UObject* c4 = nullptr;
            ue::UObject* a4 = nullptr;
            ue::UObject* i4 = nullptr;
            std::string o4;
            if (ActiveDialogue(&c4, &a4, &i4, &o4)) {
                net::Log("dlgstart: ActivateDialogue STARTED the conversation (%s)",
                         Valid(a4) ? net::NameOf(a4).c_str() : "?");
                return true;
            }
        } else {
            net::Log("dlgstart: ActivateDialogue not found on the instigator");
        }
    }
    // --- the interaction component the Use button goes through ------------------
    ue::UObject* ih = nullptr;
    if (ue::Get<ue::UObject*>(g_pendingNpc, "BPC_InteractionHandler", ih) && Valid(ih)) {
        Fn act(ih, "HandleInteractEvent");
        bool ok = false;
        if (act.ok()) {
            act.set<ue::UObject*>("InputAction", nullptr);
            ok = act.run();
        }
        net::Log("dlgstart: interaction HandleInteractEvent ok=%d (component=%s)", ok ? 1 : 0,
                 net::NameOf(ih).c_str());
        Fn send(ih, "SendInteractionGameplayEvent");
        if (send.ok()) {
            const bool sok = send.run();
            net::Log("dlgstart: SendInteractionGameplayEvent ok=%d", sok ? 1 : 0);
        }
        // did that start a conversation?
        ue::UObject* ctx2 = nullptr;
        ue::UObject* a2 = nullptr;
        ue::UObject* i2 = nullptr;
        std::string o2;
        if (ActiveDialogue(&ctx2, &a2, &i2, &o2)) {
            net::Log("dlgstart: the INTERACTION path started a real conversation (%s)",
                     Valid(a2) ? net::NameOf(a2).c_str() : "?");
            return true;
        }
    }
    bool participants = false;
    if (ue::GetBool(comp, "SkipParticipantsCheck")) participants = true;
    ue::SetBool(comp, "SkipParticipantsCheck", true);
    ue::SetBool(comp, "WasTriggered", false);
    ue::SetBool(comp, "CanBeRepeated", true);
    if (g_dlgLogs < 20) {
        ++g_dlgLogs;
        ue::UObject* was = nullptr;
        ue::Get<ue::UObject*>(comp, "DlgDialogue", was);
        net::Log("dlgstart: component prepared (SkipParticipantsCheck %d -> 1, dialogue=%s)",
                 participants ? 1 : 0, Valid(was) ? net::NameOf(was).c_str() : "-");
    }
    Fn c(comp, "StartDialogue");
    if (c.ok()) {
        c.set<TagContainerZero>("AdditionalTags", TagContainerZero());
        c.set<TagContainerZero>("AdditionalInterruptTags", TagContainerZero());
        c.set<TagContainerZero>("AdditionalBlockingTags", TagContainerZero());
        const bool ok = c.run();
        const bool success = c.get<bool>("Success");
        net::Log("dlgstart: StartDialogue ok=%d Success=%d", ok ? 1 : 0, success ? 1 : 0);
        if (success) return true;
    }
    // fallback: the subsystem's own public start
    ue::UObject* sub = DialogueSubsystem();
    if (!Valid(sub) || !Valid(asset) || !Valid(pawn)) return false;
    Fn s(sub, "SpartaStartDialogue");
    if (!s.ok()) return false;
    s.set<ue::UObject*>("Dialogue", asset);
    ue::UObject* one[1] = {pawn};
    struct Arr1 {
        ue::UObject** data;
        i32 num;
        i32 max;
    } arr = {one, 1, 1};
    s.set<Arr1>("Participants", arr);
    s.set<ue::UObject*>("Instigator", nullptr);
    s.set<TagContainerZero>("AdditionalInterruptTags", TagContainerZero());
    s.set<TagContainerZero>("AdditionalTags", TagContainerZero());
    s.set<TagContainerZero>("AdditionalBlockingTags", TagContainerZero());
    const bool ok2 = s.run();
    net::Log("dlgstart: SpartaStartDialogue(participants=[%s]) ok=%d", net::NameOf(pawn).c_str(),
             ok2 ? 1 : 0);
    {
        ue::UObject* c3 = nullptr;
        ue::UObject* a3 = nullptr;
        ue::UObject* i3 = nullptr;
        std::string o3;
        if (ActiveDialogue(&c3, &a3, &i3, &o3)) return true;   // it really started
    }
    // attempt 3: the same call WITH the NPC as the first participant and the
    // NPC's own instigator -- the shape the interaction path uses.
    Fn s3(sub, "SpartaStartDialogue");
    if (!s3.ok()) return false;
    s3.set<ue::UObject*>("Dialogue", asset);
    ue::UObject* two[2] = {g_pendingNpc, pawn};
    struct Arr2 {
        ue::UObject** data;
        i32 num;
        i32 max;
    } arr2 = {two, 2, 2};
    s3.set<Arr2>("Participants", arr2);
    s3.set<ue::UObject*>("Instigator", comp);
    s3.set<TagContainerZero>("AdditionalInterruptTags", TagContainerZero());
    s3.set<TagContainerZero>("AdditionalTags", TagContainerZero());
    s3.set<TagContainerZero>("AdditionalBlockingTags", TagContainerZero());
    const bool ok3 = s3.run();
    net::Log("dlgstart: SpartaStartDialogue(participants=[npc,%s], instigator=%s) ok=%d",
             net::NameOf(pawn).c_str(), net::NameOf(comp).c_str(), ok3 ? 1 : 0);
    return ok3;
}


void LogDialogueState(const char* when) {
    ue::UObject* ctx = nullptr;
    ue::UObject* asset = nullptr;
    ue::UObject* inst = nullptr;
    std::string owner;
    const bool active = ActiveDialogue(&ctx, &asset, &inst, &owner);
    net::Log("dlgstart: %s active=%d asset=%s instigator=%s ctx=%s", when, active ? 1 : 0,
             Valid(asset) ? net::NameOf(asset).c_str() : "-",
             Valid(inst) ? net::NameOf(inst).c_str() : "-",
             Valid(ctx) ? net::NameOf(ctx).c_str() : "-");
}

// Everything that can stand between us and a real conversation, in one log block:
// interface presence, the tag gate, the asset's active state and the NPC's own
// default interaction (what the Use button ends up doing).
void LogDlgGates(ue::UObject* comp, ue::UObject* npc, ue::UObject* asset) {
    ue::UObject* pawn = net::Pawn();
    const bool pawnIface = Valid(pawn) && ue::FindFunction(pawn, "GetParticipantName") != nullptr;
    const bool npcIface = Valid(npc) && ue::FindFunction(npc, "GetParticipantName") != nullptr;
    net::Log("dlgstart: IDlgDialogueParticipant present: pawn=%d npc=%d", pawnIface ? 1 : 0,
             npcIface ? 1 : 0);
    if (Valid(comp) && Valid(asset)) {
        Fn chk(comp, "CheckTagConditions");
        if (chk.ok()) {
            chk.set<ue::UObject*>("Component", comp);
            chk.set<ue::UObject*>("Asset", asset);
            chk.set<TagContainerZero>("AdditionalTags", TagContainerZero());
            const bool ok = chk.run();
            net::Log("dlgstart: CheckTagConditions ran=%d -> %d", ok ? 1 : 0,
                     ok ? (chk.get<bool>("ReturnValue") ? 1 : 0) : -1);
        }
    }
    ue::UObject* sub = DialogueSubsystem();
    if (Valid(sub) && Valid(asset)) {
        Fn act(sub, "IsDialogueCurrentlyActive");
        if (act.ok()) {
            act.set<ue::UObject*>("InDialogue", asset);
            const bool ok = act.run();
            net::Log("dlgstart: IsDialogueCurrentlyActive ran=%d -> %d", ok ? 1 : 0,
                     ok ? (act.get<bool>("ReturnValue") ? 1 : 0) : -1);
        }
    }
    if (Valid(npc)) {
        const bool chkTag = ue::GetBool(npc, "CheckNarrativeTag");
        ue::FName tag{};
        ue::Get<ue::FName>(npc, "Tag to Check", tag);
        net::Log("dlgstart: npc gating: CheckNarrativeTag=%d TagToCheck=%s",
                 chkTag ? 1 : 0, ue::ToString(tag).c_str());
        Fn def(npc, "HandleDefaultInteraction");
        if (def.ok()) {
            const bool ok = def.run();
            net::Log("dlgstart: HandleDefaultInteraction ok=%d", ok ? 1 : 0);
            LogDialogueState("after HandleDefaultInteraction");
        }
    }
}

void DialogueStartTick() {
    if (g_startPhase == 0) return;
    if (Now() < g_startPhaseAt) return;
    if (g_startPhase == 1) {
        // teleport has landed: drive the interaction component the Use button goes through
        ue::UObject* ih = nullptr;
        ue::UObject* comp = g_pendingStart;
        if (Valid(g_startNpc)) ue::Get<ue::UObject*>(g_startNpc, "BPC_InteractionHandler", ih);
        if (Valid(ih)) {
            Fn act(ih, "HandleInteractEvent");
            bool ok = false;
            if (act.ok()) {
                act.set<ue::UObject*>("InputAction", nullptr);
                ok = act.run();
            }
            Fn send(ih, "SendInteractionGameplayEvent");
            const bool sok = send.ok() && send.run();
            net::Log("dlgstart: interaction path: HandleInteractEvent ok=%d, "
                     "SendInteractionGameplayEvent ok=%d", ok ? 1 : 0, sok ? 1 : 0);
        } else {
            net::Log("dlgstart: %s has no BPC_InteractionHandler", Valid(g_startNpc) ? "" : "-");
        }
        (void)comp;
        {
            ue::UObject* asset = nullptr;
            if (Valid(comp)) ue::Get<ue::UObject*>(comp, "DlgDialogue", asset);
            LogDlgGates(comp, g_startNpc, Valid(asset) ? asset : nullptr);
        }
        g_startPhase = 3;
        g_startPhaseAt = Now() + 0.5;
        g_startVerifyLeft = 8;      // ~4 s of samples: the interaction path uses a delay timer
        return;
    }
    if (g_startPhase == 3) {
        LogDialogueState("verify");
        if (--g_startVerifyLeft > 0) {
            g_startPhaseAt = Now() + 0.5;
            return;
        }
        // nothing started: the direct call, with every gate logged
        if (Valid(g_pendingStart)) {
            net::Log("dlgstart: no conversation after the interaction path -- trying the "
                     "direct start with diagnostics");
            StartConversation(g_pendingStart, nullptr);
        }
        g_startPhase = 0;
        g_pendingStart = nullptr;
        g_startNpc = nullptr;
    }
}

void PendingStartTick() {
    if (!Valid(g_pendingStart) || g_pendingStartAt <= 0.0) return;
    if (Now() < g_pendingStartAt) return;
    ue::UObject* comp = g_pendingStart;
    g_pendingStart = nullptr;
    g_pendingStartAt = 0.0;
    ue::UObject* asset = nullptr;
    ue::Get<ue::UObject*>(comp, "DlgDialogue", asset);
    const bool ok = StartConversation(comp, asset);
    net::Log("dlgstart: deferred start -> %s", ok ? "conversation started" : "FAILED");
}

// Mark OUR cinematic as ended NOW (and stamp it), so the stop leaves in the very next
// 15 Hz packet instead of waiting for the next poll/sample.
void NoteLocalCinematicEnd(const char* why) {
    g_mine.active = 0;
    g_mine.kind = 0;
    g_mine.seq += 1;
    g_mineEndedAt = Now();
    g_mineLastKind = 2;
    g_mineStopAtMs = WallMs() % 100000000;
    g_cineStartLocal = 0.0;
    D().mine = g_mine;
    if (g_endLags < 40) {
        ++g_endLags;
        net::Log("cine: END noted at %lld (%s) -- publishing the stop",
                 (long long)g_mineStopAtMs, why);
    }
    RestoreCinematicPresentation(why);
}

// 15 Hz: notice OUR cinematic ending within one publish (the 2 Hz detector alone put
// up to 500 ms between "the sequence stopped" and "the peer is told").
void FastCinematicEndPoll() {
    if (!TG().cineEnabled) return;
    if (!(g_mine.active && g_mine.kind == 2)) return;
    std::vector<ue::UObject*> list = ue::FindAllOf("BP_CinematicPlayer_C");
    bool playing = false;
    for (ue::UObject* a : list) {
        if (!Valid(a)) continue;
        ue::UObject* cut = nullptr;
        if (!ue::Get<ue::UObject*>(a, "CutsceneActor", cut) || !Valid(cut)) continue;
        ue::UObject* sp = nullptr;
        if (!ue::Get<ue::UObject*>(sp, "SequencePlayer", sp) || !Valid(sp)) {
            if (!ue::Get<ue::UObject*>(cut, "SequencePlayer", sp) || !Valid(sp)) {
                Fn get(cut, "GetSequencePlayer");
                if (get.ok() && get.run()) sp = get.get<ue::UObject*>("ReturnValue");
            }
        }
        if (Valid(sp)) {
            Fn isp(sp, "IsPlaying");
            if (isp.ok() && isp.run() && !isp.get<bool>("ReturnValue")) continue;
        }
        playing = true;
        break;
    }
    if (playing) return;
    NoteLocalCinematicEnd("15 Hz poll");
}

void CinematicReplayTick() {
    if (!TG().cineEnabled) return;
    // cinehold: a test hold.  The hub intro is ~2 s, far too short for the harness
    // or a screenshot pass; restarting it is presentation only (no extra events).
    if (g_cineHoldUntil > 0.0) {
        if (Now() > g_cineHoldUntil) {
            g_cineHoldUntil = 0.0;
            if (!(g_mine.active && g_mine.kind == 2)) RestoreCinematicPresentation("hold ended");
        } else if (!(g_mine.active && g_mine.kind == 2)) {
            ue::UObject* a = FindCinematicActor(g_cineHoldName);
            if (Valid(a)) StartCinematicReplay(a, 0);
        }
    }
    if (g_cineStopPending) {
        g_cineStopPending = false;
        if (Valid(g_cineActor)) {
            StopCinematicReplay(g_cineActor);
            g_cineActor = nullptr;
            g_cineSeq = -1;
        }
    }
    if (!g_cinePending) return;
    g_cinePending = false;
    const std::string name = g_cinePendingName;
    const int elapsed = g_cinePendingElapsed;
    if (g_mine.active && g_mine.kind == 2) return;    // already playing our own
    ue::UObject* actor = FindCinematicActor(name);
    if (!Valid(actor)) {
        if (g_replayLogs < 8) {
            ++g_replayLogs;
            net::Log("cine: no BP_CinematicPlayer_C with LevelSequenceToPlay=%s -- cannot replay",
                     name.empty() ? "(any)" : name.c_str());
        }
        return;
    }
    if (StartCinematicReplay(actor, elapsed)) {
        g_cineActor = actor;
        g_cineSeq = D().peer.seq;
        g_cineInitiator = false;   // this copy is a REPLAY of the peer's sequence
    }
}

// ===========================================================================
// LISTENER: replay A's conversation on this client (voice + subtitles) and drive
// the vote window.  Runs at 2 Hz on the side that is NOT in a dialogue.
// ===========================================================================
void ListenerTick() {
    const bool listening = TG().dlgEnabled && D().peer.active && D().peer.kind == 1 &&
                           dialog::PeerLocked() && !(g_mine.active && g_mine.kind == 1);
    if (!listening) {
        if (g_lastListenNode >= 0) {
            g_lastListenNode = -1;
            g_lastListenPath.clear();
            HideSubtitle();
        }
        return;
    }
    const int node = D().peer.node;
    const std::string path = D().peerPath;
    const bool sameNode = (node == g_lastListenNode && path == g_lastListenPath);
    // Re-apply the same line every 2 s: a subtitle must STAY on screen until the
    // next node (the on-screen text channel expires after a few seconds).
    if (sameNode && Now() - g_lastListenAt < 2.0) return;
    g_lastListenAt = Now();
    if (!sameNode) {
        ++g_listenNodes;
    }
    g_lastListenNode = node;
    g_lastListenPath = path;

    // THE LINE COMES FROM THE WIRE (r7-final measured "asset not loaded yet" on a cold
    // listener); the asset is only the fallback for what the wire cannot carry (the
    // option labels).
    std::string speaker = D().peerSpeaker;
    std::string line = D().peerLine;
    std::string voice = D().peerVoice;
    ue::UObject* asset = path.empty() ? nullptr : net::Find(path, true);
    std::vector<std::string> opts;
    if (Valid(asset)) {
        if (line.empty() && speaker.empty()) {
            NodeLine(asset, node, &speaker, &line, &voice);
        }
        opts = NodeOptions(asset, node);
    }
    // the subtitle block: speaker + line + (at a choice node) the options
    std::string text;
    if (!speaker.empty()) text += speaker + ": ";
    text += line;
    if (!opts.empty() && D().peer.opts > 0) {
        text += "  [";
        for (std::size_t i = 0; i < opts.size() && i < 4; ++i) {
            if (i) text += " | ";
            text += net::Fmt("%d) ", (int)i + 1) + opts[i];
        }
        text += "]";
        if (g_myVoteOpt >= 0) text += net::Fmt(" (your vote: %d)", g_myVoteOpt + 1);
    }
    // the game's own subtitle widget first: the asset's own FText when it is loaded,
    // otherwise an FText built from the wire's line (cold-listener path)
    ue::UObject* speech = Valid(asset) ? SpeechNodeFor(asset, node) : nullptr;
    FTextRaw nodeText;
    bool haveNodeText = Valid(speech) && ReadFTextBytes(
        reinterpret_cast<const std::uint8_t*>(speech) + kSpeechText, &nodeText);
    if (!haveNodeText && !text.empty()) haveNodeText = TextFromString(text, &nodeText);
    if (haveNodeText) ShowSubtitleFText(nodeText, text);
    if (!text.empty()) ShowSubtitle(text);
    if (!voice.empty()) PlayVoice(voice);
    if (!text.empty() || !voice.empty()) ++g_linesReal;
    if (g_listenNodes <= 20) {
        net::Log("dlg: LISTEN node=%d speaker=%s line=%s voice=%s options=%d", node,
                 speaker.empty() ? "-" : speaker.c_str(), line.empty() ? "-" : line.substr(0, 48).c_str(),
                 voice.empty() ? "-" : net::NameOf(ue::FindObject(voice.c_str())).c_str(),
                 (int)opts.size());
    }
}

// ===========================================================================
// VOTES: open/close the window, collect votes, resolve on the owner
// ===========================================================================
void OpenVoteWindowIfNeeded() {
    const bool owner = TG().dlgEnabled && g_mine.active && g_mine.kind == 1;
    const bool listener = TG().dlgEnabled && D().peer.active && D().peer.kind == 1 && dialog::PeerLocked() &&
                          !(g_mine.active && g_mine.kind == 1);
    if (!owner && !listener) return;
    const int dseq = owner ? g_dseq : D().peer.seq;
    const int node = owner ? g_node : D().peer.node;
    const int opts = owner ? g_opts : D().peer.opts;
    if (opts <= 0 || node < 0) return;
    const std::string key = VoteKey(dseq, node);
    auto it = g_votes.find(key);
    if (it == g_votes.end()) {
        VoteTally t;
        t.openedAt = Now();
        t.opts = opts;
        t.assetPath = owner ? g_dlgPath : D().peerPath;
        g_votes[key] = t;
        if (g_voteLogs < 8) {
            ++g_voteLogs;
            net::Log("dlg: VOTE window open dseq=%d node=%d options=%d%s", dseq, node, opts,
                     owner ? " (owner)" : " (listener)");
        }
    }
}

void ResolveVotesIfDue() {
    const bool owner = TG().dlgEnabled && g_mine.active && g_mine.kind == 1;
    if (!owner) return;
    const std::string key = VoteKey(g_dseq, g_node);
    auto it = g_votes.find(key);
    if (it == g_votes.end() || it->second.resolved) return;
    VoteTally& t = it->second;
    const int expected = InZoneWithPeer() ? 2 : 1;      // an absent peer abstains
    const int timeout = VoteTimeoutSeconds();
    const bool allVoted = (int)t.byPlayer.size() >= expected;
    const bool timedOut = Now() - t.openedAt >= (double)timeout;
    if (!allVoted && !timedOut) return;

    const std::vector<std::pair<std::string, int>> votes = VotesOf(t);
    const int winner = ResolveVotes(votes, t.opts, "A");   // the host is role A
    const std::string detail = TallyText(votes);
    t.resolved = true;
    t.winner = winner;
    t.detail = detail;
    g_resSeq = g_dseq;
    g_resNode = g_node;
    g_resWinner = winner;
    g_resDetail = detail;
    g_resAt = Now();

    // apply through the game's own select call, ONCE, with the intercept disabled
    ue::UObject* ctx = nullptr;
    ue::UObject* asset = nullptr;
    ue::UObject* inst = nullptr;
    std::string ownerPath;
    if (ActiveDialogue(&ctx, &asset, &inst, &ownerPath) && Valid(ctx)) {
        g_applyingChoice = true;
        Fn choose(ctx, "ChooseSpeechSequenceOptionFromReplicated");
        bool ok = false;
        if (choose.ok()) {
            choose.set<i32>("OptionIndex", winner);
            ok = choose.run();
        }
        if (!ok) {
            Fn ch2(ctx, "ChooseOption");
            if (ch2.ok()) {
                ch2.set<i32>("OptionIndex", winner);
                ok = ch2.run();
            }
        }
        g_applyingChoice = false;
        if (ok) ++g_votesApplied;
        net::Log("dlg: VOTE resolved node=%d winner=%d (%s) applied=%d [%s]", g_node, winner,
                 allVoted ? "all voted" : "timeout", ok ? 1 : 0, detail.c_str());
    } else {
        net::Log("dlg: VOTE resolved node=%d winner=%d (%s) but there is no local context to "
                 "apply it to", g_node, winner, detail.c_str());
    }
}

// The owner's click (and any local call) must only VOTE, never advance the
// conversation: this hook is the intercept point.
bool ChoiceSkipForHook(ue::UObject* self, ue::UFunction* /*fn*/, void* params) {
    if (g_applyingChoice) return false;            // our own apply: let it through
    int idx = -1;
    if (params == nullptr || !ue::ReadMem(params, &idx, sizeof(idx))) return false;
    if (!(g_mine.active && g_mine.kind == 1) || !TG().dlgEnabled) return false;
    ++g_localPicks;
    const int node = g_node;
    const int opts = g_opts;
    if (opts <= 0) return false;                   // not a choice node: never block
    if (idx < 0 || idx >= opts) return false;
    g_myVoteSeq = g_dseq;
    g_myVoteNode = node;
    g_myVoteOpt = idx;
    g_myVoteAt = Now();
    net::Log("dlg: local pick %d at node %d -> VOTE (the game's select was held)", idx + 1, node);
    return true;                                   // skip: we advance on resolution only
}

void InstallChoiceHook() {
    if (g_choiceHookTried) return;
    g_choiceHookTried = true;
    const char* names[2] = {"ChooseSpeechSequenceOptionFromReplicated", "ChooseOption"};
    for (const char* n : names) {
        ue::UObject* anyCtx = ue::FindFirstOf("DlgContext");
        if (!Valid(anyCtx)) continue;
        ue::UFunction* f = ue::FindFunction(anyCtx, n);
        if (f == nullptr) continue;
        if (ue::HookPreSkipFn(f, &ChoiceSkipForHook)) {
            net::Log("dlg: intercept hook on UDlgContext.%s -- a local pick becomes a vote", n);
        }
    }
}

// Publish this client's vote while it is current.
void SerializeVote(std::string* out) {
    if (!TG().dlgEnabled) return;
    if (g_myVoteOpt < 0) return;
    if (Now() - g_myVoteAt > kLinger) return;
    net::AppendFmt(out, ",\"dv\":[%d,%d,%d,\"%s\"]", g_myVoteSeq, g_myVoteNode, g_myVoteOpt,
                   St().local.me.c_str());
}

// The DIALOG verdict's vote cases, checked against the SHIPPED resolver.
void VoteSelfCheck() {
    g_voteSimChecks = 0;
    g_voteSimFailed = 0;
    auto ck = [&](const char* what, bool ok) {
        ++g_voteSimChecks;
        if (!ok) {
            ++g_voteSimFailed;
            net::Log("dlgvotesim FAIL: %s", what);
        }
    };
    // case 1: both players vote the same option
    {
        std::vector<std::pair<std::string, int>> v{{"A", 1}, {"B", 1}};
        ck("same vote wins", ResolveVotes(v, 3, "A") == 1);
    }
    // case 2: different votes -> the HOST's (A) wins the tie
    {
        std::vector<std::pair<std::string, int>> v{{"A", 2}, {"B", 0}};
        ck("tie -> host's option", ResolveVotes(v, 3, "A") == 2);
        std::vector<std::pair<std::string, int>> v2{{"B", 2}, {"A", 0}};
        ck("tie -> host's option (order independent)", ResolveVotes(v2, 3, "A") == 0);
    }
    // case 3: a timeout with ONE vote -> that vote
    {
        std::vector<std::pair<std::string, int>> v{{"B", 2}};
        ck("single vote wins", ResolveVotes(v, 3, "A") == 2);
    }
    // case 4: nobody voted -> the game's default (option 0)
    {
        std::vector<std::pair<std::string, int>> v;
        ck("no vote -> default 0", ResolveVotes(v, 3, "A") == 0);
    }
    // case 5: majority beats the host's vote
    {
        std::vector<std::pair<std::string, int>> v{{"A", 0}, {"B", 1}, {"C", 1}};
        ck("majority beats host", ResolveVotes(v, 3, "A") == 1);
    }
    // case 6: a vote outside the option range is ignored, not a crash
    {
        std::vector<std::pair<std::string, int>> v{{"A", 9}};
        ck("out of range vote ignored", ResolveVotes(v, 2, "A") == 0);
    }
    g_voteSimAt = Now();
    const std::string text =
        net::Fmt("%s dialogue votes: %d checks, %d failed\n", g_voteSimFailed == 0 ? "PASS" : "FAIL",
                 g_voteSimChecks, g_voteSimFailed);
    net::WriteFile("result_dialogvote.txt", text);
    std::string flat = text;
    while (!flat.empty() && (flat.back() == '\n' || flat.back() == '\r')) flat.pop_back();
    net::Log("dlgvotesim: %s", flat.c_str());
}

// ===========================================================================
// verdicts (written by the RECEIVING client)
// ===========================================================================
void JudgePeer() {
    dialog::State& s = D();
    const bool fresh = dialog::PeerLocked();
    static double epStart = 0.0;
    static int epKind = 0;
    static int epIdle = 0;
    static int epPd = 0;
    static int epListen = 0;
    static bool wrote = false;
    static int listenAtStart = 0;

    if (fresh && s.peer.active) {
        if (epKind == 0) {
            epKind = s.peer.kind == 2 ? 2 : 1;
            epStart = Now();
            epIdle = 0;
            epPd = 0;
            listenAtStart = g_listenNodes;
            wrote = false;
            ++s.episodes;
            net::Log("dialog: PEER BUSY (%s) name=%s seq=%d -- puppet idle, no retarget, no "
                     "damage charge%s", epKind == 1 ? "dialogue" : "cinematic",
                     s.peer.name.c_str(), s.peer.seq,
                     epKind == 1 ? ", this client listens to the lines" : ", this client replays "
                     "the sequence");
        }
        if (state().puppet.animState == "idle") {
            ++epIdle;
            ++s.idleForced;
        }
        const double held = Now() - epStart;
        epPd = s.pdSkips - g_pdAtStart;
        // The listener counter is CUMULATIVE on purpose: the replay of a line happens
        // in the same tick the episode opens (ListenerTick runs before JudgePeer), so
        // a per-episode delta would always read 0.  A line can only be replayed from a
        // peer's dialogue, so the total is the honest signal.
        if (wrote == false && epKind == 1 && held >= 1.5 && epIdle >= 2 && g_linesReal >= 1 &&
            epPd >= 1) {
            wrote = true;
            const std::string text = net::Fmt(
                "PASS dialogue: peer '%s' held %.1fs ; puppet idle samples=%d, replayed lines=%d, "
                "damage charges suppressed=%d, votes sent=%d, resolutions seen=%d\n",
                s.peer.name.c_str(), held, epIdle, g_linesReal, epPd, g_votesSent,
                g_resolutionsSeen);
            net::WriteFile("result_dialog.txt", text);
            std::string flat = text;
            while (!flat.empty() && (flat.back() == '\n' || flat.back() == '\r')) flat.pop_back();
            net::Log("%s", flat.c_str());
        }
        if (wrote == false && epKind == 2 && held >= 1.5 && epIdle >= 2 && epPd >= 1) {
            wrote = true;
            const std::string text = net::Fmt(
                "PASS cinematic lock: peer '%s' held %.1fs ; puppet idle samples=%d, damage "
                "charges suppressed=%d, replays started=%d (jumps=%d, stops=%d)\n",
                s.peer.name.c_str(), held, epIdle, epPd, g_replayStarts, g_replayJumps,
                g_replayStops);
            net::WriteFile("result_cine.txt", text);
            std::string flat = text;
            while (!flat.empty() && (flat.back() == '\n' || flat.back() == '\r')) flat.pop_back();
            net::Log("%s", flat.c_str());
        }
    } else if (epKind != 0) {
        net::Log("dialog: peer busy ended (kind=%d, idle samples=%d pd=%d)", epKind, epIdle, epPd);
        epKind = 0;
        g_pdAtStart = s.pdSkips;
    } else {
        static bool pdInit = false;
        if (!pdInit) {
            pdInit = true;
            g_pdAtStart = s.pdSkips;
        }
    }
}

