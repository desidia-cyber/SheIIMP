void CmdFakeImpl(const std::string& rest) {
    std::string arg = rest;
    while (!arg.empty() && (unsigned char)arg.back() <= ' ') arg.pop_back();
    if (arg == "off" || arg == "0" || arg.empty()) {
        g_fakeDlg = false;
        net::Log("dlgfake off: reporting the real dialogue state again");
        return;
    }
    g_fakeDlg = true;
    g_fakeDlgPath.clear();
    // accept BOTH `dlgfake <path>` and `dlgfake on <path>` (the harness writes the
    // second form); the path is the real dialogue asset the listener replays.
    std::string path = arg;
    if (path.rfind("on ", 0) == 0) path = path.substr(3);
    else if (path.rfind("1 ", 0) == 0) path = path.substr(2);
    while (!path.empty() && (unsigned char)path.front() <= ' ') path.erase(path.begin());
    if (path.rfind("/Game", 0) == 0) {
        g_fakeDlgPath = Clean(path, 190);
        g_fakeDlgName = Clean(path.substr(path.find_last_of('/') + 1));
        net::Log("dlgfake on: reporting a REAL dialogue asset '%s' (fake trigger)",
                 g_fakeDlgPath.c_str());
        return;
    }
    g_fakeDlgName = Clean(arg == "on" || arg == "1" ? "FAKE_DIALOGUE" : arg);
    net::Log("dlgfake on: reporting a dialogue '%s' path=%s (fake)", g_fakeDlgName.c_str(),
             g_fakeDlgPath.empty() ? "-" : g_fakeDlgPath.c_str());
}

void CmdCineFakeImpl(const std::string& rest) {
    std::string arg = rest;
    while (!arg.empty() && (unsigned char)arg.back() <= ' ') arg.pop_back();
    if (arg == "off" || arg == "0" || arg.empty()) {
        g_fakeCine = false;
        net::Log("cinefake off: reporting the real cinematic state again");
        return;
    }
    g_fakeCine = true;
    g_fakeCineName = Clean(arg == "on" || arg == "1" ? "FAKE_SEQUENCE" : arg);
    net::Log("cinefake on: reporting a cinematic '%s' (fake)", g_fakeCineName.c_str());
}

void CmdDumpImpl() {
    ue::UObject* ctx = nullptr;
    ue::UObject* asset = nullptr;
    ue::UObject* inst = nullptr;
    std::string owner;
    const bool dlg = ActiveDialogue(&ctx, &asset, &inst, &owner);
    std::vector<ue::UObject*> cine = ue::FindAllOf("BP_CinematicPlayer_C");
    int playing = 0;
    std::string seqName;
    for (ue::UObject* a : cine) {
        if (!Valid(a)) continue;
        ue::UObject* cut = nullptr;
        if (!ue::Get<ue::UObject*>(a, "CutsceneActor", cut) || !Valid(cut)) continue;
        ++playing;
        ue::UObject* sa = nullptr;
        if (seqName.empty() && ue::Get<ue::UObject*>(a, "LevelSequenceToPlay", sa) && Valid(sa)) {
            seqName = net::NameOf(sa);
        }
    }
    std::string choice;
    ReadChoice(&choice);
    net::Log("dlgdump: subsystem=%s arr=%s dialogue=%d name=%s node=%d opts=%d owner=%s path=%s "
             "cinematicPlayers=%d playing=%d seqName=%s hudWidget=%d PlayerChoice=%s",
             Valid(g_dlgSub) ? net::NameOf(g_dlgSub).c_str() : "-", Valid(g_dlgSub) ? "ok" : "missing",
             dlg ? 1 : 0, dlg && Valid(asset) ? net::NameOf(asset).c_str() : "-",
             g_node, g_opts, owner.empty() ? "-" : owner.c_str(),
             g_dlgPath.empty() ? "-" : g_dlgPath.c_str(), (int)cine.size(), playing,
             seqName.empty() ? "-" : seqName.c_str(), Valid(HudDialogueWidget()) ? 1 : 0,
             choice.empty() ? "-" : choice.c_str());
    net::Log("dlgdump: %s", dialog::Status().c_str());
}

// dlgstart [class] -- the GAME's own conversation start on the nearest dialogue
// actor (ABP_DialogueActor_C / ABP_NPC_C subclass: DlgDialogue @0x148).
void CmdStartImpl(const std::string& rest) {
    std::string want = rest;
    while (!want.empty() && (unsigned char)want.back() <= ' ') want.pop_back();
    if (want.empty()) want = "BP_Cultist_HUB_C";
    std::vector<ue::UObject*> list = ue::FindAllOf(want.c_str());
    if (list.empty()) {
        net::Log("dlgstart: no actor of class '%s' in this world", want.c_str());
        return;
    }
    ue::UObject* pawn = net::Pawn();
    const Vec3 me = net::Loc(pawn);
    ue::UObject* best = nullptr;
    double bestD = 1.0e30;
    for (ue::UObject* a : list) {
        if (!Valid(a)) continue;
        const double d = Dist(me, net::Loc(a));
        if (d < bestD) {
            bestD = d;
            best = a;
        }
    }
    if (!Valid(best)) {
        net::Log("dlgstart: no valid actor of class '%s'", want.c_str());
        return;
    }
    g_pendingNpc = best;
    ue::UObject* comp = nullptr;
    if (!ue::Get<ue::UObject*>(best, "Dialogue Instigator Component", comp) || !Valid(comp)) {
        net::Log("dlgstart: %s has no Dialogue Instigator Component", net::NameOf(best).c_str());
        return;
    }
    ue::UObject* asset = nullptr;
    ue::Get<ue::UObject*>(comp, "DlgDialogue", asset);
    net::Log("dlgstart: npc=%s dist=%.0f dialogue=%s", net::NameOf(best).c_str(), bestD,
             Valid(asset) ? net::NameOf(asset).c_str() : "-");
    g_pendingStart = comp;
    g_startNpc = best;
    g_startPhase = 1;
    g_startPhaseAt = Now() + 0.3;
    // The game's own participant check is a distance check (11 794 uu -> Success=0).
    // The verb is a TEST HOOK, so it puts the caller next to the NPC first.
    if (bestD > 400.0 && Valid(pawn)) {
        const Vec3 npc = net::Loc(best);
        const Vec3 me = net::Loc(pawn);
        const double dx = me.X - npc.X, dy = me.Y - npc.Y;
        const double len = std::sqrt(dx * dx + dy * dy);
        const double k = (len > 1.0) ? 160.0 / len : 0.0;
        puppet::StartTp(pawn, npc.X + dx * k, npc.Y + dy * k, npc.Z);
        net::Log("dlgstart: teleported the caller next to the NPC (%.0f uu -> ~160 uu)", bestD);
        return;
    }
    StartConversation(comp, asset);
}

void CmdStopImpl() {
    ue::UObject* ctx = nullptr;
    ue::UObject* asset = nullptr;
    ue::UObject* inst = nullptr;
    std::string owner;
    if (!ActiveDialogue(&ctx, &asset, &inst, &owner) || !Valid(inst)) {
        net::Log("dlgstop: no active dialogue");
        return;
    }
    Fn c(inst, "StopDialogue");
    bool ok = false;
    if (c.ok()) {
        c.set<bool>("bStopAudioImmediately", false);
        ok = c.run();
    }
    net::Log("dlgstop: StopDialogue on %s ok=%d", net::NameOf(inst).c_str(), ok ? 1 : 0);
}

// dlgvote <option> -- the vote channel (the test hook the DIALOG verdict uses; on
// the owner a real UI click reaches the same table through the intercept hook).
void CmdVoteImpl(const std::string& rest) {
    std::string arg = rest;
    while (!arg.empty() && (unsigned char)arg.front() <= ' ') arg.erase(arg.begin());
    const int opt = (int)strtol(arg.c_str(), nullptr, 10) - 1;
    const bool owner = g_mine.active && g_mine.kind == 1;
    const bool listener = D().peer.active && D().peer.kind == 1 && dialog::PeerLocked() && !owner;
    if (!owner && !listener) {
        net::Log("dlgvote: no conversation to vote in (owner=%d listener=%d)", owner ? 1 : 0,
                 listener ? 1 : 0);
        return;
    }
    const int dseq = owner ? g_dseq : D().peer.seq;
    const int node = owner ? g_node : D().peer.node;
    const int opts = owner ? g_opts : D().peer.opts;
    if (opt < 0 || (opts > 0 && opt >= opts)) {
        net::Log("dlgvote: option %d is out of range (node has %d)", opt + 1, opts);
        return;
    }
    g_myVoteSeq = dseq;
    g_myVoteNode = node;
    g_myVoteOpt = opt;
    g_myVoteAt = Now();
    ++g_votesSent;
    net::Log("dlgvote: %s votes option %d at node %d (dseq=%d)", St().local.me.c_str(), opt + 1,
             node, dseq);
    if (owner) {
        VoteTally& vt = g_votes[VoteKey(dseq, node)];
        if (vt.openedAt == 0.0) {
            vt.openedAt = Now();
            vt.opts = opts;
            vt.assetPath = g_dlgPath;
        }
        vt.byPlayer[St().local.me] = opt;
    }
}

