std::string Clean(const std::string& s, std::size_t maxLen = 60) {
    std::string v = s;
    if (v.size() > maxLen) v.resize(maxLen);
    for (char& c : v) {
        if (c == '"' || c == '\\' || c == '|' || (unsigned char)c < ' ') c = '_';
    }
    return v;
}

std::vector<std::string> Tokens(const std::string& sec) {
    std::vector<std::string> out;
    std::string cur;
    bool inStr = false;
    bool any = false;
    for (std::size_t i = 0; i < sec.size(); ++i) {
        const char c = sec[i];
        if (inStr) {
            if (c == '"') {
                inStr = false;
            } else {
                cur.push_back(c);
            }
            continue;
        }
        if (c == '"') {
            inStr = true;
            any = true;
            continue;
        }
        if (c == ',') {
            out.push_back(cur);
            cur.clear();
            any = false;
            continue;
        }
        if (c == '[' || c == ']' || (unsigned char)c <= ' ') continue;
        cur.push_back(c);
        any = true;
    }
    if (any || !cur.empty()) out.push_back(cur);
    return out;
}

int ToInt(const std::string& s, int def) {
    if (s.empty()) return def;
    char* stop = nullptr;
    const long v = strtol(s.c_str(), &stop, 10);
    if (stop == s.c_str()) return def;
    return (int)v;
}

struct ObjArr {
    void* data = nullptr;
    i32 num = 0;
    i32 max = 0;
};

bool ReadArr(ue::UObject* o, const char* prop, i32 fallbackOff, ObjArr* out) {
    if (out) *out = ObjArr();
    if (!Valid(o) || prop == nullptr) return false;
    i32 off = ue::PropOffset(o, prop);
    if (off < 0) off = fallbackOff;
    if (off < 0) return false;
    ObjArr a;
    if (!ue::ReadMem(reinterpret_cast<const std::uint8_t*>(o) + off, &a, sizeof(a))) return false;
    if (a.num < 0 || a.num > 4096 || a.max < a.num || a.max > 65536 || a.data == nullptr) return false;
    if (!ue::PlausiblePtr(a.data)) return false;
    if (out) *out = a;
    return true;
}

class Fn {
public:
    Fn(ue::UObject* obj, const char* name) {
        if (!Valid(obj) || name == nullptr) return;
        obj_ = obj;
        fn_ = ue::FindFunction(obj, name);
        if (fn_ != nullptr) p_ = new ue::Params(fn_);
    }
    ~Fn() { delete p_; }
    Fn(const Fn&) = delete;
    Fn& operator=(const Fn&) = delete;

    bool ok() const { return obj_ != nullptr && fn_ != nullptr && p_ != nullptr; }
    bool run() { return ok() && ue::Call(obj_, fn_, p_->data()); }

    template <class T>
    void set(const char* n, const T& v) {
        if (p_ != nullptr) p_->Set<T>(n, v);
    }
    template <class T>
    T get(const char* n) {
        T t{};
        if (p_ != nullptr) t = p_->Get<T>(n);
        return t;
    }

private:
    ue::UObject* obj_ = nullptr;
    ue::UFunction* fn_ = nullptr;
    ue::Params* p_ = nullptr;
};

struct TagContainerZero {
