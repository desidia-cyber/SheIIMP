bool TextFromString(const std::string& text, FTextRaw* out) {
    if (out) *out = FTextRaw();
    if (text.empty()) return false;
    const ue::FName n = ue::MakeName(text.c_str());
    if (ue::ToString(n) == "None") return false;
    ue::UObject* sl = ue::FindObject("/Script/Engine.Default__KismetStringLibrary");
    if (!Valid(sl)) sl = ue::FindObject("KismetStringLibrary");
    if (!Valid(sl)) return false;
    ue::UObject* tl = ue::FindObject("/Script/Engine.Default__KismetTextLibrary");
    if (!Valid(tl)) tl = ue::FindObject("KismetTextLibrary");
    if (!Valid(tl)) return false;

    Fn toStr(sl, "Conv_NameToString");
    if (!toStr.ok()) return false;
    toStr.set<ue::FName>("InName", n);
    if (!toStr.run()) return false;
    const ue::FString fs = toStr.get<ue::FString>("ReturnValue");
    if (fs.Data == nullptr || fs.Num <= 0) return false;

    Fn toText(tl, "Conv_StringToText");
    if (!toText.ok()) return false;
    toText.set<ue::FString>("InString", fs);
    if (!toText.run()) return false;
    const FTextRaw t = toText.get<FTextRaw>("ReturnValue");
    if (t.w[0] == 0) return false;
    if (out) *out = t;
    return true;
}

// On-screen line for a LISTENER, the engine's own path: UKismetSystemLibrary::
// PrintString draws it for `Duration` seconds in the HUD layer.  It is the fallback
// that cannot be defeated by the dialogue widget's own visibility state (the round
// 7b capture showed the text was APPLIED to CRT_DialogueSubtitles but the hidden
// HUD dialogue widget did not reveal it).
bool PrintLine(const std::string& text) {
    if (text.empty()) return false;
    ue::UObject* ks = ue::FindObject("/Script/Engine.Default__KismetSystemLibrary");
    if (!Valid(ks)) ks = ue::FindObject("KismetSystemLibrary");
    if (!Valid(ks)) return false;
    FTextRaw unused;   // (not used: PrintString takes an FString)
    (void)unused;
    const ue::FName n = ue::MakeName(text.c_str());
    if (ue::ToString(n) == "None") return false;
    ue::UObject* sl = ue::FindObject("/Script/Engine.Default__KismetStringLibrary");
    if (!Valid(sl)) sl = ue::FindObject("KismetStringLibrary");
    if (!Valid(sl)) return false;
    Fn toStr(sl, "Conv_NameToString");
    if (!toStr.ok()) return false;
    toStr.set<ue::FName>("InName", n);
    if (!toStr.run()) return false;
    const ue::FString fs = toStr.get<ue::FString>("ReturnValue");
    if (fs.Data == nullptr || fs.Num <= 0) return false;
    Fn print(ks, "PrintString");
    if (!print.ok()) return false;
    ue::UObject* ctx = net::PC();
    if (!Valid(ctx)) ctx = net::World();
    print.set<ue::UObject*>("WorldContextObject", ctx);
    print.set<ue::FString>("InString", fs);
    print.set<bool>("bPrintToScreen", true);
    print.set<bool>("bPrintToLog", false);
    struct FLinearColorRaw {
        float r, g, b, a;
    } color = {1.0f, 0.95f, 0.6f, 1.0f};
    print.set<FLinearColorRaw>("TextColor", color);
    print.set<float>("Duration", 6.0f);
    return print.run();
}

// The game's own SUBTITLE widget: WBP_Subtitle_Base_C (dump: Text_Subtitle @0x348,
// UpdateText(FText), ToggleSubtitle(bool,FText)).  This is where the game paints the
// line it speaks, and it accepts an FText BY VALUE -- so the listener can hand it the
// node's own FText (no string of ours) and the line shows exactly like the game's.
// Create the game's subtitle widget when this world has none:
// UWidgetBlueprintLibrary::Create(WorldContextObject, WidgetType: TSubclassOf<UUserWidget>,
// OwningPlayer) -> UUserWidget* (UMG.hpp:2227).  The class object comes from an existing
// instance when there is one, else from the object array by bare name.
ue::UObject* CreateSubtitleWidget() {
    ue::UObject* cls = nullptr;
    std::vector<ue::UObject*> existing = ue::FindAllOf("WBP_Subtitle_Base_C");
    for (ue::UObject* c : existing) {
        if (!Valid(c)) continue;
        if (ue::Get<ue::UObject*>(c, "Class", cls) && Valid(cls)) break;
        cls = nullptr;
    }
    if (!Valid(cls)) cls = ue::FindObject("WBP_Subtitle_Base_C");
    if (!Valid(cls)) {
        net::Log("dlg: cannot create a subtitle widget -- WBP_Subtitle_Base_C class not found");
        return nullptr;
    }
    ue::UObject* pc = net::PC();
    ue::UObject* lib = ue::FindObject("/Script/UMG.Default__WidgetBlueprintLibrary");
    if (!Valid(lib)) lib = ue::FindObject("WidgetBlueprintLibrary");
    if (!Valid(lib)) return nullptr;
    Fn create(lib, "Create");
    if (!create.ok()) return nullptr;
    create.set<ue::UObject*>("WorldContextObject", pc);
    create.set<ue::UObject*>("WidgetType", cls);
    create.set<ue::UObject*>("OwningPlayer", pc);
    if (!create.run()) return nullptr;
    ue::UObject* w = create.get<ue::UObject*>("ReturnValue");
    if (!Valid(w)) return nullptr;
    Fn add(w, "AddToViewport");
    if (add.ok()) {
        add.set<i32>("ZOrder", 30);
        add.run();
    }
    net::Log("dlg: CREATED a WBP_Subtitle_Base_C for the listener (class=%s)",
             net::NameOf(cls).c_str());
    return w;
}

// Prefer a subtitle widget that is actually ON SCREEN; the hub has one instance that
// exists but is not in the viewport (measured: UpdateText returned 1 and nothing was
// drawn), so a fresh one is created and added instead.
ue::UObject* PickSubtitleWidget(int* createdOut, int* seenOut) {
    if (createdOut) *createdOut = 0;
    std::vector<ue::UObject*> list = ue::FindAllOf("WBP_Subtitle_Base_C");
    if (seenOut) *seenOut = (int)list.size();
    for (ue::UObject* c : list) {
        if (!Valid(c)) continue;
        Fn inView(c, "IsInViewport");
        if (inView.ok() && inView.run() && inView.get<bool>("ReturnValue")) return c;
    }
    if (ue::UObject* made = CreateSubtitleWidget()) {
        if (createdOut) *createdOut = 1;
        return made;
    }
    for (ue::UObject* c : list) {
        if (Valid(c)) return c;
    }
    return nullptr;
}

bool ShowSubtitleFText(const FTextRaw& t, const std::string& forLog) {
    if (t.w[0] == 0) return false;
    int created = 0;
    int seen = 0;
    ue::UObject* w = PickSubtitleWidget(&created, &seen);
    std::vector<ue::UObject*> list = ue::FindAllOf("WBP_Subtitle_Base_C");
    bool ok = false;
    if (Valid(w)) {
        Fn font(w, "SetupFont");
        if (font.ok()) font.run();
        Fn toggle(w, "ToggleSubtitle");
        if (toggle.ok()) {
            toggle.set<bool>("bIsVisible", true);
            toggle.set<FTextRaw>("SubtitleText", t);
            ok = toggle.run();
        }
        if (!ok) {
            Fn upd(w, "UpdateText");
            if (upd.ok()) {
                upd.set<FTextRaw>("SubtitleText", t);
                ok = upd.run();
            }
        }
        if (!ok) {
            ue::UObject* block = nullptr;
            if (ue::Get<ue::UObject*>(w, "Text_Subtitle", block) && Valid(block)) {
                Fn set(block, "SetText");
                if (set.ok()) {
                    set.set<FTextRaw>("InText", t);
                    ok = set.run();
                }
            }
        }
        // make the widget itself visible without stealing input
        Fn vis(w, "SetVisibility");
        if (vis.ok()) {
            vis.set<std::uint8_t>("InVisibility", 3);
            vis.run();
        }
        Fn inView(w, "IsInViewport");
        if (inView.ok() && inView.run() && !inView.get<bool>("ReturnValue")) {
            Fn addv(w, "AddToViewport");
            if (addv.ok()) {
                addv.set<i32>("ZOrder", 30);
                addv.run();
            }
        }
    }
    if (g_subLogs < 8) {
        ++g_subLogs;
        bool inView = false;
        if (Valid(w)) {
            Fn iv(w, "IsInViewport");
            if (iv.ok() && iv.run()) inView = iv.get<bool>("ReturnValue");
        }
        net::Log("dlg: subtitle via %s -> %s (%d instance(s), created=%d, inViewport=%d, "
                 "update=%d) [%s]", Valid(w) ? "WBP_Subtitle_Base_C" : "nothing",
                 ok ? "shown" : "FAILED", (int)list.size(), created, inView ? 1 : 0,
                 ok ? 1 : 0, forLog.substr(0, 48).c_str());
    }
    return ok;
}

bool ShowSubtitle(const std::string& text) {
    if (text.empty() || !TG().dlgEnabled) return false;
    ue::UObject* w = HudDialogueWidget();
    if (!Valid(w)) {
        if (g_subLogs < 2) {
            ++g_subLogs;
            net::Log("dlg: no WBP_HUD_Dialogue_C instance in this world -- the peer's line "
                     "cannot be shown as a subtitle here (the voice still plays)");
        }
        return false;
    }
    ue::UObject* block = nullptr;
    if (!ue::Get<ue::UObject*>(w, "CRT_DialogueSubtitles", block) || !Valid(block)) {
        if (g_subLogs < 2) {
            ++g_subLogs;
            net::Log("dlg: %s has no CRT_DialogueSubtitles -- no subtitle block",
                     net::NameOf(w).c_str());
        }
        return false;
    }
    FTextRaw t;
    const bool haveText = TextFromString(text, &t);
    bool ok = false;
    if (haveText) {
        Fn set(block, "SetText");
        if (set.ok()) {
            set.set<FTextRaw>("InText", t);
            ok = set.run();
        }
        if (!ok) {
            // fall back to the widget's own Text property (UTextBlock::Text)
            const i32 off = ue::PropOffset(block, "Text");
            if (off >= 0) {
                ok = ue::WriteMem(reinterpret_cast<std::uint8_t*>(block) + off, &t, sizeof(t));
            }
        }
    }
    // make the widget itself visible without stealing input (ESlateVisibility 3)
    Fn vis(w, "SetVisibility");
    if (vis.ok()) {
        vis.set<std::uint8_t>("InVisibility", 3);
        vis.run();
    }
    Fn inView(w, "IsInViewport");
    if (inView.ok() && inView.run() && !inView.get<bool>("ReturnValue")) {
        Fn add(w, "AddToViewport");
        if (add.ok()) {
            add.set<i32>("ZOrder", 20);
            add.run();
        }
    }
    // the listener must SEE the line even when the dialogue HUD is not visible
    const bool printed = PrintLine(text);
    if (ok || printed) {
        g_subShown = true;
        g_subText = text;
    } else if (g_subLogs < 3) {
        ++g_subLogs;
        net::Log("dlg: subtitle '%s' could not be applied to the block (%d bytes of text)",
                 text.substr(0, 40).c_str(), (int)text.size());
    }
    return ok;
}

void HideSubtitle() {
    if (!g_subShown) return;
    g_subShown = false;
    g_subText.clear();
    ue::UObject* w = HudDialogueWidget();
    if (!Valid(w)) return;
    Fn clear(w, "ClearSubtitles");
    if (clear.ok()) clear.run();
}

