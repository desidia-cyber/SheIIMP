namespace {

// --- string helpers --------------------------------------------------------

bool StartsWith(const std::string& s, const char* p) {
    const size_t n = strlen(p);
    return s.size() >= n && s.compare(0, n, p) == 0;
}

bool Contains(const std::string& s, const char* p) {
    return s.find(p) != std::string::npos;
}

std::string Trim(const std::string& s) {
    size_t a = 0, b = s.size();
    while (a < b && (unsigned char)s[a] <= ' ') ++a;
    while (b > a && (unsigned char)s[b - 1] <= ' ') --b;
    return s.substr(a, b - a);
}

// main.lua:66 `p:gsub("%s", "")` -- every whitespace character, not just ends.
std::string StripAllSpace(const std::string& s) {
    std::string out;
    out.reserve(s.size());
    for (char c : s) {
        if ((unsigned char)c > ' ') out.push_back(c);
    }
    return out;
}

const char* PhaseName(Phase p) {
    switch (p) {
    case Phase::Menu:   return "menu";
    case Phase::World:  return "world";
    case Phase::Summon: return "summon";
    case Phase::Adopt:  return "adopt";
    case Phase::Sync:   return "sync";
    }
    return "menu";
}

// --- text encoding --------------------------------------------------------

std::wstring Widen(const std::string& s) {
    if (s.empty()) return std::wstring();
    // UTF-8 first (a hand-edited config), then the ANSI code page (what
    // deploy.ps1 -Encoding ASCII and run-two.ps1 actually write).
    int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, s.c_str(), (int)s.size(), nullptr, 0);
    UINT cp = CP_UTF8;
    if (n <= 0) {
        cp = CP_ACP;
        n = MultiByteToWideChar(CP_ACP, 0, s.c_str(), (int)s.size(), nullptr, 0);
    }
    if (n <= 0) return std::wstring();
    std::wstring w((size_t)n, L'\0');
    MultiByteToWideChar(cp, cp == CP_UTF8 ? MB_ERR_INVALID_CHARS : 0, s.c_str(), (int)s.size(), &w[0], n);
    return w;
}

std::string Narrow(const std::wstring& w) {
    if (w.empty()) return std::string();
    int n = WideCharToMultiByte(CP_ACP, 0, w.c_str(), (int)w.size(), nullptr, 0, nullptr, nullptr);
    if (n <= 0) return std::string();
    std::string s((size_t)n, '\0');
    WideCharToMultiByte(CP_ACP, 0, w.c_str(), (int)w.size(), &s[0], n, nullptr, nullptr);
    return s;
}

// --- module / exe directory ----------------------------------------------

std::string ModuleDir() {
    HMODULE hm = nullptr;
    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
                                GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
                            (LPCWSTR)(const void*)&ModuleDir, &hm) ||
        !hm) {
        return std::string();
    }
    wchar_t path[MAX_PATH * 2] = L"";
    const DWORD n = GetModuleFileNameW(hm, path, (DWORD)(sizeof(path) / sizeof(path[0])));
    if (n == 0) return std::string();
    std::wstring w(path, n);
    const size_t slash = w.find_last_of(L"\\/");
    if (slash != std::wstring::npos) w.resize(slash);
    return Narrow(w);
}

std::string ExeDir() {
    wchar_t path[MAX_PATH * 2] = L"";
    const DWORD n = GetModuleFileNameW(nullptr, path, (DWORD)(sizeof(path) / sizeof(path[0])));
    if (n == 0) return std::string();
    std::wstring w(path, n);
    const size_t slash = w.find_last_of(L"\\/");
    if (slash != std::wstring::npos) w.resize(slash);
    return Narrow(w);
}

// --- guarded Win32 file IO ------------------------------------------------

HANDLE OpenForRead(const std::wstring& path) {
    return CreateFileW(path.c_str(), GENERIC_READ,
                       FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
                       OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
}

// Reads the first line of `path` exactly like Lua's f:read("*l") in text mode:
// up to '\n', no '\n', and no trailing '\r'.  Returns false when the file
// cannot be opened (Lua returns nil then).
bool ReadFirstLinePath(const std::string& path, std::string* out) {
    if (out) out->clear();
    const std::wstring w = Widen(path);
    if (w.empty()) return false;
    HANDLE h = OpenForRead(w);
    if (h == INVALID_HANDLE_VALUE) return false;

    std::string line;
    char buf[4096];
    bool gotAny = false;
    for (;;) {
        DWORD got = 0;
        if (!ReadFile(h, buf, (DWORD)sizeof(buf), &got, nullptr) || got == 0) break;
        gotAny = true;
        const char* nl = (const char*)memchr(buf, '\n', got);
        if (nl) {
            line.append(buf, (size_t)(nl - buf));
            break;
        }
        line.append(buf, got);
        if (line.size() > 65536) break;   // a state line is ~4 KB; do not chase a binary
    }
    CloseHandle(h);
    if (!gotAny) return true;             // opened, empty: Lua yields nil here and callers check the length
    if (!line.empty() && line.back() == '\r') line.pop_back();
    if (out) *out = line;
    return true;
}

// Reads the whole file as bytes.  Used by cmd.txt (every line is a command) and
// by the world-state ledger through net::ReadText (one key per line), which
// coop_world declares as its CONTRACT-REQUEST 1.
bool ReadWholeText(const std::string& path, std::string* out) {
    if (out) out->clear();
    const std::wstring w = Widen(path);
    if (w.empty()) return false;
    HANDLE h = OpenForRead(w);
    if (h == INVALID_HANDLE_VALUE) return false;
    std::string all;
    char buf[8192];
    for (;;) {
        DWORD got = 0;
        if (!ReadFile(h, buf, (DWORD)sizeof(buf), &got, nullptr) || got == 0) break;
        all.append(buf, got);
        if (all.size() > (4u << 20)) break;   // no legitimate file here is that big
    }
    CloseHandle(h);
    if (out) *out = std::move(all);
    return true;
}

bool WriteWholeFile(const std::wstring& path, const std::string& text) {
    if (path.empty()) return false;
    HANDLE h = CreateFileW(path.c_str(), GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
                           nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (h == INVALID_HANDLE_VALUE) return false;
    bool ok = true;
    size_t off = 0;
    while (off < text.size()) {
        DWORD wrote = 0;
        const DWORD chunk = (DWORD)((text.size() - off) > 0x10000 ? 0x10000 : (text.size() - off));
        if (!WriteFile(h, text.data() + off, chunk, &wrote, nullptr) || wrote == 0) { ok = false; break; }
        off += wrote;
    }
    CloseHandle(h);
    return ok;
}

bool AppendToFile(const std::wstring& path, const std::string& text) {
    if (path.empty()) return false;
    HANDLE h = CreateFileW(path.c_str(), FILE_APPEND_DATA,
                           FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
                           OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (h == INVALID_HANDLE_VALUE) return false;
    DWORD wrote = 0;
    bool ok = true;
    if (!text.empty()) {
        ok = WriteFile(h, text.data(), (DWORD)text.size(), &wrote, nullptr) && wrote == text.size();
        if (ok) FlushFileBuffers(h);      // the harness tails this file live
    }
    CloseHandle(h);
    return ok;
}

// --- printf-family formatting (C locale: '%f' always uses '.') -------------

// One pass, stack only: every call site here formats a log line or a wire field,
// never a document.  _vsnprintf_s with _TRUNCATE returns what it wrote, so a
// too-long line is cut instead of throwing.
void FormatV(std::string* out, const char* fmt, va_list ap) {
    if (!fmt || !out) return;
    char buf[8192];
    buf[0] = 0;
    const int n = _vsnprintf_s(buf, sizeof(buf), _TRUNCATE, fmt, ap);
    if (n > 0) out->append(buf, (size_t)n);
}

// ===========================================================================
// guarded ue:: access -- the only place this module touches engine objects
// ===========================================================================
namespace uecall {

// UFunction lookup cache: key = "<class name>|<function name>".
struct FuncSlot {
    std::string key;
    ue::UFunction* fn;
};
std::vector<FuncSlot> g_fnCache;

ue::UFunction* Func(ue::UObject* o, const char* name) {
    if (!o || !name) return nullptr;
    const std::string key = ue::GetClassName(o) + "|" + name;
    for (const FuncSlot& s : g_fnCache) {
        if (s.key == key) return s.fn;
    }
    ue::UFunction* fn = ue::FindFunction(o, name);
    FuncSlot slot;
    slot.key = key;
    slot.fn = fn;
    g_fnCache.push_back(slot);   // a null result is cached too: no MISS storms
    return fn;
}

bool HasParam(ue::UFunction* fn, const char* name) {
    if (!fn || !name) return false;
    return ue::FindProperty((ue::UStruct*)fn, name) != nullptr;
}

// The first of `names` that the function actually declares.
const char* PickParam(ue::UFunction* fn, const char* const* names, size_t n) {
    for (size_t i = 0; i < n; ++i) {
        if (HasParam(fn, names[i])) return names[i];
    }
    return nullptr;
}

bool CallVoid(ue::UObject* o, const char* fnName) {
    if (!ue::IsValid(o)) return false;
    ue::UFunction* fn = Func(o, fnName);
    if (!fn) return false;
    ue::Params p(fn);
    return ue::Call(o, fn, p.data());
}

bool CallVec(ue::UObject* o, const char* fnName, ue::FVector* out) {
    if (!ue::IsValid(o) || !out) return false;
    ue::UFunction* fn = Func(o, fnName);
    if (!fn) return false;
    ue::Params p(fn);
    if (!ue::Call(o, fn, p.data())) return false;
    *out = p.Get<ue::FVector>("ReturnValue");
    return true;
}

bool CallRot(ue::UObject* o, const char* fnName, ue::FRotator* out) {
    if (!ue::IsValid(o) || !out) return false;
    ue::UFunction* fn = Func(o, fnName);
    if (!fn) return false;
    ue::Params p(fn);
    if (!ue::Call(o, fn, p.data())) return false;
    *out = p.Get<ue::FRotator>("ReturnValue");
    return true;
}

// Calls o.fn(<one UObject* parameter>) with the parameter named from `names`.
// Never calls the function when no candidate name exists: a null argument in a
// BP function is exactly the kind of input that takes this game down.
bool CallWithObject(ue::UObject* o, const char* fnName, ue::UObject* arg,
                    const char* const* names, size_t n) {
    if (!ue::IsValid(o)) return false;
    ue::UFunction* fn = Func(o, fnName);
    if (!fn) return false;
    const char* pname = PickParam(fn, names, n);
    if (!pname) return false;
    ue::Params p(fn);
    p.Set<ue::UObject*>(pname, arg);
    return ue::Call(o, fn, p.data());
}

// Read a UObject* out of a property, validated.
ue::UObject* PropObj(ue::UObject* o, const char* prop) {
    if (!ue::IsValid(o)) return nullptr;
    ue::UObject* p = nullptr;
    if (!ue::Get<ue::UObject*>(o, prop, p)) return nullptr;
    return ue::IsValid(p) ? p : nullptr;
}

// Read an integer property whose width the reflection knows (enums are 1 byte).
bool PropInt(ue::UObject* o, const char* prop, int64_t* out) {
    if (!ue::IsValid(o) || !out) return false;
    const int32_t sz = ue::PropSize(o, prop);
    if (sz == 1) {
        uint8_t v = 0;
        if (!ue::Get<uint8_t>(o, prop, v)) return false;
        *out = (int64_t)v;
        return true;
    }
    if (sz == 2) {
        int16_t v = 0;
        if (!ue::Get<int16_t>(o, prop, v)) return false;
        *out = (int64_t)v;
        return true;
    }
    if (sz == 4) {
        int32_t v = 0;
        if (!ue::Get<int32_t>(o, prop, v)) return false;
        *out = (int64_t)v;
        return true;
    }
    if (sz == 8) {
        int64_t v = 0;
        if (!ue::Get<int64_t>(o, prop, v)) return false;
        *out = v;
        return true;
    }
    return false;
}

}  // namespace uecall

// A `/Script/Engine.Default__<Class>` helper object (the CDO), cached.
struct CdoSlot {
    std::string path;
    ue::UObject* obj;
};
std::vector<CdoSlot> g_cdoCache;

ue::UObject* HelperCdo(const char* path) {
    if (!path) return nullptr;
    for (CdoSlot& s : g_cdoCache) {
        if (s.path != path) continue;
        // A CDO never dies, so a hit is permanent.  A MISS is retried: the helper
        // classes belong to packages that can finish loading after this runs, and a
        // cached nullptr would disable the feature that asked for it for the whole
        // session (ue::FindObject only remembers a miss for 2 s for the same reason).
        if (s.obj && ue::PlausiblePtr(s.obj)) return s.obj;
        s.obj = ue::FindObject(path);
        return s.obj;
    }
    ue::UObject* o = ue::FindObject(path);
    CdoSlot slot;
    slot.path = path;
    slot.obj = o;
    g_cdoCache.push_back(slot);
    return o;
}

ue::UObject* KismetSystemLibrary() {
    return HelperCdo("/Script/Engine.Default__KismetSystemLibrary");
}

ue::UObject* GameplayStatics() {
    return HelperCdo("/Script/Engine.Default__GameplayStatics");
}

// --- world / player controller / pawn ------------------------------------

ue::UObject* g_world = nullptr;
ue::UObject* g_pc = nullptr;
// The CLASS each cache was resolved from.  A UObject address can be RECYCLED: when
// the menu world and its PlayerController are destroyed on ContinueGame, the engine
// reuses those addresses, and ue::IsValid(g_world) keeps returning true because the
// slot points at the new object.  The cache then names a light-preset world and a
// Niagara component (exactly what the second launch logged), the pawn lookup reads
// "Pawn" off whatever now lives there, and boot waits for gameplay forever.  Class
// pointers are stable for the process, so comparing them detects the recycle.
ue::UClass* g_worldClass = nullptr;
ue::UClass* g_pcClass = nullptr;
// The world object net::Frame last saw: a change means a map load (or the death
// reload) and every cached ue::UObject* has to go.  g_worldSeen keeps the very
// first resolution (null -> world at boot) out of that path.
ue::UObject* g_lastWorld = nullptr;
bool g_worldSeen = false;

bool IsWorldClass(ue::UObject* o) {
    return o && ue::GetClassName(o) == "World";
}

// Is the cached pointer still the same KIND of object it was resolved as?
bool WorldOk() {
    if (g_world == nullptr || !ue::IsValid(g_world) || g_worldClass == nullptr ||
        ue::GetClass(g_world) != g_worldClass)
        return false;
    // The class pointer itself must be a World class (see ResolveWorldAndPc).
    // Checked once per resolved class, not per call.
    static ue::UClass* s_checked = nullptr;
    static bool s_isWorld = false;
    if (s_checked != g_worldClass) {
        ue::UClass* worldCls = ue::FindClass("World");
        s_isWorld = worldCls && ue::IsA(g_world, worldCls);
        s_checked = g_worldClass;
        if (!s_isWorld)
            ms2::Logf("net: cached world %s is not a World -- re-resolving",
                      ue::GetFullName(g_world).c_str());
    }
    return s_isWorld;
}

bool PcOk() {
    return g_pc != nullptr && ue::IsValid(g_pc) &&
           g_pcClass != nullptr && ue::GetClass(g_pc) == g_pcClass;
}

// UGameplayStatics::GetPlayerController(world, 0) -- the same object
// UEHelpers.GetPlayerController() gave the Lua.
ue::UObject* GetPlayerControllerFor(ue::UObject* world, int32_t index) {
    ue::UObject* gs = GameplayStatics();
    if (!gs || !ue::IsValid(world)) return nullptr;
    ue::UFunction* fn = uecall::Func(gs, "GetPlayerController");
    if (!fn) return nullptr;
    static const char* kWorldParams[] = {"WorldContextObject", "WorldContext"};
    const char* wp = uecall::PickParam(fn, kWorldParams, 2);
    if (!wp) return nullptr;
    ue::Params p(fn);
    p.Set<ue::UObject*>(wp, world);
    p.Set<int32_t>("PlayerIndex", index);
    if (!ue::Call(gs, fn, p.data())) return nullptr;
    ue::UObject* pc = p.Get<ue::UObject*>("ReturnValue");
    // Which object answered, with which parameter block, is the difference between
    // "the call is fine and the game has no pawn yet" and "this call returns
    // nonsense"; three lines at boot settle it.
    static std::atomic<int> dbg{0};
    if (dbg.fetch_add(1) < 3) {
        ms2::Logf("pc-diag: gs=%s fn=%s size=%d worldParam=%s@%d playerIdx@%d ret@%d -> pc=%s",
                  ue::GetFullName(gs).c_str(), ue::GetFullName((ue::UObject*)fn).c_str(),
                  (int)p.size(), wp, (int)ue::PropOffsetStruct((ue::UStruct*)fn, wp),
                  (int)ue::PropOffsetStruct((ue::UStruct*)fn, "PlayerIndex"),
                  (int)ue::PropOffsetStruct((ue::UStruct*)fn, "ReturnValue"),
                  ue::GetFullName(pc).c_str());
    }
    return ue::IsValid(pc) ? pc : nullptr;
}

// Every live UWorld, best candidate first: the one that answers
// GetPlayerController.  Only runs when the cache is cold (boot, map load).
//
// The scan walks GObjects, so a *failed* scan is rate limited: at the main menu
// (or before the engine layer is fully usable) there may be no world yet, and
// Now() asks for one on every guarded step.  One attempt per second is plenty;
// a successful result is cached until the object dies.
uint64_t g_lastWorldScanMs = 0;
bool g_worldScanTried = false;

void ResolveWorldAndPc() {
    const uint64_t nowMs = GetTickCount64();
    if (g_worldScanTried && nowMs - g_lastWorldScanMs < 1000) return;
    g_worldScanTried = true;
    g_lastWorldScanMs = nowMs;

    g_world = nullptr;
    g_pc = nullptr;
    g_worldClass = nullptr;
    g_pcClass = nullptr;
    // FindAllOf goes through the object index, which can still hold a slot that the
    // engine has re-used for an unrelated object since the last verification sweep.
    // Accepting such an entry as "the world" poisoned the cache for the whole
    // session (g_worldClass became e.g. SoundNodeWavePlayer, so WorldOk() kept
    // agreeing with itself).  Re-check every candidate's class here.
    std::vector<ue::UObject*> worlds;
    {
        ue::UClass* worldCls = ue::FindClass("World");
        for (ue::UObject* w : ue::FindAllOf("World"))
            if (ue::IsValid(w) && worldCls && ue::IsA(w, worldCls)) worlds.push_back(w);
    }
    ue::UObject* firstWorld = nullptr;
    ue::UObject* exactWorld = nullptr;
    for (ue::UObject* w : worlds) {
        if (!firstWorld) firstWorld = w;
        if (exactWorld) continue;
        // This game has more than one UWorld in GObjects: the real gameplay world
        // and lighting-preset sub-levels (class SpartaLightPreset, also a World
        // subclass).  Both answer GetPlayerController, so take an object whose own
        // class is EXACTLY World first -- otherwise the module picks a light
        // preset as "the world" and every world-change check thrashes.
        if (IsWorldClass(w)) exactWorld = w;
    }
    for (ue::UObject* w : worlds) {
        if (!IsWorldClass(w)) continue;
        if (ue::UObject* pc = GetPlayerControllerFor(w, 0)) {
            g_world = w;
            g_worldClass = ue::GetClass(w);
            g_pc = pc;
            g_pcClass = ue::GetClass(pc);
            return;
        }
    }
    if (!exactWorld) {
        for (ue::UObject* w : worlds) {
            if (ue::UObject* pc = GetPlayerControllerFor(w, 0)) {
                g_world = w;
                g_worldClass = ue::GetClass(w);
                g_pc = pc;
                g_pcClass = ue::GetClass(pc);
                return;
            }
        }
    }
    // No controller yet (main menu before the player exists): keep the world so
    // the real-time clock works; the PC is retried on the next call.
    g_world = exactWorld ? exactWorld : firstWorld;
    g_worldClass = g_world ? ue::GetClass(g_world) : nullptr;
}

void EnsureWorld() {
    if (WorldOk()) return;
    ResolveWorldAndPc();
}

uint64_t g_lastPcScanMs = 0;
bool g_pcScanTried = false;

void EnsurePc() {
    EnsureWorld();
    if (PcOk()) return;
    g_pc = nullptr;
    g_pcClass = nullptr;
    if (WorldOk()) {
        if (ue::UObject* pc = GetPlayerControllerFor(g_world, 0)) {
            g_pc = pc;
            g_pcClass = ue::GetClass(pc);
            return;
        }
    }
    // Last resort (rate limited: this walks GObjects): any live PlayerController
    // whose pawn is our character.
    const uint64_t nowMs = GetTickCount64();
    if (g_pcScanTried && nowMs - g_lastPcScanMs < 1000) return;
    g_pcScanTried = true;
    g_lastPcScanMs = nowMs;

    const std::vector<ue::UObject*> pcs = ue::FindAllOf("PlayerController");
    ue::UObject* fallback = nullptr;
    for (ue::UObject* pc : pcs) {
        if (!fallback) fallback = pc;
        ue::UObject* pawn = uecall::PropObj(pc, "Pawn");
        if (pawn && Contains(ue::GetFullName(pawn), "BP_PlayerCharacter_C")) {
            g_pc = pc;
            g_pcClass = ue::GetClass(pc);
            return;
        }
    }
    g_pc = fallback;
    g_pcClass = fallback ? ue::GetClass(fallback) : nullptr;
}

// --- clock ---------------------------------------------------------------

bool g_clockWarned = false;
bool g_clockWidthWarned = false;
bool g_clockJumpWarned = false;

// GetRealTimeSeconds(World) through the GameplayStatics CDO -- main.lua:221.
//
// WIDTH: this node's "ReturnValue" is a DOUBLE in this UE5.6 build and the port
// read it as a float.  A float read of an 8-byte double takes the low four bytes
// (the mantissa tail): a number with nothing to do with seconds, different on
// every call.  That is measured, not hypothesised -- probe.log carries
//   spawnscan: clock rewound (stamp 0.0 -> now -0.6)
//   spawnscan: clock rewound (stamp -0.6 -> now -160.0)
//   spawnscan: clock rewound (stamp 2.4e32 -> now 0.0)
// coop_puppet measured 3.7e35 and 2.9e38 on the same build, and every 5 s/10 s
// diagnostic throttle fired many times a second (Diag::Due re-arms on a rewind).
//
// The width is taken from the RETURN PROPERTY itself: FProperty::ElementSize is 8
// for a DoubleProperty and 4 for a FloatProperty.  ParmsSize cannot answer this --
// UE pads the parameter block, so a float and a double can both report the same
// block size (24 here) -- and that is exactly the assumption being removed.
bool GameRealSeconds(double* out) {
    if (!out) return false;
    EnsureWorld();
    if (!WorldOk()) return false;
    ue::UObject* gs = GameplayStatics();
    if (!gs) return false;
    ue::UFunction* fn = uecall::Func(gs, "GetRealTimeSeconds");
    if (!fn) return false;
    static const char* kWorldParams[] = {"WorldContextObject", "WorldContext"};
    const char* wp = uecall::PickParam(fn, kWorldParams, 2);
    if (!wp) return false;
    ue::Params p(fn);
    p.Set<ue::UObject*>(wp, g_world);
    if (!ue::Call(gs, fn, p.data())) return false;

    const int32_t width = ue::PropSizeStruct((ue::UStruct*)fn, "ReturnValue");
    double v = 0.0;
    if (width == 8) {
        v = p.Get<double>("ReturnValue");
    } else if (width == 4) {
        v = (double)p.Get<float>("ReturnValue");
    } else {
        // No readable ReturnValue property (a build whose UFunction layout differs):
        // decide from the value, which is exact.  A float read through an 8-byte view
        // can only produce a DENORMAL double (|v| < 2.3e-308), while this accessor's
        // value is either exactly 0 or a real time far above 1e-300.
        const double d = p.Get<double>("ReturnValue");
        if (std::isfinite(d) && (d == 0.0 || std::fabs(d) > 1.0e-300)) {
            v = d;
        } else {
            v = (double)p.Get<float>("ReturnValue");
            if (!g_clockWidthWarned) {
                g_clockWidthWarned = true;
                ms2::Logf("clock: GetRealTimeSeconds read as float (no ReturnValue property; "
                          "params=%d B, raw=%.6f) -- if the module intervals behave like the "
                          "2026-10-25 run, this is a double here", (int)p.size(), v);
            }
        }
    }
    static int widthLogs = 0;
    if (widthLogs++ < 3) {
        ms2::Logf("clock: GetRealTimeSeconds ReturnValue width=%d bytes (%s), value %.3f",
                  width, width == 8 ? "double" : (width == 4 ? "float" : "unknown"), v);
    }
    if (!std::isfinite(v)) return false;
    // A real-time clock cannot be astronomically large; one that is means the read is
    // still wrong (or the world is a light-preset sub-level).  Refuse it so Now()
    // keeps its monotone timeline instead of poisoning every timer in the mod.
    if (v < -1.0e7 || v > 1.0e7) {
        if (!g_clockJumpWarned) {
            g_clockJumpWarned = true;
            ms2::Logf("clock: GetRealTimeSeconds gave %.1f -- rejecting it (sane -1e7..1e7)", v);
        }
        return false;
    }
    *out = v;
    return true;
}

double SteadySeconds() {
    using namespace std::chrono;
    static const steady_clock::time_point t0 = steady_clock::now();
    return duration_cast<duration<double>>(steady_clock::now() - t0).count();
}

// --- misc shared state ----------------------------------------------------

// The file name of the last parsed peer packet (the `info` command prints it).
std::string g_lastPeerFile;

// Paths the world/look scanners asked for and the game has not loaded (the Lua
// `missingAssets` table).  One log line per path, ever.
StrSet g_missingAssets;
bool g_loadUnavailableWarned = false;

// cmd.txt `lookadd` queue (main.lua LOOK_ADD / LOOK_TEST).
struct LookAddJob {
    bool active = false;
    std::string path;
    int64_t at = 0;
    // The AddItem spawn is DEFERRED: the attachable is not in the object array in
    // the tick that asked for it (probe.log 2026-10-25 03:29:33 `lookadd AddItem
    // ok=true`, the crown's first `look survey` at 03:29:34).  The diff below was
    // taken once, in that tick, found nothing and reset LOOK_ADD -- so
    // appear::SetLookAdded never ran, `lookdel` matched no actor, the crown was
    // never removed, B's look hash never changed and LOOK's off half could not
    // pass.  Polling is the faithful port of the Lua's LOOK_ADDED.
    bool polling = false;
    std::string cls;                    // the class the diff is taken on
    int64_t until = 0;
    std::vector<std::string> before;    // ClassInstances(cls) at AddItem time
};
LookAddJob g_lookAdd;

// Loop liveness counters for heartbeat.txt (main.lua HB).
int g_hb = 0;
int g_t30 = 0;
int g_t15 = 0;
int g_t2 = 0;

